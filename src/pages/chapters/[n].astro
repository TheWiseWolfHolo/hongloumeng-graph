  .reader[data-zp="dot"].vertical .text :global(.zb .zb-text), .reader.vertical .text :global(.zb-text) { display: inline; overflow: visible; }
  .reader.vertical .text :global(mark.hit) { box-shadow: none; }

  @media (max-width: 960px) {
