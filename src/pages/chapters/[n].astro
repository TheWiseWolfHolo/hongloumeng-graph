  /* 竖排：照刻本的样子排成字格。每一行（竖着的一列）宽度固定为 --L：
     块的行高是 --L，行内元素的行高比它小，竖排的基线是字的中线，大字小字都落在同一条中线上，
     所以每列都正好一格宽，乌丝栏按 --L 画就和字对得上。段落、诗、批语之间不留空白，换段就换列。 */
  .reader.vertical { grid-template-columns: minmax(0, 1fr); }
  .reader.vertical .side { display: none; }
  .reader.vertical .ch-head { padding: 6px 0 22px; }
