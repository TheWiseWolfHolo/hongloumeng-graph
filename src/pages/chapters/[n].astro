---
import Base from '../../layouts/Base.astro';
import Seal from '../../components/Seal.astro';
import { CHAPTERS, chapter, castOf, eventsIn, byId, huiRange, isSequel, cn } from '../../lib/data.ts';
import { EVENT_KINDS, eventRevealAt } from '../../data/events.ts';
import { loadChapter, renderChapter } from '../../lib/render-text.ts';

export function getStaticPaths() {
  return CHAPTERS.map(c => ({ params: { n: String(c.n) } }));
}
const n = +Astro.params.n!;
const c = chapter(n);
const text = loadChapter(n);
const html = renderChapter(text);
const cast = castOf(n, 60);
const max = cast[0]?.[1] ?? 1;
const events = eventsIn(n);
const prev = n > 1 ? chapter(n - 1) : null;
const next = n < 120 ? chapter(n + 1) : null;
const sequel = isSequel(n);
const noteCount = text.notes ?? 0;
const minutes = Math.max(1, Math.round(c.chars / 450));
const altTitles = text.variants.filter(v => v.text.replace(/\s|　/g, '') !== c.title.join(''));
---
<Base title={`${c.cn} ${c.title.join(' ')}`} description={`《红楼梦》${c.cn}原文：${c.title.join('，')}。${c.summary}`.slice(0, 160)} section="chapters" sub="list" bodyClass="pg-reader">
  <div class="read-progress" aria-hidden="true"><i data-rp></i></div>
  <div class:list={['reader wrap', { 'is-xu': sequel, 'has-zp': noteCount > 0 }]} data-reader data-n={n} data-zp="dot">
    <aside class="side" aria-label="本回导读">
      <div class="side-inner">
        <nav class="side-nav" aria-label="翻回">
          {prev ? <a href={`/chapters/${prev.n}/`} rel="prev">{prev.cn}</a> : <span />}
          <a href="/chapters/">回目</a>
          {next ? <a href={`/chapters/${next.n}/`} rel="next">{next.cn}</a> : <span />}
        </nav>
        <section class="side-sec">
          <h2>本回提要</h2>
          <div class="spoil" data-ch={n}><p class="sum spoil-body">{c.summary}</p></div>
          {noteCount > 0 && <p class="side-zp">本回批语<b>{cn(noteCount)}</b>条</p>}
          {sequel && <p class="side-zp xu">续书，无批语。</p>}
        </section>
        {events.length > 0 && (
          <section class="side-sec">
            <h2>本回大事</h2>
            <ul class="side-evs">{events.map(e => <li class="spoil" data-ch={eventRevealAt(e)} style={`--k:${EVENT_KINDS[e.k]}`}><div class="spoil-body"><b>{e.t}</b><span>{huiRange(e.c)}</span></div></li>)}</ul>
          </section>
        )}
        <section class="side-sec">
          <h2>本回提及 <small>{cn(cast.length)}位</small></h2>
          <ul class="cast">
            {cast.map(([id, v]) => {
              const p = byId.get(id)!;
              return <li style={`--pc:var(--g-${p.group});--w:${Math.max(6, (v / max) * 100)}%`}><a href={`/people/${id}/`} data-peek data-cast={id}>{id}</a><span class="cv">{cn(v)}</span><i /></li>;
            })}
          </ul>
        </section>
      </div>
    </aside>

    <article class="page" data-page>
      <header class="ch-head">
        <p class="ch-meta">
          <span class:list={['src-tag', { xu: sequel }]}>{sequel ? '续书　程甲本' : '脂本　前八十回'}</span><span>约{cn(Math.round(c.chars / 100) * 100)}字</span><span>读完约{cn(minutes)}分钟</span>
        </p>
        <h1 class="ch-cn ink-in">{c.cn}</h1>
        <p class="couplet ink-in" style="--d:.2s"><span>{c.title[0]}</span><span>{c.title[1]}</span></p>
        {altTitles.length > 0 && (
          <details class="variants">
            <summary>其他版本的回目</summary>
            <ul>{altTitles.map(v => <li><span>{v.text}</span><small>{v.from}</small></li>)}</ul>
          </details>
        )}
      </header>

      {sequel && (
        <aside class="xu-banner">
          <b>后四十回续书</b>
          <p>这一回不出自曹雪芹之手。程伟元、高鹗在乾隆五十六年把它和前八十回一起刊行，通常认为是他人续写。情节可作参考，人物结局和前八十回的伏笔、批语透露的原意多有出入。</p>
        </aside>
      )}
      <div class="controls" role="toolbar" aria-label="阅读设置">
        {noteCount > 0 && (
          <div class="ctl-group zp-modes" role="group" aria-label="批语显示方式">
            <span class="zp-label">批语</span>
            <button type="button" data-zp="off" aria-pressed="false">隐</button>
            <button type="button" data-zp="dot" aria-pressed="true">圈</button>
            <button type="button" data-zp="full" aria-pressed="false">显</button>
          </div>
        )}
        <div class="ctl-group" role="group" aria-label="字号">
          <button type="button" data-size="-1" aria-label="字小一点">小</button>
          <button type="button" data-size="1" aria-label="字大一点">大</button>
        </div>
        <button type="button" class="ctl" data-names aria-pressed="true">人名标注</button>
        <button type="button" class="ctl" data-vertical aria-pressed="false">竖排</button>
        <button type="button" class="ctl" data-read-here hidden>从这里接着读</button>
      </div>

      <nav class="hit-nav" data-hit-nav hidden aria-label="原文搜索命中">
        <button type="button" data-hit-prev>上一处</button>
        <span data-hit-count role="status"></span>
        <button type="button" data-hit-next>下一处</button>
      </nav>

      <div class="text" data-text set:html={html} />

      <footer class="ch-end">
        <Seal text="终" size={36} round />
        <button type="button" class="read-done" data-read-done>读完本回</button>
        <nav class="ch-pager" aria-label="上一回与下一回">
          {prev ? <a href={`/chapters/${prev.n}/`} class="cp prev"><span class="cp-k">上一回　{prev.cn}</span><span class="cpt">{prev.title[0]}</span><span class="cpt">{prev.title[1]}</span></a> : <span />}
          {next ? <a href={`/chapters/${next.n}/`} class="cp next"><span class="cp-k">下一回　{next.cn}</span><span class="cpt">{next.title[0]}</span><span class="cpt">{next.title[1]}</span></a> : <a href="/chapters/" class="cp next"><span class="cp-k">全书完</span><span class="cpt">回到回目</span></a>}
        </nav>
      </footer>
    </article>
  </div>
</Base>

<script>
  import { store, cn, progress as guardedThrough, setProgress } from '../../client/site.ts';
  import { toSimplified } from '../../lib/search.ts';
  const reader = document.querySelector<HTMLElement>('[data-reader]')!;
  const n = +reader.dataset.n!;
  const text = document.querySelector<HTMLElement>('[data-text]')!;
  const root = document.documentElement;
  const params = new URLSearchParams(location.search);
  const query = params.get('q')?.trim();
  let reading = !query && !location.hash && !params.has('ref') && !params.has('hit');
  const readHere = document.querySelector<HTMLButtonElement>('[data-read-here]')!;
  const readDone = document.querySelector<HTMLButtonElement>('[data-read-done]')!;
  readHere.hidden = reading;

  /* 字号与排法记在本机 */
  let size = +(store.get('hlm-size') || 0);
  const applySize = () => { text.style.setProperty('--fs-step', String(size)); };
  document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach(b => b.addEventListener('click', () => {
    size = Math.max(-2, Math.min(4, size + +b.dataset.size!));
    store.set('hlm-size', String(size));
    applySize();
  }));
  applySize();

  const namesBtn = document.querySelector<HTMLButtonElement>('[data-names]')!;
  const setNames = (on: boolean) => { text.classList.toggle('plain', !on); namesBtn.setAttribute('aria-pressed', String(on)); store.set('hlm-names', on ? null : 'off'); };
  namesBtn.addEventListener('click', () => setNames(namesBtn.getAttribute('aria-pressed') !== 'true'));
  if (store.get('hlm-names') === 'off') setNames(false);

  const vBtn = document.querySelector<HTMLButtonElement>('[data-vertical]')!;
  const controls = document.querySelector<HTMLElement>('.controls')!;
  const isV = () => reader.classList.contains('vertical');
  /* 竖排从右往左读，scrollLeft 从 0 往负数走；读到的比例在 0 到 1 之间 */
  const vSpan = () => Math.max(1, text.scrollWidth - text.clientWidth);
  /* 竖排是刻本的样子，整回换成繁体；横排换回简体 */
  let fan: Promise<{ at: number[]; ch: string }> | null = null;
  const swapped: [Text, string][] = [];
  async function setFan(on: boolean) {
    if (!on) { for (const [t, s] of swapped) t.data = s; swapped.length = 0; return; }
    if (swapped.length) return;
    fan ??= fetch(`/chapters/${n}/fan.json`).then(r => r.json());
    const { at, ch } = await fan.catch(() => ({ at: [] as number[], ch: '' }));
    if (!isV() || swapped.length) return;
    const w = document.createTreeWalker(text, NodeFilter.SHOW_TEXT);
    let pos = 0, k = 0, next = at[0] ?? Infinity;
    while (k < at.length && w.nextNode()) {
      const t = w.currentNode as Text, s = t.data, end = pos + s.length;
      if (next < end) {
        const a = s.split('');
        while (next < end) { a[next - pos] = ch[k]; k++; next += at[k] ?? Infinity; }
        swapped.push([t, s]);
        t.data = a.join('');
      }
      pos = end;
    }
  }
  const setVertical = (on: boolean, p = 0, align = false) => {
    reader.classList.toggle('vertical', on);
    setFan(on);
    vBtn.setAttribute('aria-pressed', String(on));
    store.set('hlm-vertical', on ? '1' : null);
    if (on) {
      text.scrollLeft = -p * vSpan();
      /* 工具条贴着页头，正文框正好占满下面的一屏 */
      if (align) controls.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
    }
  };
  vBtn.addEventListener('click', () => {
    const on = vBtn.getAttribute('aria-pressed') !== 'true';
    /* 横竖切换时接着原来读到的地方 */
    const p = progress();
    setVertical(on, p, true);
    if (!on) { const r = text.getBoundingClientRect(); scrollTo({ top: scrollY + r.top + r.height * p - innerHeight * .4, behavior: 'instant' as ScrollBehavior }); }
  });
  /* 竖排时滚轮横着翻；翻到头了再交还给页面，好往下看下一回 */
  text.addEventListener('wheel', e => {
    if (!isV() || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
    const atEnd = -text.scrollLeft >= vSpan() - 1, atStart = text.scrollLeft >= -1;
    if ((e.deltaY > 0 && atEnd) || (e.deltaY < 0 && atStart)) return;
    e.preventDefault();
    text.scrollLeft -= e.deltaY * (e.deltaMode === 1 ? 32 : 1);
  }, { passive: false });
  /* 竖排时一屏一屏地翻，留一列接上文 */
  const pageBy = (dir: number) => {
    const L = parseFloat(getComputedStyle(text).lineHeight) || 40;
    const step = Math.max(L, Math.floor((text.clientWidth - L * 2) / L) * L - L);
    text.scrollBy({ left: -dir * step, behavior: 'smooth' });
  };

  /* 批语：隐去、只留朱圈、全部展开 */
  const zpBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-zp]')];
  const setZp = (mode: string) => {
    reader.dataset.zp = mode;
    zpBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.zp === mode)));
    store.set('hlm-zp', mode === 'dot' ? null : mode);
  };
  zpBtns.forEach(b => b.addEventListener('click', () => setZp(b.dataset.zp!)));
  const savedZp = store.get('hlm-zp');
  if (savedZp === 'off' || savedZp === 'full') setZp(savedZp);
  text.addEventListener('click', e => {
    const zb = (e.target as HTMLElement).closest<HTMLElement>('.zb');
    if (zb) { zb.classList.toggle('open'); return; }
    const dot = (e.target as HTMLElement).closest<HTMLButtonElement>('.zp-dot');
    if (!dot) return;
    const zp = dot.parentElement!;
    const open = !zp.classList.contains('open');
    zp.classList.toggle('open', open);
    dot.setAttribute('aria-expanded', String(open));
  });

  /* 侧栏人名悬停，正文里同一人亮起来 */
  const style = document.createElement('style');
  document.head.append(style);
  document.querySelectorAll<HTMLElement>('[data-cast]').forEach(a => {
    a.addEventListener('pointerenter', () => { style.textContent = `.text a.nm[data-id="${a.dataset.cast}"]{background:color-mix(in srgb,var(--pc) 22%,transparent);color:var(--ink)!important;border-radius:2px}`; });
    a.addEventListener('pointerleave', () => { style.textContent = ''; });
  });

  /* 阅读进度条，并记下读到哪里 */
  const bar = document.querySelector<HTMLElement>('[data-rp]')!;
  let saveT = 0;
  function progress() {
    if (isV()) return Math.min(1, Math.abs(text.scrollLeft) / vSpan());
    const r = text.getBoundingClientRect();
    return Math.min(1, Math.max(0, (innerHeight * .4 - r.top) / r.height));
  }
  const onScroll = (save = true) => {
    const p = progress();
    bar.style.transform = `scaleX(${p})`;
    if (!save || !reading) return;
    clearTimeout(saveT);
    saveT = window.setTimeout(() => store.set('hlm-last', JSON.stringify({ n, p: +p.toFixed(3) })), 400);
  };
  addEventListener('scroll', () => onScroll(), { passive: true });
  text.addEventListener('scroll', () => onScroll(), { passive: true });
  readHere.addEventListener('click', () => {
    reading = true;
    readHere.hidden = true;
    document.querySelector<HTMLElement>('[data-hit-nav]')!.hidden = true;
    const url = new URL(location.href);
    for (const key of ['q', 'hit', 'ref']) url.searchParams.delete(key);
    url.hash = '';
    history.replaceState(null, '', url);
    onScroll();
  });
  readDone.addEventListener('click', () => {
    clearTimeout(saveT);
    reading = false;
    readHere.hidden = true;
    store.set('hlm-last', JSON.stringify(n < 120 ? { n: n + 1, p: 0 } : { n, p: 1 }));
    if (guardedThrough() > 0) setProgress(Math.max(guardedThrough(), n));
    readDone.textContent = '本回已读';
    readDone.disabled = true;
  });

  /* 从首页“接着读”进来，回到上次的位置 */
  try {
    const last = JSON.parse(store.get('hlm-last') || 'null');
    const resume = reading && last?.n === n && last.p > .02 && last.p < .98;
    if (store.get('hlm-vertical') === '1' && innerWidth > 700) setVertical(true, resume ? last.p : 0);
    else if (resume) {
      const r = text.getBoundingClientRect();
      scrollTo({ top: scrollY + r.top + r.height * last.p - innerHeight * .4, behavior: 'instant' as ScrollBehavior });
    }
  } catch { /* 记录坏了就从头读 */ }
  if (/^#p\d+$/.test(location.hash)) {
    const paragraph = document.getElementById(location.hash.slice(1));
    if (paragraph && text.contains(paragraph)) requestAnimationFrame(() => paragraph.scrollIntoView({ block: 'center', inline: 'center', behavior: 'instant' as ScrollBehavior }));
  }

  /* 搜索字位与 text.json 相同，批语不计入正文位置。 */
  if (query) {
    const nodes: { node: Text; start: number }[] = [];
    let full = '';
    for (const segment of text.querySelectorAll<HTMLElement>('[data-text-start]')) {
      let at = +segment.dataset.textStart!;
      const gap = segment.dataset.textGap ?? '';
      full = full.padEnd(at - gap.length, '\n') + gap;
      const walker = document.createTreeWalker(segment, NodeFilter.SHOW_TEXT, {
        acceptNode: node => node.parentElement?.closest('.zp') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT
      });
      while (walker.nextNode()) {
        const node = walker.currentNode as Text;
        nodes.push({ node, start: at });
        full = full.padEnd(at, '\n') + node.data;
        at += node.length;
      }
    }
    const normalized = toSimplified(full), q = toSimplified(query);
    const offsets: number[] = [];
    for (let at = normalized.indexOf(q); at >= 0; at = normalized.indexOf(q, at + q.length)) offsets.push(at);
    const anchors = new Map<number, HTMLElement>();
    for (const { node, start } of [...nodes].reverse()) {
      const end = start + node.length;
      for (const at of [...offsets].reverse()) {
        if (at + q.length <= start || at >= end) continue;
        const range = document.createRange();
        range.setStart(node, Math.max(at, start) - start);
        range.setEnd(node, Math.min(at + q.length, end) - start);
        const mark = document.createElement('mark');
        mark.className = 'hit';
        mark.dataset.hitOffset = String(at);
        range.surroundContents(mark);
        anchors.set(at, mark);
      }
    }
    const nav = document.querySelector<HTMLElement>('[data-hit-nav]')!;
    const prevHit = document.querySelector<HTMLButtonElement>('[data-hit-prev]')!;
    const nextHit = document.querySelector<HTMLButtonElement>('[data-hit-next]')!;
    const count = document.querySelector<HTMLElement>('[data-hit-count]')!;
    let selected = 0;
    const selectHit = (index: number, updateUrl = true) => {
      selected = index;
      const at = offsets[index];
      text.querySelectorAll<HTMLElement>('[data-hit-offset]').forEach(mark => mark.classList.toggle('current', +mark.dataset.hitOffset! === at));
      count.textContent = `第${cn(index + 1)}处，共${cn(offsets.length)}处`;
      prevHit.disabled = index === 0;
      nextHit.disabled = index === offsets.length - 1;
      anchors.get(at)!.scrollIntoView({ block: 'center', inline: 'center', behavior: 'instant' as ScrollBehavior });
      if (updateUrl) {
        const url = new URL(location.href);
        url.searchParams.set('hit', String(at));
        history.replaceState(null, '', url);
      }
    };
    if (offsets.length) {
      nav.hidden = false;
      const requested = params.get('hit');
      const index = requested != null ? offsets.indexOf(Number(requested)) : 0;
      requestAnimationFrame(() => selectHit(index >= 0 ? index : 0, false));
      prevHit.addEventListener('click', () => selectHit(selected - 1));
      nextHit.addEventListener('click', () => selectHit(selected + 1));
    }
  }
  onScroll(false);
  /* 左右方向键翻回 */
  addEventListener('keydown', e => {
    const target = e.target as HTMLElement;
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || document.querySelector('dialog[open]')
      || target.isContentEditable || target.closest('input, textarea, select, button, summary, a, [role="button"], [role="slider"]')) return;
    /* 竖排时左右键和翻页键翻的是这一回里的页，翻到头才去上下回 */
    if (isV()) {
      const fwd = e.key === 'ArrowLeft' || e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey);
      const back = e.key === 'ArrowRight' || e.key === 'PageUp' || (e.key === ' ' && e.shiftKey);
      if (!fwd && !back) return;
      const atEnd = -text.scrollLeft >= vSpan() - 1, atStart = text.scrollLeft >= -1;
      if ((fwd && !atEnd) || (back && !atStart)) { e.preventDefault(); pageBy(fwd ? 1 : -1); return; }
      if (e.key.startsWith('Page') || e.key === ' ') return;
      const a = document.querySelector<HTMLAnchorElement>(`a[rel="${fwd ? 'next' : 'prev'}"]`);
      if (a) location.href = a.href;
      return;
    }
    const rel = e.key === 'ArrowLeft' ? 'prev' : e.key === 'ArrowRight' ? 'next' : '';
    const a = rel && document.querySelector<HTMLAnchorElement>(`a[rel="${rel}"]`);
    if (a) location.href = a.href;
  });
</script>

<style>
  .hit-nav { display: flex; justify-content: center; align-items: center; gap: 18px; margin: 18px 0 28px; font-size: 14px; color: var(--ink-2); }
  .hit-nav button, .read-done { padding: 9px 14px; border: 1px solid var(--line-2); border-radius: 3px; color: var(--cinnabar); }
  .hit-nav button:disabled, .read-done:disabled { color: var(--ink-3); opacity: .6; cursor: default; }
  .read-done { display: block; margin: 22px auto; }
  .text :global(mark.hit.current) { position: relative; scroll-margin: 100px; }
  .text :global(mark.hit.current)::after { content: ''; position: absolute; inset: -3px -5px; border: 1.5px solid var(--cinnabar); border-right-width: 1px; border-bottom-width: 1.8px; border-radius: 46% 54% 45% 55% / 52% 43% 57% 48%; transform: rotate(-4deg); pointer-events: none; }
  .read-progress { position: fixed; left: 0; right: 0; top: 0; height: 2px; z-index: 60; pointer-events: none; }
  .read-progress i { display: block; height: 100%; background: var(--cinnabar); transform: scaleX(0); transform-origin: left; transition: transform .15s linear; }
  .reader { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); padding-top: 26px; align-items: start; }
  .side { position: sticky; top: calc(var(--header-h) + 24px); max-height: calc(100vh - var(--header-h) - 44px); overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent; padding-right: 6px; }
  .side-nav { display: flex; justify-content: space-between; font: 400 13px/1 var(--title); color: var(--ink-3); padding-bottom: 16px; border-bottom: 1px solid var(--line); letter-spacing: .04em; }
  .side-nav a:hover { color: var(--cinnabar); }
  .side-sec { padding: 18px 0; border-bottom: 1px solid var(--line); }
  .side-sec h2 { font: 400 12px/1 var(--title); letter-spacing: .26em; color: var(--ink-3); margin-bottom: 12px; display: flex; justify-content: space-between; }
  .side-sec h2 small { font-weight: 500; letter-spacing: .05em; }
  .sum { font-size: 14px; line-height: 1.9; color: var(--ink-2); }
  .side-evs { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .side-evs li { display: grid; padding-left: 12px; border-left: 2px solid var(--k); }
  .side-evs .spoil-body { display: grid; }
  .side-evs b { font-size: 14.5px; }
  .side-evs span { font: 400 11.5px/1.6 var(--title); color: var(--ink-3); }
  .cast { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .cast li { position: relative; display: flex; justify-content: space-between; align-items: center; padding: 3px 6px; font-size: 14.5px; border-radius: 3px; overflow: hidden; }
  .cast li i { position: absolute; left: 0; top: 0; bottom: 0; width: var(--w); background: var(--pc); opacity: .1; z-index: -1; }
  .cast li:hover i { opacity: .22; }
  .cast a:hover { color: var(--pc); }
  .cv { font: 400 11.5px/1 var(--title); color: var(--ink-3); }
  .hint { font: 400 11.5px/1.6 var(--title); color: var(--ink-4); margin-top: 10px; }

