  .reader.vertical .text :global(.fig) { display: block; width: auto; margin: 0; padding: 0; padding-inline-start: calc(var(--adv) * 3); border: 0; border-radius: 0; font-size: 1em; letter-spacing: .3em; outline: 3px double var(--gold); outline-offset: -5px; }
  .reader.vertical .text :global(.fig > span) { display: block; }
