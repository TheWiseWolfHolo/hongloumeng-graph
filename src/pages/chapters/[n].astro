  .reader.vertical .text :global(a.nm) { background-size: 1px 100%; background-position: 0 0; padding-left: .1em; }
  .reader.vertical .text :global(a.nm:hover) { background-size: 2px 100%; }
  /* 批语：朱圈不占字位，像圈点一样挂在上一个字的右下 */
  .reader.vertical .text :global(.zp) { position: relative; }
  .reader.vertical .text :global(.zp-dot) { position: absolute; top: -.4em; right: -.5em; width: .36em; height: .36em; margin: 0; border-width: 1.2px; }
  .reader.vertical .text :global(.zp-dot)::before { content: ''; position: absolute; inset: -.35em; }
