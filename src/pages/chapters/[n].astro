  .reader.vertical .text {
    --fsv: calc(21px + var(--fs-step) * 1.5px);
    --L: calc(var(--fsv) * 2.15);
    --adv: calc(var(--fsv) * 1.12);
    --py: calc(var(--fsv) * 1.5);
    --rule: color-mix(in srgb, var(--cinnabar) 22%, transparent);
    writing-mode: vertical-rl; text-orientation: mixed;
    font-family: var(--title); font-size: var(--fsv); line-height: var(--L); letter-spacing: .12em; text-align: start;
    /* 竖排盒子的宽是它的块向尺寸，不写死就会按内容撑到上万像素 */
    width: 100%; max-width: none; margin: 0; box-sizing: border-box;
    /* 高度取整到字距的整数倍，每列字数一样，底下不剩半个字 */
    height: calc(100svh - var(--header-h) - 120px);
    height: calc(round(down, 100svh - var(--header-h) - 120px - 2 * var(--py), var(--adv)) + 2 * var(--py) + 2px);
    min-height: 16em;
    padding: var(--py) var(--L);
    overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent;
    background-color: var(--card);
    background-image: linear-gradient(to right, transparent calc(100% - 1px), var(--rule) 0);
    background-size: var(--L) 100%;
    background-position: right var(--L) top 0;
    background-attachment: local;
    border: 1px solid var(--line-2); border-width: 2px 1px; border-radius: 2px;
    box-shadow: var(--shadow);
  }
  /* 行宽只由块上的支柱决定：行内元素行高压小，永远落在支柱里面，撑不宽列 */
  /* 列宽取整像素，一百多列下来也不会积出半像素的偏差 */
  @supports (width: round(1.5px, 1px)) {
    .reader.vertical .text { --L: round(calc(var(--fsv) * 2.15), 1px); }
