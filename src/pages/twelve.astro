---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PersonLink from '../components/PersonLink.astro';
import { TWELVE, TWELVE_MORE, byId, noteLabel, cn } from '../lib/data.ts';
import { portraitImage } from '../lib/portraits.ts';
import { loadChapter, type Block } from '../lib/render-text.ts';

/* 第五回原文：判词前后挂着的批语，以及十二支曲的曲文 */
const ch5 = loadChapter(5);
const plain = (s: string) => s.replace(/[^一-龥]/g, '');
const overlap = (a: string, b: string) => { const set = new Set(a); let n = 0; for (const c of b) if (set.has(c)) n++; return n / Math.max(1, b.length); };
function notesFor(lines: string[]) {
  const want = plain(lines.join(''));
  const i = ch5.blocks.findIndex(b => b.t === 'poem' && overlap(plain(b.s), want) > .7);
  if (i < 0) return [];
  const out: { label: string; s: string }[] = [];
  for (let k = i - 1; k >= 0 && ch5.blocks[k].t === 'pi'; k--) out.unshift({ label: noteLabel(ch5.blocks[k] as Required<Block>), s: ch5.blocks[k].s });
  for (const x of ch5.blocks[i].n ?? []) out.push({ label: noteLabel(x), s: x.s });
  return out;
}

const SONG_OF: Record<string, string[]> = {
  红楼梦引子: [], 终身误: ['薛宝钗', '贾宝玉'], 枉凝眉: ['林黛玉', '贾宝玉'], 恨无常: ['贾元春'], 分骨肉: ['贾探春'], 乐中悲: ['史湘云'],
  世难容: ['妙玉'], 喜冤家: ['贾迎春'], 虚花悟: ['贾惜春'], 聪明累: ['王熙凤'], 留余庆: ['巧姐'], 晚韶华: ['李纨'], 好事终: ['秦可卿'], 飞鸟各投林: []
};
const songs: { name: string; ids: string[]; text: string; notes: { label: string; s: string }[] }[] = [];
ch5.blocks.forEach((b, i) => {
  const m = /^第.+支，(?:收尾·)?(.+)：$/.exec(b.s);
  if (b.t !== 'center' || !m) return;
  const name = m[1].replace('悮', '误').replace('寃', '冤');
  const body = ch5.blocks[i + 1];
  const notes: { label: string; s: string }[] = [];
  for (let k = i + 2; k < ch5.blocks.length && ch5.blocks[k].t === 'pi'; k++) notes.push({ label: noteLabel(ch5.blocks[k] as Required<Block>), s: ch5.blocks[k].s });
  for (const x of body.n ?? []) notes.push({ label: noteLabel(x), s: x.s });
  songs.push({ name, ids: SONG_OF[name] ?? [], text: body.s, notes });
});
const songAnchor = (name: string) => `song-${songs.findIndex(s => s.name === name) + 1}`;

const BOOKS = [
  { k: 'z', name: '正册', list: TWELVE, note: '十二钗正册，记贾府和亲戚家最要紧的十二位女子。' },
  { k: 'f', name: '副册', list: TWELVE_MORE.filter(v => v.book === '副册'), note: '副册只翻到一页，是香菱。' },
  { k: 'y', name: '又副册', list: TWELVE_MORE.filter(v => v.book === '又副册'), note: '又副册是丫鬟一流，宝玉先翻开的就是这一本。' }
];
const leaves = BOOKS.map(b => ({
  ...b,
  list: b.list.map(v => ({
    v,
    pics: v.ids.map(id => ({ id, img: portraitImage(byId.get(id)!.portrait) })).filter(x => x.img),
    notes: notesFor(v.verse),
    songs: (v.song ?? '').match(/《([^》]+)》/g)?.map(s => s.slice(1, -1)) ?? [],
    fates: v.ids.map(id => byId.get(id)!).filter(p => p.fate || p.xu)
  }))
}));
---
<Base title="金陵十二钗" description="《红楼梦》第五回薄命司里的判词册：金陵十二钗正册、副册、又副册的画、判词与《红楼梦》十二支曲，附脂砚斋批语。" section="people" sub="twelve">
  <div class="wrap">
    <PageHead title="金陵十二钗" slip="金陵十二釵" quote="春恨秋悲皆自惹｜花容月貌为谁妍" from="第五回　薄命司" />

    <!-- 薄命司的橱：三张封条 -->
    <nav class="cabinet" role="tablist" aria-label="三本册子">
      {BOOKS.map((b, i) => (
        <button type="button" role="tab" class="feng" data-book={b.k} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`book-${b.k}`}>
          <span class="feng-t">金陵十二釵{b.name}</span>
        </button>
      ))}
    </nav>

    {leaves.map((b, bi) => (
      <section class="ce" id={`book-${b.k}`} role="tabpanel" data-pane={b.k} hidden={bi !== 0}>
        {b.list.length > 1 && (
          <ol class="mulu" aria-label="这一册的目录">
            {b.list.map(({ v }, i) => <li><button type="button" data-to={i} aria-current={i === 0 ? 'page' : undefined}>{v.ids.join('、')}</button></li>)}
          </ol>
        )}
        {b.list.map(({ v, pics, notes, songs: sg, fates }, i) => (
          <article class="ye" id={v.ids.join('-')} data-leaf={i} hidden={i !== 0} style={`--c:var(--g-${byId.get(v.ids[0])!.group})`}>
            <div class="spread">
              <!-- 右半叶：画 -->
              <figure class:list={['hua', { duo: pics.length > 1, bare: !pics.length }]}>
                <div class="imgs">{pics.map(x => <a href={`/people/${x.id}/`} class="pic-a"><Image src={x.img!} width={420} height={630} alt={`${x.id}画像`} loading={i === 0 ? 'eager' : 'lazy'} /></a>)}</div>
                <figcaption>{v.pic}</figcaption>
              </figure>
              <span class="fold" aria-hidden="true"><b>{b.name}</b><i></i><b>{cn(i + 1)}</b></span>
              <!-- 左半叶：判词与批 -->
              <div class="ci">
                <div class="verse" aria-label={v.verse.join('，')}>
                  {v.verse.map((l, j) => <span style={`--j:${j}`}>{l}</span>)}
                </div>
                {notes.length > 0 && (
                  <ul class="pi">
                    {notes.map(n => <li><b>{n.label}</b>{n.s}</li>)}
                  </ul>
                )}
              </div>
            </div>
            <div class="info">
              <h2>{v.ids.map((id, j) => <>{j > 0 && <span class="and">与</span>}<PersonLink id={id} /></>)}</h2>
              <dl>
                {sg.length > 0 && <><dt>曲</dt><dd>{sg.map(s => <a href={`#${songAnchor(s)}`}>《{s}》</a>)}</dd></>}
                {v.flower && <><dt>籤</dt><dd>{v.flower}<small>第六十三回</small></dd></>}
              </dl>
              <details class="gloss spoil" data-ch="81">
                <summary>判词怎么读，结局如何</summary>
                <div class="spoil-body">
                  <p>{v.gloss}</p>
                  {fates.map(p => (
                    <div class="fate">
                      {p.fate && <p><b>{p.id}　原意</b>{p.fate}</p>}
                      {p.xu && <p class="xu"><b>{p.id}　续书</b>{p.xu}</p>}
                    </div>
                  ))}
                </div>
              </details>
            </div>
          </article>
        ))}
        {b.list.length > 1 && (
          <div class="turn">
            <button type="button" data-step="-1">前一页</button>
            <span class="at" data-at>一／{cn(b.list.length)}</span>
            <button type="button" data-step="1">后一页</button>
          </div>
        )}
      </section>
    ))}

    <section class="songs" id="songs">
      <header class="sh reveal">
        <h2>紅樓夢十二支曲</h2>
        <p>宝玉听了，只觉“散漫无稽，未见得好处”。<cite>第五回</cite></p>
      </header>
      <ol class="song-list">
        {songs.map((s, i) => (
          <li class="song reveal" id={`song-${i + 1}`}>
            <h3><span class="song-n">{['引', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一', '十二', '十三', '尾'][i]}</span>{s.name}</h3>
            {s.ids.length > 0 && <p class="song-who">{s.ids.map(id => <PersonLink id={id} />)}</p>}
            <p class="song-text">{s.text}</p>
            {s.notes.map(n => <p class="song-pi"><b>{n.label}</b>{n.s}</p>)}
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<script>
  import { cn } from '../client/site.ts';
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-book]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pane = () => document.querySelector<HTMLElement>('[data-pane]:not([hidden])')!;
  const show = (k: string, push = true) => {
    tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.book === k)));
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach(p => { p.hidden = p.dataset.pane !== k; });
    if (push) history.replaceState(null, '', k === 'z' ? location.pathname : `#${k}`);
  };
  tabs.forEach(t => t.addEventListener('click', () => show(t.dataset.book!)));

  /* 一页一页翻：旧页淡出，新页从右边淡入 */
  function go(p: HTMLElement, i: number, push = true) {
    const leaves = [...p.querySelectorAll<HTMLElement>('[data-leaf]')];
    const cur = leaves.findIndex(l => !l.hidden);
    i = (i + leaves.length) % leaves.length;
    if (i === cur) return;
    const from = leaves[cur], to = leaves[i];
    const done = () => {
      from.hidden = true; from.classList.remove('leave');
      to.hidden = false;
      to.classList.remove('enter', 'back');
      void to.offsetWidth;
      to.classList.add('enter');
      if (i < cur) to.classList.add('back');
    };
    if (reduced) done(); else { from.classList.add('leave'); setTimeout(done, 220); }
    p.querySelectorAll<HTMLButtonElement>('[data-to]').forEach(b => b.toggleAttribute('aria-current', +b.dataset.to! === i));
    const at = p.querySelector('[data-at]');
    if (at) at.textContent = `${cn(i + 1)}／${cn(leaves.length)}`;
    if (push) history.replaceState(null, '', '#' + to.id);
  }
  document.querySelectorAll<HTMLElement>('[data-pane]').forEach(p => {
    p.querySelectorAll<HTMLButtonElement>('[data-to]').forEach(b => b.addEventListener('click', () => go(p, +b.dataset.to!)));
    p.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(b => b.addEventListener('click', () => {
      const cur = [...p.querySelectorAll<HTMLElement>('[data-leaf]')].findIndex(l => !l.hidden);
      go(p, cur + +b.dataset.step!);
    }));
  });
  addEventListener('keydown', e => {
    if (/INPUT|TEXTAREA/.test((document.activeElement as HTMLElement)?.tagName)) return;
    const p = pane();
    const cur = [...p.querySelectorAll<HTMLElement>('[data-leaf]')].findIndex(l => !l.hidden);
    if (e.key === 'ArrowRight') go(p, cur + 1);
    if (e.key === 'ArrowLeft') go(p, cur - 1);
  });

  /* 从人物页或搜索带锚点进来：翻到那一页 */
  const h = decodeURIComponent(location.hash.slice(1));
  if (h === 'f' || h === 'y') show(h, false);
  else if (h) {
    const el = document.getElementById(h) ?? [...document.querySelectorAll<HTMLElement>('[data-leaf]')].find(l => l.id.split('-').includes(h));
    const p = el?.closest<HTMLElement>('[data-pane]');
    if (el && p) { show(p.dataset.pane!, false); go(p, +el.dataset.leaf!, false); }
  }
</script>

<style>
  /* 薄命司的橱上贴着三张封条，选中的一张揭开 */
  .cabinet { display: flex; align-items: stretch; gap: 22px; justify-content: center; margin: -40px 0 40px; }
  .feng { position: relative; display: grid; padding: 0; transition: transform .4s var(--ease); }
  .feng-t { display: block; writing-mode: vertical-rl; padding: 18px 14px 44px; font: 400 21px/1 var(--title); letter-spacing: .16em; color: #5c4a35; background: #f6efdf; box-shadow: inset 0 0 0 1px #d8c9a6, 0 10px 20px -14px rgb(40 26 10 / .55); transition: color .3s, background .3s; }
  .feng::after { content: ''; position: absolute; left: 50%; bottom: 12px; width: 22px; height: 22px; translate: -50% 0; background: var(--cinnabar); opacity: .35; border-radius: 2px; transition: opacity .3s; }
  .feng:hover { transform: translateY(-3px); }
  .feng[aria-selected="true"] .feng-t { color: #1d1712; background: #fbf5e6; box-shadow: inset 0 0 0 1px #b8954a, 0 16px 26px -16px rgb(40 26 10 / .6); }
  .feng[aria-selected="true"]::after { opacity: 1; }

  .mulu { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 20px; margin: 0 0 26px; padding: 0; }
  .mulu button { padding: 6px 2px; font: 400 16px/1 var(--title); letter-spacing: .1em; color: var(--ink-3); transition: color .3s; }
  .mulu button:hover { color: var(--ink); }
  .mulu button[aria-current] { color: var(--cinnabar); }

  /* 一页册子摊开：右半叶是画，左半叶是判词，中间版心写册名和页次 */
  .spread { display: grid; grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr); min-height: clamp(500px, 46vw, 600px); background-color: #f4ecd8; background-image: radial-gradient(ellipse at 50% 50%, transparent 55%, rgb(120 90 40 / .12)), var(--paper-fiber); box-shadow: inset 0 0 0 1px rgb(90 66 30 / .2), inset 0 0 0 6px #f4ecd8, inset 0 0 0 7.5px rgb(90 66 30 / .32), 0 30px 50px -36px rgb(40 26 10 / .55); color: #1d1712; }
  .hua { grid-column: 3; grid-row: 1; margin: 0; display: flex; flex-direction: row-reverse; gap: 22px; align-items: center; justify-content: center; padding: clamp(28px, 4vw, 48px); }
  .imgs { display: flex; gap: 12px; }
  .pic-a { display: block; width: clamp(170px, 17vw, 240px); box-shadow: 0 0 0 1px rgb(90 66 30 / .25), 0 0 0 5px #faf4e4, 0 0 0 6px rgb(90 66 30 / .18), 0 18px 30px -22px rgb(40 26 10 / .6); }
  .duo .pic-a { width: clamp(130px, 12vw, 180px); }
  .pic-a :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
  .hua figcaption { writing-mode: vertical-rl; max-block-size: 22em; font: 400 16px/1.9 var(--title); letter-spacing: .14em; color: #4a3a2a; }
  .bare figcaption { max-block-size: 18em; font-size: 20px; line-height: 2.2; }
  .fold { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 30px 0; border-left: 1px solid rgb(90 66 30 / .32); border-right: 1px solid rgb(90 66 30 / .32); }
  .fold b { writing-mode: vertical-rl; font: 400 14px/1 var(--title); letter-spacing: .2em; color: #5c4a35; }
  .fold i { width: 18px; height: 13px; background: #2a2018; clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 50%, 0 100%); }
  .ci { grid-column: 1; grid-row: 1; display: flex; flex-direction: row-reverse; align-items: flex-start; justify-content: center; gap: 30px; padding: clamp(28px, 4vw, 48px) clamp(20px, 3vw, 36px); }
  /* 判词：一句一行，朱丝栏，字落在格子正中 */
  .verse { --u: clamp(48px, 4.4vw, 58px); writing-mode: vertical-rl; font: 400 calc(var(--u) * .54)/var(--u) var(--title); letter-spacing: .32em; color: #1d1712; padding: 14px 0; background-image: repeating-linear-gradient(to left, transparent 0 calc(var(--u) - 1px), rgb(176 45 34 / .26) calc(var(--u) - 1px) var(--u)); background-position: right; box-shadow: inset -1px 0 0 rgb(176 45 34 / .26); }
  .verse span { display: block; }
  .verse span:nth-child(2n) { padding-inline-start: 1em; }
  .pi { list-style: none; margin: 0; padding: 14px 0 0; display: flex; flex-direction: column; gap: 0 12px; writing-mode: vertical-rl; max-block-size: 22em; }
  .pi li { font: 400 15px/1.85 var(--title); color: #a8291f; letter-spacing: .06em; }
  .pi b { font: 400 13px/1.85 var(--title); color: rgb(168 41 31 / .7); margin-block-end: .6em; display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .ye.enter .spread { animation: leaf-in .5s var(--ease-ink) both; }
    .ye.enter .verse span { animation: ink-in 1.1s var(--ease-ink) both; animation-delay: calc(.15s + var(--j) * .16s); }
    .ye.leave .spread { opacity: 0; transform: translateX(-10px); transition: opacity .2s, transform .2s; }
  }
  @keyframes leaf-in { from { opacity: 0; transform: translateX(14px); } }
  .ye.back.enter .spread { animation-name: leaf-back; }
  @keyframes leaf-back { from { opacity: 0; transform: translateX(-14px); } }

  .info { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px 40px; align-items: baseline; padding: 30px 6px 0; }
  .info h2 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; font: 400 32px/1.2 var(--title); letter-spacing: .1em; }
  .info h2 :global(a.person) { --pc: var(--c); }
  .and { font: 400 15px/1 var(--title); color: var(--ink-3); }
  .info dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; font-size: 15.5px; line-height: 1.8; }
  .info dt { font: 400 16px/1.7 var(--title); color: var(--cinnabar); }
  .info dd { margin: 0; }
  .info dd small { margin-left: 10px; color: var(--ink-3); font: 400 13px/1 var(--title); }
  .info dd a { color: var(--cinnabar); }
  .gloss { grid-column: 1 / -1; }
  .gloss summary { cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 10px; font: 400 16px/1.4 var(--title); color: var(--cinnabar); letter-spacing: .14em; }
  .gloss summary::-webkit-details-marker { display: none; }
  .gloss summary::before { content: ''; width: 8px; height: 8px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px currentColor; }
  .gloss[open] summary::before { background: currentColor; }
  .gloss p { margin-top: 10px; font-size: 15.5px; line-height: 1.95; color: var(--ink); max-width: 46em; }
  .fate p b { display: block; font: 400 15px/1.8 var(--title); letter-spacing: .12em; color: var(--cinnabar); }
  .fate p.xu { color: var(--ink-3); font-size: 14.5px; }
  .fate p.xu b { color: var(--ink-3); }
  .turn { display: flex; justify-content: center; align-items: center; gap: 30px; margin-top: 30px; }
  .turn button { font: 400 17px/1 var(--title); letter-spacing: .3em; color: var(--ink-3); padding: 8px 4px; transition: color .3s; }
  .turn button:hover { color: var(--cinnabar); }
  .at { font: 400 15px/1 var(--title); letter-spacing: .2em; color: var(--ink-3); }

  /* 十二支曲 */
  .songs { padding-top: clamp(80px, 10vw, 140px); }
  .sh { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; margin-bottom: 44px; }
  .sh::before { content: ''; width: 1px; height: 46px; background: linear-gradient(transparent, var(--line-2)); }
  .sh h2 { font: 400 clamp(30px, 3vw, 38px)/1 var(--title); letter-spacing: .3em; padding-left: .3em; }
  .sh p { font: 400 15.5px/1.9 var(--serif); color: var(--ink-2); }
  .sh cite { display: block; margin-top: 8px; font: 400 14px/1 var(--title); font-style: normal; letter-spacing: .3em; color: var(--ink-3); }
  .song-list { list-style: none; margin: 0; padding: 0; columns: 2 380px; column-gap: 56px; }
  .song { break-inside: avoid; padding: 24px 0 26px; border-top: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 40px); }
  .song:target { background: color-mix(in srgb, var(--cinnabar) 5%, transparent); }
  .song h3 { display: flex; align-items: center; gap: 14px; font: 400 26px/1.2 var(--title); letter-spacing: .14em; }
  .song-n { display: grid; place-items: center; min-width: 30px; height: 30px; padding: 0 4px; font: 400 15px/1 var(--title); color: var(--cinnabar); box-shadow: inset 0 0 0 1px currentColor; letter-spacing: 0; }
  .song-who { display: flex; gap: 14px; margin-top: 8px; font-size: 14.5px; }
  .song-text { margin-top: 14px; font: 400 18px/2.1 var(--title); letter-spacing: .06em; color: var(--ink); }
  .song-pi { margin-top: 8px; font: 400 15px/1.85 var(--title); color: #a8291f; }
  .song-pi b { font: 400 13px/1 var(--title); margin-right: 8px; opacity: .75; }

  @media (max-width: 900px) {
    .spread { grid-template-columns: 1fr; }
    .fold { display: none; }
    .hua, .ci { grid-column: 1; }
    .ci { grid-row: 2; border-top: 1px solid rgb(90 66 30 / .2); }
    .info { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hua { flex-direction: column; }
    .hua figcaption { writing-mode: horizontal-tb; max-block-size: none; }
    .cabinet { gap: 12px; }
    .feng-t { font-size: 17px; padding: 14px 10px 38px; }
  }
</style>
