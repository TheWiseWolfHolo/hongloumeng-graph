---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Seal from '../../components/Seal.astro';
import MentionStrip from '../../components/MentionStrip.astro';
import EgoGraph from '../../components/EgoGraph.astro';
import {
  PEOPLE, GROUPS, BOOKS, REL_TYPES, TYPE_ORDER, STATS, byId, tiesOf, eventsOf, homesOf, verseOf, namesOf, spanOf,
  huiName, huiRange, chapter, cn, RANK, NOTES, noteLabel, type Person
} from '../../lib/data.ts';
import { EVENT_KINDS } from '../../data/events.ts';
import { portraitImage } from '../../lib/portraits.ts';

export function getStaticPaths() {
  return PEOPLE.map(p => ({ params: { id: p.id }, props: { p } }));
}
interface Props { p: Person }
const { p } = Astro.props;
const g = GROUPS[p.group];
const color = `var(--g-${p.group})`;
const names = namesOf(p);
const ties = tiesOf(p.id).filter(t => byId.has(t.other));
const grouped = TYPE_ORDER.map(t => ({ t, list: ties.filter(x => x.type === t).sort((a, b) => RANK[byId.get(a.other)!.tier] - RANK[byId.get(b.other)!.tier]) })).filter(x => x.list.length);
const events = eventsOf(p.id).sort((a, b) => a.c[0] - b.c[0]);
const homes = homesOf(p.id);
const verse = verseOf(p.id);
const span = spanOf(p.id);
const total = STATS.totals[p.id] ?? 0;
const first = STATS.firstSeen[p.id];
const companions = (STATS.companions[p.id] ?? []).filter(([o]) => o !== p.id).slice(0, 10);
const img = portraitImage(p.portrait);
/* 原文初见：把名字所在的那几个字标出来 */
let firstHtml = '';
if (first) {
  const nm = [p.id, ...(p.names ?? []).map(n => n.replace(/@.*/, ''))].sort((a, b) => b.length - a.length).find(n => first.text.includes(n)) ?? p.id;
  const i = first.text.indexOf(nm);
  const esc = (s: string) => s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
  firstHtml = '…' + esc(first.text.slice(0, i)) + `<mark>${esc(nm)}</mark>` + esc(first.text.slice(i + nm.length)) + '…';
}
/* 同组前后两人，方便连着翻 */
const sameGroup = PEOPLE.filter(x => x.group === p.group);
const idx = sameGroup.indexOf(p);
const prev = sameGroup[(idx - 1 + sameGroup.length) % sameGroup.length];
const next = sameGroup[(idx + 1) % sameGroup.length];
/* 前八十回里的结局写在哪一回，从文字里取“第N回”，取不到就用最后出场那回 */
const CN_NUM: Record<string, number> = { 一: 1, 二: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9 };
const parseCn = (t: string) => {
  let n = 0, cur = 0;
  for (const ch of t) {
    if (ch === '十') { n += (cur || 1) * 10; cur = 0; }
    else if (ch === '百') { n += (cur || 1) * 100; cur = 0; }
    else if (ch === '零') continue;
    else cur = CN_NUM[ch] ?? 0;
  }
  return n + cur;
};
const endHui = /第([一二三四五六七八九十百零]+)回/.exec(p.end ?? '');
const endCh = endHui ? parseCn(endHui[1]) : Math.min(span?.[1] ?? 80, 80);
const sequelCount = STATS.sequel?.[p.id] ?? 0;
const zhi = NOTES[p.id];
const desc = `${p.id}，${p.title}。${p.bio}`;
---
<Base title={p.id} description={desc.slice(0, 150)} section="people" sub="index" bodyClass="pg-person">
  <article class="person" style={`--pc:${color}`}>
    <header class="hero wrap">
      <nav class="crumbs" aria-label="位置">
        <a href="/people/">人物谱</a><span aria-hidden="true">／</span><a href={`/people/#${p.group}`}>{g.name}</a>
      </nav>
      <div class="hero-grid">
        <div class="frame-col">
          {img ? (
            <button class="scroll-frame ink-in" type="button" data-zoom aria-label={`看${p.id}的大图`} style={`view-transition-name:pic-${PEOPLE.indexOf(p)}`}>
              <span class="rod top" aria-hidden="true"></span>
              <Picture src={img} widths={[360, 540, 720]} sizes="(max-width: 760px) 60vw, 340px" formats={['avif', 'webp']} alt={`${p.id}画像`} class="pic" loading="eager" />
              <span class="rod bottom" aria-hidden="true"></span>
            </button>
          ) : (
            <div class="name-scroll ink-in" aria-hidden="true">
              <span class="ns-name vert">{p.id}</span>
              <Seal text={g.seal} size={34} color={color} />
            </div>
          )}
        </div>
        <div class="intro">
          <div class="tags">
            <span class="tag" style={`--c:${color}`}><Seal text={g.seal} size={22} color={color} />{g.name}</span>
            {p.book && <a class="tag book" href="/twelve/">{BOOKS[p.book]}</a>}
            {p.tier === 'o' && <span class="tag">信物</span>}
          </div>
          <h1 class="name ink-in" style={`view-transition-name:nm-${PEOPLE.indexOf(p)}`}>{p.id}</h1>
          <p class="title ink-in" style="--d:.15s">{p.title}</p>
          <p class="bio ink-in" style="--d:.3s">{p.bio}</p>
          {names.length > 0 && (
            <p class="aka ink-in" style="--d:.4s"><span class="label">也叫</span>{names.map(n => <span class="aka-n">{n}</span>)}</p>
          )}
          <dl class="facts ink-in" style="--d:.5s">
            {(total > 0 || sequelCount > 0) && <div><dt>前八十回提到</dt><dd><b>{cn(total)}</b>次{sequelCount > 0 && <small class="xu-n">续书另有{cn(sequelCount)}次</small>}</dd></div>}
            {zhi && <div><dt>批语点到</dt><dd><b>{cn(zhi.total)}</b>次</dd></div>}
            {span && <div><dt>出场</dt><dd><a href={`/chapters/${span[0]}/`}>{huiName(span[0])}</a>{span[1] !== span[0] && <> 至 <a href={`/chapters/${span[1]}/`}>{huiName(span[1])}</a></>}</dd></div>}
            {ties.length > 0 && <div><dt>亲友</dt><dd><b>{cn(ties.length)}</b>人</dd></div>}
            {homes.length > 0 && <div><dt>园中住处</dt><dd>{homes.map(h => <a href={`/garden/#${h.id}`}>{h.name}</a>)}</dd></div>}
          </dl>
        </div>
      </div>
    </header>

    {(total > 0 || sequelCount > 0) && (
      <section class="wrap block reveal">
        <div class="block-head"><h2>一百二十回里的{p.tier === 'o' ? '踪迹' : '身影'}</h2></div>
        <MentionStrip id={p.id} color={color} />
      </section>
    )}

    {verse && (
      <section class="wrap block verse-block reveal">
        <div class="block-head"><h2>判詞</h2><p class="src">第五回　{verse.book ?? '正册'}</p></div>
        <div class="verse card">
          <div class="verse-lines">{verse.verse.map((l, i) => <span style={`--d:${i * .12}s`}>{l}</span>)}</div>
          <div class="verse-side">
            <p><b>畫</b>{verse.pic}</p>
            {verse.song && <p><b>曲</b>{verse.song}</p>}
            {verse.flower && <p><b>籤</b>{verse.flower}</p>}
            <details class="gloss spoil" data-ch="81">
              <summary>判词暗示的结局</summary>
              <div class="spoil-body"><p>{verse.gloss}</p></div>
            </details>
          </div>
        </div>
      </section>
    )}

    {ties.length > 0 && (
      <section class="wrap block">
        <div class="block-head reveal"><h2>親友</h2></div>
        <div class="ties">
          <EgoGraph id={p.id} />
          <div class="tie-lists">
            {grouped.map(({ t, list }) => (
              <div class="tie-group reveal">
                <h3>{REL_TYPES[t].name}</h3>
                <ul>
                  {list.map(x => (
                    <li>
                      <PersonLink id={x.other} /><span class="role">{x.role}</span>
                      {x.note && <span class="tnote">{x.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <a class="more" href={`/graph/?focus=${encodeURIComponent(p.id)}`}>在关系图上牵线</a>
          </div>
        </div>
      </section>
    )}

    {events.length > 0 && (
      <section class="wrap block">
        <div class="block-head reveal"><h2>書中經歷</h2></div>
        <ol class="evs">
          {events.map(e => (
            <li class="ev spoil reveal" data-ch={e.c[0]} style={`--k:${EVENT_KINDS[e.k]}`}>
              <div class="spoil-body">
                <a class="ev-hui" href={`/chapters/${e.c[0]}/`}>{huiRange(e.c)}{e.c[0] > 80 && <span class="note-xu">续书</span>}</a>
                <div>
                  <h3>{e.t}<span class="ev-k">{e.k}</span></h3>
                  <p>{e.d}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {zhi && (
      <section class="wrap block">
        <div class="block-head reveal"><h2>批语</h2></div>
        <ol class="zhi">
          {zhi.top.map(x => (
            <li class:list={['zhi-item reveal', { late: x.src.length > 0 && x.src.every(s => ['蒙府', '戚序', '梦稿', '列藏', '甲辰', '舒序'].includes(s)) }]}>
              <a class="zhi-where" href={`/chapters/${x.n}/#p${x.block + 1}`}><span>{huiName(x.n)}</span><b>{noteLabel(x)}</b></a>
              {x.ctx && <p class="zhi-ctx">……{x.ctx}</p>}
              <p class="zhi-s">{x.s}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {(first || companions.length > 0) && (
      <section class="wrap block two reveal">
        {first && (
          <div>
            <div class="block-head"><h2>原文初見</h2><p class="src"><a href={`/chapters/${first.n}/`}>{huiName(first.n)}　{chapter(first.n).title.join(' ')}</a></p></div>
            <blockquote class="first" set:html={firstHtml} />
            <a class="more" href={`/chapters/${first.n}/?q=${encodeURIComponent(p.id)}`}>读这一回</a>
          </div>
        )}
        {companions.length > 0 && (
          <div>
            <div class="block-head"><h2>常在一處</h2></div>
            <ol class="comp">
              {companions.map(([o, v], i) => {
                const op = byId.get(o)!;
                return <li style={`--w:${Math.round((v / companions[0][1]) * 100)}%;--gc:var(--g-${op.group})`}><PersonLink id={o} /><span class="bar"><i /></span><span class="cnt">{cn(v)}</span></li>;
              })}
            </ol>
          </div>
        )}
      </section>
    )}

    {(p.end || p.fate || p.xu) && (
      <section class="wrap block reveal">
        <details class="ending">
          <summary><span class="end-t">結局</span></summary>
          <div class="ends">
            {p.end && (
              <div class="end-row spoil" data-ch={endCh}>
                <div class="spoil-body"><h3>前八十回</h3><p>{p.end}</p></div>
              </div>
            )}
            {p.fate && (
              <div class="end-row fate spoil" data-ch="81">
                <div class="spoil-body"><h3>原稿原意<small>据判词、伏笔与批语</small></h3><p>{p.fate}</p></div>
              </div>
            )}
            {p.xu && (
              <div class="end-row xu spoil" data-ch="81">
                <div class="spoil-body"><h3>续书写法<small>后四十回，非曹雪芹原作</small></h3><p>{p.xu}</p></div>
              </div>
            )}
          </div>
        </details>
      </section>
    )}

    <nav class="wrap pager" aria-label="同组的其他人物">
      <a href={`/people/${prev.id}/`} class="pg prev"><span class="pg-k">上一位</span><span class="pg-n">{prev.id}</span></a>
      <a href={`/people/${next.id}/`} class="pg next"><span class="pg-k">下一位</span><span class="pg-n">{next.id}</span></a>
    </nav>
  </article>

  {img && (
    <dialog class="zoom" data-zoom-dlg aria-label={`${p.id}画像`}>
      <form method="dialog"><button class="zoom-x" aria-label="关闭">合上</button></form>
      <Picture src={img} widths={[720, 1024]} sizes="min(90vw, 640px)" formats={['avif', 'webp']} alt={`${p.id}画像`} loading="lazy" />
    </dialog>
  )}
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-zoom-dlg]');
  document.querySelector('[data-zoom]')?.addEventListener('click', () => dlg?.showModal());
  dlg?.addEventListener('click', () => dlg.close());
</script>

<style>
  .hero { padding-top: 22px; }
  .crumbs { display: flex; gap: 10px; font: 400 15px/1 var(--title); letter-spacing: .16em; color: var(--ink-3); }
  .crumbs a:hover { color: var(--cinnabar); }
  .hero-grid { display: grid; grid-template-columns: minmax(220px, 340px) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); align-items: start; padding: 40px 0 20px; }
  /* 画像裱成一小幅立轴 */
  .scroll-frame { position: relative; display: block; width: 100%; padding: 22px 18px; background: #e6dcc4; box-shadow: inset 0 0 0 1px rgb(90 66 30 / .18), 0 26px 44px -30px rgb(40 26 10 / .6); cursor: zoom-in; }
  .scroll-frame::before { content: ''; position: absolute; inset: 12px 10px; box-shadow: inset 0 0 0 1px rgb(150 115 60 / .45); pointer-events: none; }
  .scroll-frame :global(.pic) { width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
  .rod { position: absolute; left: -10px; right: -10px; height: 12px; border-radius: 6px; background: linear-gradient(#6a4a2c, #8c6640 40%, #3e2814); box-shadow: 0 3px 6px -2px rgb(30 18 6 / .45); }
  .rod.top { top: -6px; }
  .rod.bottom { bottom: -6px; }
  .name-scroll { position: relative; display: grid; place-items: center; aspect-ratio: 2 / 3; background: radial-gradient(120% 80% at 50% 20%, color-mix(in srgb, var(--pc) 10%, var(--card)), var(--paper-3)); box-shadow: inset 0 0 0 1px rgb(90 66 30 / .16), 0 26px 44px -30px rgb(40 26 10 / .5); overflow: hidden; }
  .name-scroll::before { content: ''; position: absolute; inset: 12px; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pc) 35%, transparent); }
  .ns-name { font: 400 clamp(64px, 9vw, 104px)/1 var(--title); color: var(--pc); letter-spacing: .12em; }
  .name-scroll :global(.seal) { position: absolute; bottom: 26px; left: 26px; }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .tag { display: inline-flex; align-items: center; gap: 10px; font: 400 16px/1 var(--title); color: var(--ink-2); letter-spacing: .16em; }
  .tag.book { color: var(--cinnabar); padding: 5px 8px 4px 10px; box-shadow: inset 0 0 0 1px currentColor; }
  .name { font: 400 clamp(64px, 9vw, 120px)/1 var(--title); letter-spacing: .1em; margin: 22px 0 10px; color: var(--ink); }
  .title { font-size: 18px; color: var(--ink-2); letter-spacing: .14em; }
  .bio { margin-top: 26px; font-size: clamp(17px, 1.6vw, 19px); line-height: 2.05; max-width: 34em; text-wrap: pretty; }
  .aka { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; font-size: 15.5px; }
  .label { font: 400 14px/1 var(--title); letter-spacing: .24em; color: var(--cinnabar); margin-right: 4px; }
  .aka-n { color: var(--ink-2); }
  .facts { display: flex; flex-wrap: wrap; gap: 18px 44px; margin: 32px 0 0; padding-top: 24px; border-top: 1px solid var(--line); }
  .facts dt { font: 400 14px/1 var(--title); letter-spacing: .24em; color: var(--ink-3); margin-bottom: 10px; }
  .facts dd { margin: 0; display: flex; align-items: baseline; gap: 4px 10px; flex-wrap: wrap; font: 400 16px/1.4 var(--title); letter-spacing: .06em; }
  .facts b { font: 400 22px/1 var(--title); color: var(--pc); letter-spacing: .04em; margin-right: 2px; }
  .facts a { color: var(--ink); }
  .facts a:hover { color: var(--cinnabar); }
  .xu-n { font: 400 13px/1.6 var(--serif); color: var(--ink-3); }

  .block { padding-top: clamp(56px, 7vw, 92px); }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 26px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .block-head h2 { display: flex; align-items: center; gap: 14px; font: 400 clamp(26px, 2.8vw, 32px)/1.1 var(--title); letter-spacing: .24em; }
  .block-head h2::before { content: ''; width: 9px; height: 9px; border-radius: 50%; box-shadow: inset 0 0 0 1.6px var(--cinnabar); }
  .block-head .src { font: 400 15px/1.4 var(--title); letter-spacing: .16em; color: var(--ink-3); }
  .block-head a:hover { color: var(--cinnabar); }

  /* 判词：一句一行竖写，行与行之间打朱丝栏，字落在格子正中 */
  .verse { --u: clamp(46px, 4.6vw, 56px); display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); padding: clamp(26px, 4vw, 44px); background: var(--card); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 22%, transparent), inset 0 0 0 4px var(--card), inset 0 0 0 5px color-mix(in srgb, var(--ink) 10%, transparent); }
  .verse-lines { writing-mode: vertical-rl; padding: 18px 0; font: 400 calc(var(--u) * .5)/var(--u) var(--title); letter-spacing: .36em; color: var(--ink); box-shadow: inset 1px 0 0 color-mix(in srgb, var(--cinnabar) 30%, transparent), inset -1px 0 0 color-mix(in srgb, var(--cinnabar) 30%, transparent); background-image: repeating-linear-gradient(to left, transparent 0 calc(var(--u) - 1px), color-mix(in srgb, var(--cinnabar) 22%, transparent) calc(var(--u) - 1px) var(--u)); background-position: right; }
  .verse-lines span { display: block; }
  .verse-side { display: grid; gap: 14px; align-content: start; font-size: 15.5px; line-height: 1.9; color: var(--ink-2); }
  .verse-side > p { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 10px; }
  .verse-side b { font: 400 17px/1.8 var(--title); color: var(--cinnabar); }
  .gloss summary, .ending summary { cursor: pointer; list-style: none; }
  .gloss summary { font: 400 15px/1.6 var(--title); color: var(--cinnabar); letter-spacing: .14em; padding-left: 40px; }
  .gloss summary::-webkit-details-marker, .ending summary::-webkit-details-marker { display: none; }
  .gloss p { margin-top: 10px; padding-left: 40px; line-height: 1.95; color: var(--ink); }

  .ties { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 56px); align-items: start; }
  .tie-lists { columns: 2 220px; column-gap: 32px; }
  .tie-group { break-inside: avoid; margin-bottom: 24px; }
  .tie-group h3 { font: 400 16px/1 var(--title); letter-spacing: .26em; color: var(--cinnabar); margin-bottom: 12px; }
  .tie-group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .tie-group li { font-size: 16px; line-height: 1.5; }
  .role { font: 400 13px var(--serif); color: var(--ink-3); margin-left: 8px; }
  .tnote { display: block; font-size: 13.5px; color: var(--ink-3); line-height: 1.7; margin-top: 2px; }
  .more { display: inline-flex; align-items: center; gap: 10px; margin-top: 8px; font: 400 15px/1.4 var(--title); letter-spacing: .16em; color: var(--ink-3); transition: color .3s; }
  .more::before { content: ''; width: 18px; height: 1.5px; background: var(--cinnabar); }
  .more:hover { color: var(--cinnabar); }

  .evs { list-style: none; margin: 0 0 0 6px; padding: 0; display: grid; border-left: 1px solid var(--line-2); }
  .ev { position: relative; padding: 0 0 30px 32px; }
  .ev::before { content: ''; position: absolute; left: -5px; top: 9px; width: 9px; height: 9px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 1.6px var(--k); }
  .ev .spoil-body { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 8px 26px; }
  .ev-hui { font: 400 15px/1.9 var(--title); color: var(--cinnabar); letter-spacing: .1em; display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .ev h3 { font: 400 21px/1.4 var(--title); letter-spacing: .08em; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .ev-k { font: 400 13px/1 var(--title); color: var(--k); letter-spacing: .2em; }
  .ev p { margin-top: 6px; color: var(--ink-2); font-size: 15.5px; line-height: 1.95; max-width: 44em; }
  .note-xu { font: 400 12.5px/1 var(--title); color: var(--ink-3); }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); }
  .first { margin: 0 0 16px; padding: 22px 26px; font: 400 18px/2.05 var(--serif); background: var(--card); box-shadow: inset 2px 0 0 var(--pc), 0 14px 30px -26px rgb(40 26 10 / .5); }
  .first :global(mark) { background: none; color: var(--cinnabar); text-emphasis: open circle var(--cinnabar); -webkit-text-emphasis: open circle var(--cinnabar); text-emphasis-position: under right; -webkit-text-emphasis-position: under right; }
  .comp { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .comp li { display: grid; grid-template-columns: 6.5em minmax(0, 1fr) 6em; align-items: center; gap: 12px; font-size: 15.5px; }
  .comp .bar { height: 3px; background: var(--paper-2); overflow: hidden; }
  .comp .bar i { display: block; height: 100%; width: var(--w); background: var(--gc); opacity: .75; transform-origin: left; }
  .comp .cnt { font: 400 13px/1 var(--title); color: var(--ink-3); text-align: right; }
  @media (prefers-reduced-motion: no-preference) {
    .reveal.in .comp .bar i, .two.in .comp .bar i { animation: grow 1s var(--ease-ink) both; }
  }
  @keyframes grow { from { transform: scaleX(0); } }

  .ending { padding: 24px 28px; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); }
