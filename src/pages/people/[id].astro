---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Seal from '../../components/Seal.astro';
import MentionStrip from '../../components/MentionStrip.astro';
import EgoGraph from '../../components/EgoGraph.astro';
import {
  PEOPLE, GROUPS, BOOKS, REL_TYPES, TYPE_ORDER, STATS, byId, tiesOf, eventsOf, homesOf, verseOf, namesOf, spanOf,
  huiName, huiRange, chapter, cn, RANK, NOTES, noteLabel, type Person
} from '../../lib/data.ts';
import { EVENT_KINDS } from '../../data/events.ts';
import { portraitImage } from '../../lib/portraits.ts';

export function getStaticPaths() {
  return PEOPLE.map(p => ({ params: { id: p.id }, props: { p } }));
}
interface Props { p: Person }
const { p } = Astro.props;
const g = GROUPS[p.group];
const color = `var(--g-${p.group})`;
const names = namesOf(p);
const ties = tiesOf(p.id).filter(t => byId.has(t.other));
const grouped = TYPE_ORDER.map(t => ({ t, list: ties.filter(x => x.type === t).sort((a, b) => RANK[byId.get(a.other)!.tier] - RANK[byId.get(b.other)!.tier]) })).filter(x => x.list.length);
const events = eventsOf(p.id).sort((a, b) => a.c[0] - b.c[0]);
const homes = homesOf(p.id);
const verse = verseOf(p.id);
const span = spanOf(p.id);
const total = STATS.totals[p.id] ?? 0;
const first = STATS.firstSeen[p.id];
const companions = (STATS.companions[p.id] ?? []).filter(([o]) => o !== p.id).slice(0, 10);
const img = portraitImage(p.portrait);
/* 原文初见：把名字所在的那几个字标出来 */
let firstHtml = '';
if (first) {
  const nm = [p.id, ...(p.names ?? []).map(n => n.replace(/@.*/, ''))].sort((a, b) => b.length - a.length).find(n => first.text.includes(n)) ?? p.id;
  const i = first.text.indexOf(nm);
  const esc = (s: string) => s.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
  firstHtml = '…' + esc(first.text.slice(0, i)) + `<mark>${esc(nm)}</mark>` + esc(first.text.slice(i + nm.length)) + '…';
}
/* 同组前后两人，方便连着翻 */
const sameGroup = PEOPLE.filter(x => x.group === p.group);
const idx = sameGroup.indexOf(p);
const prev = sameGroup[(idx - 1 + sameGroup.length) % sameGroup.length];
const next = sameGroup[(idx + 1) % sameGroup.length];
/* 前八十回里的结局写在哪一回，从文字里取“第N回”，取不到就用最后出场那回 */
const CN_NUM: Record<string, number> = { 一: 1, 二: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9 };
const parseCn = (t: string) => {
  let n = 0, cur = 0;
  for (const ch of t) {
    if (ch === '十') { n += (cur || 1) * 10; cur = 0; }
    else if (ch === '百') { n += (cur || 1) * 100; cur = 0; }
    else if (ch === '零') continue;
    else cur = CN_NUM[ch] ?? 0;
  }
  return n + cur;
};
const endHui = /第([一二三四五六七八九十百零]+)回/.exec(p.end ?? '');
const endCh = endHui ? parseCn(endHui[1]) : Math.min(span?.[1] ?? 80, 80);
const sequelCount = STATS.sequel?.[p.id] ?? 0;
const zhi = NOTES[p.id];
const desc = `${p.id}，${p.title}。${p.bio}`;
---
<Base title={p.id} description={desc.slice(0, 150)} section="people" sub="index" bodyClass="pg-person">
  <article class="person" style={`--pc:${color}`}>
    <header class="hero wrap">
      <nav class="crumbs" aria-label="位置">
        <a href="/people/">人物谱</a><span aria-hidden="true">／</span><a href={`/people/#${p.group}`}>{g.name}</a>
      </nav>
      <div class="hero-grid">
        <div class="frame-col">
          {img ? (
            <button class="scroll-frame ink-in" type="button" data-zoom aria-label={`看${p.id}的大图`} style={`view-transition-name:pic-${PEOPLE.indexOf(p)}`}>
              <span class="rod top" aria-hidden="true"></span>
              <Picture src={img} widths={[360, 540, 720]} sizes="(max-width: 760px) 60vw, 340px" formats={['avif', 'webp']} alt={`${p.id}画像`} class="pic" loading="eager" />
              <span class="rod bottom" aria-hidden="true"></span>
            </button>
          ) : (
            <div class="name-scroll ink-in" aria-hidden="true">
              <span class="ns-name vert">{p.id}</span>
              <Seal text={g.seal} size={34} color={color} />
            </div>
          )}
        </div>
        <div class="intro">
          <div class="tags">
            <span class="tag" style={`--c:${color}`}><Seal text={g.seal} size={22} color={color} />{g.name}</span>
            {p.book && <a class="tag book" href="/twelve/">{BOOKS[p.book]}</a>}
            {p.tier === 'o' && <span class="tag">信物</span>}
          </div>
          <h1 class="name ink-in" style={`view-transition-name:nm-${PEOPLE.indexOf(p)}`}>{p.id}</h1>
          <p class="title ink-in" style="--d:.15s">{p.title}</p>
          <p class="bio ink-in" style="--d:.3s">{p.bio}</p>
          {names.length > 0 && (
            <p class="aka ink-in" style="--d:.4s"><span class="label">也叫</span>{names.map(n => <span class="aka-n">{n}</span>)}</p>
          )}
          <dl class="facts ink-in" style="--d:.5s">
            {(total > 0 || sequelCount > 0) && <div><dt>前八十回提到</dt><dd><b>{total}</b> 次{sequelCount > 0 && <small class="xu-n">续书另有 {sequelCount} 次</small>}</dd></div>}
            {zhi && <div><dt>脂批点到</dt><dd><b>{zhi.total}</b> 次</dd></div>}
            {span && <div><dt>出场</dt><dd><a href={`/chapters/${span[0]}/`}>{huiName(span[0])}</a>{span[1] !== span[0] && <> 至 <a href={`/chapters/${span[1]}/`}>{huiName(span[1])}</a></>}</dd></div>}
            {ties.length > 0 && <div><dt>亲友</dt><dd><b>{ties.length}</b> 人</dd></div>}
            {homes.length > 0 && <div><dt>园中住处</dt><dd>{homes.map(h => <a href={`/garden/#${h.id}`}>{h.name}</a>)}</dd></div>}
          </dl>
        </div>
      </div>
    </header>

    {(total > 0 || sequelCount > 0) && (
      <section class="wrap block reveal">
        <div class="block-head"><h2>一百二十回里的{p.tier === 'o' ? '踪迹' : '身影'}</h2><p class="muted small">每回一笔，按原文里提到{p.id}的次数画浓淡，点一笔进那一回</p></div>
        <MentionStrip id={p.id} color={color} />
      </section>
    )}

    {verse && (
      <section class="wrap block verse-block reveal">
        <div class="block-head"><h2>判词</h2><p class="muted small">第五回，{verse.book ?? '正册'}</p></div>
        <div class="verse card">
          <div class="verse-lines kai">{verse.verse.map((l, i) => <span style={`--d:${i * .12}s`}>{l}</span>)}</div>
          <div class="verse-side">
            <p><b>画</b>{verse.pic}</p>
            {verse.song && <p><b>曲</b>{verse.song}</p>}
            {verse.flower && <p><b>花签</b>{verse.flower}</p>}
            <details class="gloss spoil" data-ch="81">
              <summary>解读与暗示的结局</summary>
              <div class="spoil-body"><p>{verse.gloss}</p></div>
            </details>
          </div>
        </div>
      </section>
    )}

    {ties.length > 0 && (
      <section class="wrap block">
        <div class="block-head reveal"><h2>亲友</h2><p class="muted small">名字后面的小字，是对方之于{p.id}的身份</p></div>
        <div class="ties">
          <EgoGraph id={p.id} />
          <div class="tie-lists">
            {grouped.map(({ t, list }) => (
              <div class="tie-group reveal">
                <h3>{REL_TYPES[t].name}</h3>
                <ul>
                  {list.map(x => (
                    <li>
                      <PersonLink id={x.other} /><span class="role">{x.role}</span>
                      {x.note && <span class="tnote">{x.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <a class="link" href={`/graph/?focus=${encodeURIComponent(p.id)}`}>在关系星图里看{p.id}</a>
          </div>
        </div>
      </section>
    )}

    {events.length > 0 && (
      <section class="wrap block">
        <div class="block-head reveal"><h2>书中经历</h2><p class="muted small">{events.length} 件大事，按回目先后</p></div>
        <ol class="evs">
          {events.map(e => (
            <li class="ev spoil reveal" data-ch={e.c[0]} style={`--k:${EVENT_KINDS[e.k]}`}>
              <div class="spoil-body">
                <a class="ev-hui" href={`/chapters/${e.c[0]}/`}>{huiRange(e.c)}{e.c[0] > 80 && <span class="note-xu">续书</span>}</a>
                <div>
                  <h3>{e.t}<span class="ev-k">{e.k}</span></h3>
                  <p>{e.d}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {zhi && (
      <section class="wrap block">
        <div class="block-head reveal"><h2>脂批</h2><p class="muted small">脂砚斋等人在抄本上留下的批语，点到{p.id}的有 {zhi.total} 条，这里挑了 {zhi.top.length} 条</p></div>
        <ol class="zhi">
          {zhi.top.map(x => (
            <li class:list={['zhi-item reveal', { late: x.src.length > 0 && x.src.every(s => ['蒙府', '戚序', '梦稿', '列藏', '甲辰', '舒序'].includes(s)) }]}>
              <a class="zhi-where" href={`/chapters/${x.n}/#p${x.block + 1}`}><span>{huiName(x.n)}</span><b>{noteLabel(x)}</b></a>
              {x.ctx && <p class="zhi-ctx">……{x.ctx}</p>}
              <p class="zhi-s kai">{x.s}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {(first || companions.length > 0) && (
      <section class="wrap block two reveal">
        {first && (
          <div>
            <div class="block-head"><h2>原文初见</h2><p class="muted small"><a href={`/chapters/${first.n}/`}>{huiName(first.n)}　{chapter(first.n).title.join(' ')}</a></p></div>
            <blockquote class="first kai" set:html={firstHtml} />
            <a class="link" href={`/chapters/${first.n}/?q=${encodeURIComponent(p.id)}`}>读这一回</a>
          </div>
        )}
        {companions.length > 0 && (
          <div>
            <div class="block-head"><h2>常在一处</h2><p class="muted small">原文同一段里一起出现最多的人</p></div>
            <ol class="comp">
              {companions.map(([o, v], i) => {
                const op = byId.get(o)!;
                return <li style={`--w:${Math.round((v / companions[0][1]) * 100)}%;--gc:var(--g-${op.group})`}><PersonLink id={o} /><span class="bar"><i /></span><span class="cnt">{v}</span></li>;
              })}
            </ol>
          </div>
        )}
      </section>
    )}

    {(p.end || p.fate || p.xu) && (
      <section class="wrap block reveal">
        <details class="ending">
          <summary><span class="brush">结局</span><span class="muted small">默认收起，免得剧透</span></summary>
          <div class="ends">
            {p.end && (
              <div class="end-row spoil" data-ch={endCh}>
                <div class="spoil-body"><h3>前八十回</h3><p>{p.end}</p></div>
              </div>
            )}
            {p.fate && (
              <div class="end-row fate spoil" data-ch="81">
                <div class="spoil-body"><h3>原稿原意<small>据判词、伏笔与脂批</small></h3><p>{p.fate}</p></div>
              </div>
            )}
            {p.xu && (
              <div class="end-row xu spoil" data-ch="81">
                <div class="spoil-body"><h3>续书写法<small>后四十回，非曹雪芹原作</small></h3><p>{p.xu}</p></div>
              </div>
            )}
          </div>
        </details>
      </section>
    )}

    <nav class="wrap pager" aria-label="同组的其他人物">
      <a href={`/people/${prev.id}/`} class="pg prev"><span class="muted small">上一位 · {g.name}</span><span class="brush">{prev.id}</span></a>
      <a href={`/people/${next.id}/`} class="pg next"><span class="muted small">下一位 · {g.name}</span><span class="brush">{next.id}</span></a>
    </nav>
  </article>

  {img && (
    <dialog class="zoom" data-zoom-dlg aria-label={`${p.id}画像`}>
      <form method="dialog"><button class="zoom-x" aria-label="关闭">合上</button></form>
      <Picture src={img} widths={[720, 1024]} sizes="min(90vw, 640px)" formats={['avif', 'webp']} alt={`${p.id}画像`} loading="lazy" />
    </dialog>
  )}
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-zoom-dlg]');
  document.querySelector('[data-zoom]')?.addEventListener('click', () => dlg?.showModal());
  dlg?.addEventListener('click', () => dlg.close());
</script>

<style>
  .hero { padding-top: 22px; }
  .crumbs { font: 500 13px/1 var(--label); color: var(--ink-3); display: flex; gap: 8px; letter-spacing: .08em; }
  .crumbs a:hover { color: var(--cinnabar); }
  .hero-grid { display: grid; grid-template-columns: minmax(220px, 340px) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: start; padding: 34px 0 20px; }
  .scroll-frame { position: relative; display: block; width: 100%; padding: 18px 16px; background: var(--paper-3); border-radius: 3px; box-shadow: var(--shadow-lg); cursor: zoom-in; }
  .scroll-frame::before { content: ''; position: absolute; inset: 10px 9px; border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent); pointer-events: none; }
  .scroll-frame :global(.pic) { width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 1px; }
  .rod { position: absolute; left: -10px; right: -10px; height: 10px; border-radius: 5px; background: linear-gradient(#5a3a22, #2e1c10); }
  .rod.top { top: -5px; }
  .rod.bottom { bottom: -5px; }
  .name-scroll { position: relative; display: grid; place-items: center; aspect-ratio: 2 / 3; border-radius: 3px; background: radial-gradient(120% 80% at 50% 20%, color-mix(in srgb, var(--pc) 14%, var(--card)), var(--paper-3)); box-shadow: var(--shadow-lg); overflow: hidden; }
  .name-scroll::before { content: ''; position: absolute; inset: 12px; border: 1px solid color-mix(in srgb, var(--pc) 40%, transparent); }
  .ns-name { font: 700 clamp(64px, 9vw, 108px)/1 var(--display); color: var(--pc); letter-spacing: .12em; }
  .name-scroll :global(.seal) { position: absolute; bottom: 26px; left: 26px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag { display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px 4px 4px; border: 1px solid var(--line-2); border-radius: 999px; font: 600 12.5px/1 var(--label); color: var(--ink-2); letter-spacing: .08em; }
  .tag.book { padding-left: 12px; color: var(--cinnabar); border-color: color-mix(in srgb, var(--cinnabar) 40%, transparent); }
  .name { font: 700 clamp(64px, 10vw, 128px)/1 var(--display); letter-spacing: .06em; margin: 18px 0 6px; color: var(--ink); }
  .title { font-size: 18px; color: var(--ink-2); letter-spacing: .12em; }
  .bio { margin-top: 24px; font-size: clamp(17px, 1.6vw, 19.5px); line-height: 2; max-width: 34em; text-wrap: pretty; }
  .aka { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; font-size: 15px; }
  .label { font: 600 12px/1 var(--label); letter-spacing: .2em; color: var(--ink-3); margin-right: 4px; }
  .aka-n { padding: 1px 0; border-bottom: 1px dashed var(--line-2); color: var(--ink-2); }
  .facts { display: flex; flex-wrap: wrap; gap: 14px 36px; margin: 30px 0 0; padding-top: 22px; border-top: 1px solid var(--line); }
  .facts dt { font: 600 11.5px/1 var(--label); letter-spacing: .22em; color: var(--ink-3); margin-bottom: 8px; }
  .facts dd { margin: 0; font-size: 16px; display: flex; gap: 6px; flex-wrap: wrap; }
  .facts b { font: 600 26px/1 var(--serif); color: var(--pc); margin-right: 2px; font-variant-numeric: oldstyle-nums; }
  .facts a { color: var(--ink); border-bottom: 1px solid var(--line-2); }
  .facts a:hover { color: var(--cinnabar); border-color: var(--cinnabar); }

  .block { padding-top: clamp(44px, 6vw, 72px); }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .block-head h2 { font: 700 clamp(28px, 3.4vw, 38px)/1.1 var(--display); letter-spacing: .06em; }
  .block-head a:hover { color: var(--cinnabar); }

  .verse { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); padding: clamp(22px, 4vw, 40px); }
  .verse-lines { writing-mode: vertical-rl; display: flex; gap: .7em; padding: 0 .5em 0 1.2em; border-left: 1px solid var(--line-2); border-right: 1px solid var(--line-2); background-image: linear-gradient(to left, transparent calc(100% - 1px), color-mix(in srgb, var(--cinnabar) 22%, transparent) 0); background-size: 2.15em 100%; font-size: clamp(22px, 2.4vw, 28px); letter-spacing: .32em; line-height: 1.5; color: var(--ink); max-height: 9.5em; flex-wrap: wrap; }
  .verse-side { display: grid; gap: 10px; align-content: start; font-size: 15.5px; color: var(--ink-2); }
  .verse-side b { font: 700 12px/1 var(--label); color: var(--cinnabar); border: 1px solid currentColor; padding: 3px 5px; border-radius: 3px; margin-right: 10px; letter-spacing: .1em; vertical-align: 2px; }
  .gloss summary, .ending summary { cursor: pointer; list-style: none; font: 600 13.5px/1.4 var(--label); color: var(--cinnabar); letter-spacing: .08em; }
  .gloss summary::before, .ending summary::before { content: '▸ '; }
  .gloss[open] summary::before, .ending[open] summary::before { content: '▾ '; }
  .gloss p { margin-top: 10px; line-height: 1.9; }

  .ties { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 56px); align-items: start; }
  .tie-lists { columns: 2 220px; column-gap: 32px; }
  .tie-group { break-inside: avoid; margin-bottom: 22px; }
  .tie-group h3 { font: 700 12px/1 var(--label); letter-spacing: .26em; color: var(--ink-3); margin-bottom: 10px; }
  .tie-group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .tie-group li { font-size: 16px; line-height: 1.5; }
  .role { font: 500 12.5px var(--label); color: var(--ink-3); margin-left: 8px; }
  .tnote { display: block; font-size: 13px; color: var(--ink-3); line-height: 1.6; margin-top: 2px; }
  .tie-lists .link { margin-top: 6px; }

  .evs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-left: 1px solid var(--line-2); margin-left: 6px; }
  .ev { position: relative; padding: 0 0 26px 30px; }
  .ev::before { content: ''; position: absolute; left: -6px; top: 8px; width: 11px; height: 11px; border-radius: 50%; background: var(--paper); border: 2px solid var(--k); }
  .ev .spoil-body { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 8px 24px; }
  .ev-hui { font: 600 13.5px/1.9 var(--label); color: var(--cinnabar); letter-spacing: .06em; display: flex; gap: 6px; align-items: baseline; flex-wrap: wrap; }
  .ev h3 { font-size: 19px; font-weight: 700; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .ev-k { font: 600 11px/1 var(--label); color: var(--k); letter-spacing: .2em; }
  .ev p { margin-top: 6px; color: var(--ink-2); font-size: 15.5px; line-height: 1.9; max-width: 44em; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); }
  .first { margin: 0 0 16px; padding: 22px 26px; font-size: 18px; line-height: 2; background: var(--card); border-left: 3px solid var(--pc); border-radius: 0 6px 6px 0; box-shadow: var(--shadow); }
  .first :global(mark) { background: none; color: var(--cinnabar); font-weight: 700; }
  .comp { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .comp li { display: grid; grid-template-columns: 6.5em minmax(0, 1fr) 3em; align-items: center; gap: 12px; font-size: 15.5px; }
  .comp .bar { height: 6px; background: var(--paper-2); border-radius: 3px; overflow: hidden; }
  .comp .bar i { display: block; height: 100%; width: var(--w); background: var(--gc); border-radius: 3px; opacity: .75; transform-origin: left; }
  .comp .cnt { font: 600 12.5px/1 var(--label); color: var(--ink-3); text-align: right; }
  @media (prefers-reduced-motion: no-preference) {
    .reveal.in .comp .bar i, .two.in .comp .bar i { animation: grow 1s var(--ease-ink) both; }
  }
  @keyframes grow { from { transform: scaleX(0); } }

  .ending { padding: 22px 26px; background: var(--card); border: 1px solid var(--line); border-radius: 6px; }
  .ending summary { display: flex; align-items: baseline; gap: 14px; color: var(--ink); }
  .ending summary::before { color: var(--cinnabar); }
  .ending summary .brush { font-size: 28px; font-weight: 400; }
  .ends { display: grid; gap: 4px; margin-top: 18px; }
  .end-row { padding: 14px 0 14px 18px; border-left: 3px solid var(--pc); }
  .end-row h3 { display: flex; align-items: baseline; gap: 10px; font: 700 13px/1.4 var(--label); letter-spacing: .16em; color: var(--ink-2); }
  .end-row h3 small { font-weight: 500; letter-spacing: .04em; color: var(--ink-3); }
  .end-row p { margin-top: 8px; font-size: 17px; line-height: 1.95; }
