---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Seal from '../../components/Seal.astro';
import Spark from '../../components/Spark.astro';
import PageHead from '../../components/PageHead.astro';
import { PEOPLE, BOOKS, STATS, peopleByGroup, namesOf, spanOf, cn } from '../../lib/data.ts';
import { portraitImage } from '../../lib/portraits.ts';

const groups = peopleByGroup();
const rank = [...PEOPLE].filter(p => p.tier !== 'o').sort((a, b) => (STATS.totals[b.id] ?? 0) - (STATS.totals[a.id] ?? 0));
const top = rank.slice(0, 24);
const max = STATS.totals[top[0].id];
---
<Base title="人物谱" description={`《红楼梦》${PEOPLE.length} 位人物与信物：按家族排开，可按姓名、别称、身份查找，看每人在一百二十回原文里出场多少。`} section="people" sub="index">
  <div class="wrap">
    <PageHead title="人物谱" slip="人物譜" quote="千红一窟｜万艳同杯" from="第五回　警幻的茶与酒" />

    <div class="tools-bar" data-filter>
      <label class="find">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.5 15.5 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <input type="search" placeholder="寻一个人，名字、别称或身份都可" data-f-q aria-label="筛选人物">
      </label>
      <div class="chips" role="group" aria-label="按家族筛选">
        <button class="fam" type="button" data-f-g="" aria-pressed="true" title="全部">全</button>
        {groups.map(({ g, info }) => <button class="fam" type="button" data-f-g={g} aria-pressed="false" style={`--c:var(--g-${g})`} title={info.name}>{info.seal}</button>)}
      </div>
      <div class="view" role="group" aria-label="排列方式">
        <button type="button" class="on" data-view="group" aria-pressed="true">按家族</button>
        <button type="button" data-view="rank" aria-pressed="false">按出场多寡</button>
      </div>
    </div>
    <p class="count" data-f-count aria-live="polite">共{cn(PEOPLE.length)}位</p>

    <div class="by-group" data-pane="group">
      {groups.map(({ g, info, list }) => (
        <section class="grp" id={g} data-grp={g} style={`--gc:var(--g-${g})`}>
          <header class="grp-head reveal">
            <Seal text={info.seal} size={42} color={`var(--g-${g})`} />
            <div><h2>{info.name}</h2><p class="grp-hint">{info.hint}</p></div>
            <span class="grp-n">{cn(list.length)}人</span>
          </header>
          <ul class="grid">
            {list.map((p, i) => {
              const img = portraitImage(p.portrait);
              const span = spanOf(p.id);
              return (
                <li class:list={['pc reveal', `t-${p.tier}`]} style={`--d:${Math.min(i, 12) * 30}ms`} data-q={[p.id, ...namesOf(p), p.title, p.bio].join(' ')} data-g={g}>
                  <a href={`/people/${p.id}/`} data-peek>
                    {img ? <Image src={img} width={96} height={128} alt="" class="thumb" loading="lazy" style={`view-transition-name:pic-${PEOPLE.indexOf(p)}`} />
                      : <span class="thumb name-thumb" aria-hidden="true">{p.id.slice(-1)}</span>}
                    <span class="pc-main">
                      <span class="pc-name" style={`view-transition-name:nm-${PEOPLE.indexOf(p)}`}>{p.id}</span>
                      <span class="pc-title">{p.title}</span>
                      <span class="pc-meta" title="一百二十回里出场的疏密，虚线以后是续书">
                        <Spark id={p.id} color={`var(--g-${g})`} />
                        <span>{STATS.totals[p.id] ? `${cn(STATS.totals[p.id])}见` : span ? '只见于续书' : '原文未直呼'}</span>
                      </span>
                    </span>
                    {p.book && <span class="pc-book" title={BOOKS[p.book]}>{p.book === 'z' ? '正' : p.book === 'f' ? '副' : '又副'}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
      <p class="empty" data-f-empty hidden>册上没有这个名字。<button type="button" class="link" data-f-reset>从头翻</button></p>
    </div>

    <section class="by-rank" data-pane="rank" hidden>
      <ol class="rank">
        {top.map((p, i) => (
          <li class="reveal" style={`--w:${(STATS.totals[p.id] / max) * 100}%;--gc:var(--g-${p.group});--d:${i * 25}ms`}>
            <span class="r-n">{cn(i + 1)}</span>
            <a href={`/people/${p.id}/`} class="r-name" data-peek>{p.id}</a>
            <span class="r-bar"><i /></span>
            <span class="r-v">{cn(STATS.totals[p.id])}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<script>
  import { observeReveal, cn } from '../../client/site.ts';
  const root = document.querySelector<HTMLElement>('[data-filter]')!;
  const q = root.querySelector<HTMLInputElement>('[data-f-q]')!;
  const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-f-g]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.pc')];
  const groups = [...document.querySelectorAll<HTMLElement>('.grp')];
  const count = document.querySelector('[data-f-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-f-empty]')!;
  let g = '';
  const norm = (s: string) => s.normalize('NFKC').toLowerCase().replace(/\s+/g, '');
  const qs = cards.map(c => norm(c.dataset.q!));
  function apply() {
    const v = norm(q.value);
    let n = 0;
    cards.forEach((c, i) => {
      const ok = (!g || c.dataset.g === g) && (!v || qs[i].includes(v));
      c.hidden = !ok;
      if (ok) { n++; c.classList.add('in'); }
    });
    groups.forEach(s => { s.hidden = !s.querySelector('.pc:not([hidden])'); });
    count.textContent = n === cards.length ? `共${cn(n)}位` : `寻得${cn(n)}位`;
    empty.hidden = n > 0;
    const url = new URL(location.href);
    v ? url.searchParams.set('q', q.value) : url.searchParams.delete('q');
    g ? url.searchParams.set('g', g) : url.searchParams.delete('g');
    history.replaceState(null, '', url);
  }
  q.addEventListener('input', apply);
  chips.forEach(c => c.addEventListener('click', () => {
    g = c.dataset.fG!;
    chips.forEach(x => { x.setAttribute('aria-pressed', String(x === c)); });
    apply();
  }));
  document.querySelector('[data-f-reset]')?.addEventListener('click', () => { q.value = ''; g = ''; chips[0].click(); });
  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q')!;
  if (params.get('g')) chips.find(c => c.dataset.fG === params.get('g'))?.click(); else if (q.value) apply();
  /* 两种排法 */
  const views = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  views.forEach(b => b.addEventListener('click', () => {
    views.forEach(x => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach(p => { p.hidden = p.dataset.pane !== b.dataset.view; });
    observeReveal();
  }));
</script>

<style>
  /* 一本花名册：上面一行寻人，家族用各自的印，排法两种 */
  .tools-bar { display: flex; flex-wrap: wrap; gap: 16px 30px; align-items: center; padding: 6px 0 10px; }
  .find { display: flex; align-items: center; gap: 10px; flex: 1 1 260px; max-width: 340px; padding: 6px 2px; border-bottom: 1px solid var(--ink-3); color: var(--ink-3); transition: border-color .3s; }
  .find:focus-within { border-color: var(--cinnabar); }
  .find input { flex: 1; min-width: 0; border: 0; background: none; outline: none; font: 400 16px/1.4 var(--serif); letter-spacing: .06em; color: var(--ink); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .fam { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 3px; font: 400 18px/1 var(--title); color: var(--c, var(--ink)); box-shadow: inset 0 0 0 1.5px currentColor; opacity: .7; transition: background .3s, color .3s, opacity .3s; }
  .fam:hover { opacity: 1; }
  .fam[aria-pressed="true"] { opacity: 1; color: #fff6ea; background: var(--c, var(--ink)); box-shadow: none; }
  .view { margin-left: auto; display: inline-flex; gap: 22px; }
  .view button { position: relative; padding: 6px 2px; font: 400 17px/1 var(--title); letter-spacing: .2em; color: var(--ink-3); transition: color .3s; }
  .view button::after { content: ''; position: absolute; right: -9px; top: 0; width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid var(--cinnabar); opacity: 0; transition: opacity .3s; }
  .view button.on { color: var(--ink); }
  .view button.on::after { opacity: 1; }
  .count { margin: 12px 0 0; font: 400 16px/1 var(--title); letter-spacing: .2em; color: var(--ink-3); }

  .grp { padding-top: 54px; }
  .grp-head { display: flex; align-items: center; gap: 18px; padding-bottom: 16px; margin-bottom: 20px; border-bottom: 1px solid var(--line); }
  .grp-head h2 { font: 400 32px/1.1 var(--title); letter-spacing: .14em; }
  .grp-hint { margin-top: 8px; font-size: 14px; color: var(--ink-3); }
  .grp-n { margin-left: auto; font: 400 17px/1 var(--title); letter-spacing: .2em; color: var(--gc); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(236px, 1fr)); gap: 10px 14px; }
  /* 一张名帖：左边画像或姓氏，右边名字、身份和出场的墨迹 */
  .pc a { position: relative; display: flex; gap: 14px; align-items: center; height: 100%; padding: 12px 14px 12px 12px; border: 1px solid transparent; transition: background .3s, border-color .3s, box-shadow .3s; }
  .pc a:hover { background: var(--card); border-color: var(--line); box-shadow: 0 14px 26px -22px rgb(40 26 10 / .55); }
  .thumb { width: 48px; height: 64px; flex: none; object-fit: cover; box-shadow: 0 0 0 1px var(--line-2), 0 0 0 3px var(--card), 0 0 0 4px var(--line); }
  .name-thumb { display: grid; place-items: center; font: 400 28px/1 var(--title); color: var(--gc); background: color-mix(in srgb, var(--gc) 9%, var(--card)); }
  .t-s .name-thumb { font-size: 23px; opacity: .85; }
  .pc-main { display: grid; gap: 3px; min-width: 0; }
  .pc-name { font: 400 20px/1.2 var(--title); letter-spacing: .06em; width: fit-content; }
  .t-c .pc-name { font-size: 22px; }
  .pc-title { font: 400 13px/1.5 var(--serif); color: var(--ink-3); }
  .pc-meta { display: flex; align-items: center; gap: 8px; font: 400 12px/1 var(--serif); color: var(--ink-3); margin-top: 4px; }
  .pc-meta :global(.spark) { width: 92px; height: 14px; }
  .pc-book { position: absolute; top: 10px; right: 10px; font: 400 13px/1 var(--title); color: var(--cinnabar); box-shadow: inset 0 0 0 1px currentColor; padding: 4px 3px; writing-mode: vertical-rl; letter-spacing: .1em; }
  .empty { padding: 80px 0; text-align: center; font: 400 17px/1 var(--title); letter-spacing: .2em; color: var(--ink-3); }
  .empty .link { color: var(--cinnabar); margin-left: 10px; }

  .rank { list-style: none; margin: 30px 0 0; padding: 0; display: grid; gap: 4px; }
  .rank li { display: grid; grid-template-columns: 3.2em 6.5em minmax(0, 1fr) 7em; align-items: center; gap: 16px; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .r-n { font: 400 16px/1 var(--title); color: var(--ink-3); text-align: right; letter-spacing: .06em; }
  .r-name { font: 400 19px/1 var(--title); letter-spacing: .06em; }
  .r-name:hover { color: var(--cinnabar); }
  .r-bar { height: 3px; position: relative; }
  .r-bar i { position: absolute; inset: 0 auto 0 0; width: var(--w); background: var(--gc); opacity: .75; transform-origin: left; }
  .rank li.in .r-bar i { animation: grow 1.1s var(--ease-ink) both; animation-delay: var(--d); }
  @keyframes grow { from { transform: scaleX(0); } }
  .r-v { font: 400 14px/1 var(--title); color: var(--ink-2); text-align: right; letter-spacing: .04em; }
  @media (max-width: 640px) {
    .view { margin-left: 0; }
    .chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter); }
    .grid { grid-template-columns: 1fr 1fr; gap: 6px; }
    .pc a { flex-direction: column; align-items: flex-start; gap: 8px; padding: 10px; }
    .pc-meta :global(.spark) { width: 72px; }
    .rank li { grid-template-columns: 2.4em 4.6em minmax(0, 1fr) 6em; gap: 8px; }
  }
</style>
