---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import { PEOPLE, EDGES, TOTAL_CHARS, TOTAL_NOTES, cn } from '../lib/data.ts';
import PageHead from '../components/PageHead.astro';
import { EVENTS } from '../data/events.ts';
import { GARDEN } from '../data/garden.ts';

const wan = (n: number) => Math.round(n / 10000);
const ITEMS = [
  { k: '一', h: '底本', p: [
    `前八十回用《脂砚斋重评石头记》，取自维基文库的汇校本，带着各本批语；后四十回用程甲本。全书共约${cn(wan(TOTAL_CHARS))}万字，统一转成简体。`,
    '回目标题前八十回取脂本，下面附人民文学出版社通行本的回目对照。各本异文不一一列出。'
  ] },
  { k: '二', h: '批语', p: [
    `原文里收了${cn(TOTAL_NOTES)}条批语，按出处标为甲戌、庚辰、己卯、蒙府、戚序等本，按位置分侧批、夹批、眉批和回前回后总批。阅读页正文上方可以切换显示方式。`,
    '这些批语习惯上统称脂批，批者却不止脂砚斋一人。末尾署了名的，除脂砚斋外还有畸笏叟、梅溪、松斋、绮园、立松轩，站里在出处后面注出批者；没有署名的多半说不清出自谁手，只标本子。蒙府、戚序等本的批语大多是后来的人加的，字色淡一些。',
    '批语出自不同时期、不同的人，彼此也有出入。本站引用时注明本子和批者，不替它们裁断。'
  ] },
  { k: '三', h: '前八十回与续书', p: [
    '前八十回是曹雪芹原著，后四十回通常认为是续书。站里凡涉及结局，分三层写：前八十回已经写到的，判词、伏笔和批语透露的原意，续书的写法。',
    '续书的情节都标了“续书”，统计图也单独分区。人物提及总数、同段提及等统计，只算前八十回；逐回图另列后四十回。'
  ] },
  { k: '四', h: '人物与关系', p: [
    `人物谱收${cn(PEOPLE.length)}人，关系${cn(EDGES.length)}条，分血亲、婚配、姻亲族亲、情缘、前世神缘、主仆、交游师友、恩怨八类。家族归属按书中所在的府第和娘家划分。`,
    '提及次数按人名及其常用称呼在正文里出现的次数算，“二爷”“姑娘”这类泛称不算。转述和追忆也会提到人名，因此提及范围不能当作实际在场范围。同段提及统计两个人名在同一段正文中出现的段数。'
  ] },
  { k: '五', h: '图', p: [
    `大观园的${cn(GARDEN.length)}处院落景致按原文的近邻、行路和临水关系意绘，具体距离与未明写的方位作画面安排。点选地点可查对应原文。贾府世系依第二回冷子兴的说法和各回出现的辈分排定。`,
    '情缘信物与园景插画由 AI 辅助绘制，再按原文描述校订。玉与金锁的铭文据第八回，画中篆意字形、器形与比例为意绘，不作为古代器物的精确复原。',
    '本轮更新的二十一位人物画像根据前八十回的外貌、衣饰与性情描写设计，由 AI 辅助绘制；巧姐、惜春保留原图。原文未写明的五官、纹样和配色作适度补画。判词、曲子照第五回原文。',
    '首页的大观园全景出自清代孙温绘《红楼梦》画册，已进入公有领域。开卷四轴是站长另画的意象插画，不对应某一回的场面。标题、引文和批语用齐伋体，字形取自明代闵齐伋刻本；正文用思源宋体；题签的笔顺来自 Make Me a Hanzi。'
  ] },
  { k: '六', h: '防剧透', p: [
    '人物页的结局和判词解说默认折起。设置已读回次后，超出进度的经历、事件与关系说明会先收起；无法确定揭示回次的内容需要主动展开。搜索默认只查已读范围，可以自行选择包含未读回目。',
    '查资料和接着读分别处理。搜索、批语或人物初见的跳转不会改写续读位置；选择“从这里接着读”后才记录阅读位置。“读完本回”会推进已开启的防剧透进度。记录只存在自己的浏览器里。'
  ] },
  { k: '七', h: '源码', p: [
    '本站源码在 GitHub 公开，MIT 许可。原文来自维基文库，依其许可使用。发现错误欢迎提 issue。'
  ] }
];
const SRCS: [string, string][] = [
  ['甲戌', '甲戌本，存十六回，批语最早'], ['己卯', '己卯本，存四十一回又两个半回'], ['庚辰', '庚辰本，存七十八回，批语最多'],
  ['蒙府', '蒙古王府本，多回前回后总批'], ['戚序', '戚蓼生序本'], ['靖藏', '靖应鹍藏本，原书已佚，只剩抄出的批语'],
  ['梦稿', '杨继振藏本，又称梦稿本'], ['列藏', '列宁格勒藏本，今藏圣彼得堡'], ['甲辰', '梦觉主人序本'], ['舒序', '舒元炜序本']
];
const KEYS = [['/', '打开搜索'], ['Ctrl K', '打开搜索'], ['Esc', '关闭弹窗和菜单'], ['←　→', '阅读页翻到上一回、下一回']];
---
<Base title="凡例" description="本站的底本、批语、续书处理、人物统计口径和图的说明。" section="about">
  <div class="wrap narrow">
    <PageHead title="凡例" slip="凡例" quote="假作真时真亦假｜无为有处有还无" from="第一回　太虚幻境" />

    <ol class="fl">
      {ITEMS.map((it, i) => (
        <li class="reveal" style={`--d:${i * 40}ms`}>
          <span class="fl-k brush">{it.k}</span>
          <div>
            <h2>{it.h}</h2>
            {it.p.map(t => <p>{t}</p>)}
          </div>
        </li>
      ))}
    </ol>

    <section class="srcs reveal">
      <h2>脂本简称</h2>
      <dl>{SRCS.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </section>

    <section class="srcs reveal">
      <h2>快捷键</h2>
      <dl>{KEYS.map(([k, v]) => <div><dt><kbd>{k}</kbd></dt><dd>{v}</dd></div>)}</dl>
    </section>

    <footer class="colophon reveal">
      <Seal text="红楼" size={44} />
      <p class="kai">满纸荒唐言，一把辛酸泪。<br>都云作者痴，谁解其中味？</p>
      <a class="link" href="https://github.com/TheWiseWolfHolo/hongloumeng-graph">github.com/TheWiseWolfHolo/hongloumeng-graph</a>
    </footer>
  </div>
</Base>

<style>
  .narrow { max-width: 920px; }
  .fl { list-style: none; margin: 40px 0 0; padding: 0; }
  .fl li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 24px; padding: 26px 0; border-top: 1px solid var(--line); }
  .fl-k { font: 400 34px/1 var(--title); color: var(--cinnabar); text-align: center; }
  .fl h2 { font: 400 22px/1.3 var(--title); letter-spacing: .16em; margin-bottom: 10px; }
  .fl p { font-size: 16px; line-height: 2; color: var(--ink-2); }
  .fl p + p { margin-top: 6px; }
  .srcs { margin-top: 30px; padding: 24px 28px; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); }
  .srcs h2 { font: 400 18px/1 var(--title); letter-spacing: .24em; color: var(--ink-2); margin-bottom: 16px; }
  .srcs dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px 24px; margin: 0; }
  .srcs dl div { display: flex; gap: 12px; align-items: baseline; }
  .srcs dt { font: 400 17px var(--title); color: var(--cinnabar); min-width: 3em; }
  .srcs dd { margin: 0; font-size: 14px; color: var(--ink-2); }
  kbd { font: 400 12px var(--title); padding: 3px 7px; border: 1px solid var(--line-2); border-bottom-width: 2px; border-radius: 4px; color: var(--ink); background: var(--paper); }
  .colophon { display: grid; justify-items: center; gap: 16px; margin: 70px 0 30px; text-align: center; }
  .colophon p { font-size: 19px; line-height: 2; letter-spacing: .14em; }
  .colophon .link { font: 400 13px var(--title); color: var(--ink-3); }
  @media (max-width: 600px) { .fl li { grid-template-columns: 40px minmax(0, 1fr); gap: 14px; } .fl-k { font-size: 26px; } }
</style>
