---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { HOUSES, HOUSE_LINKS, GUANFU } from '../data/families.ts';

type Key = keyof typeof HOUSES;
const ORDER: Key[] = ['jia', 'shi', 'wang', 'xue'];
const KEYS = Object.keys(HOUSES) as Key[];
const NUM = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一', '十二', '十三', '十四', '十五', '十六', '十七', '十八', '十九', '二十'];
const half = (k: Key) => (k === 'jia' ? 50 : 34);
/* 从 a 印的边上出发，到 b 印的边上为止 */
function edge(a: readonly number[], b: readonly number[], k: Key) {
  const dx = b[0] - a[0], dy = b[1] - a[1], h = half(k) + 6;
  const s = Math.min(h / Math.abs(dx || 1e-6), h / Math.abs(dy || 1e-6));
  return [a[0] + dx * s, a[1] + dy * s];
}
const links = HOUSE_LINKS.map((l, i) => {
  const A = HOUSES[l.a as Key].pos, B = HOUSES[l.b as Key].pos;
  const p = edge(A, B, l.a as Key), q = edge(B, A, l.b as Key);
  const mx = (p[0] + q[0]) / 2, my = (p[1] + q[1]) / 2, dx = q[0] - p[0], dy = q[1] - p[1], d = Math.hypot(dx, dy);
  const bend = l.a === 'wang' && l.b === 'xue' ? -44 : 22;
  const c = [mx - (dy / d) * bend, my + (dx / d) * bend];
  const tx = q[0] - c[0], ty = q[1] - c[1], tl = Math.hypot(tx, ty), ux = tx / tl, uy = ty / tl;
  const arrow = `M${q[0]} ${q[1]}L${q[0] - ux * 11 - uy * 5} ${q[1] - uy * 11 + ux * 5}L${q[0] - ux * 11 + uy * 5} ${q[1] - uy * 11 - ux * 5}Z`;
  const lx = .25 * p[0] + .5 * c[0] + .25 * q[0], ly = .25 * p[1] + .5 * c[1] + .25 * q[1];
  return { ...l, i, path: `M${p}Q${c} ${q}`, arrow, lx, ly: ly + 5 };
});
---
<Base title="四大家族" description="《红楼梦》第四回护官符上的贾史王薛四大家族，以及林家：各家来历、房分，谁嫁进了谁家。" section="graph" sub="families">
  <div class="wrap">
    <header class="page-head">
      <div>
        <span class="eyebrow ink-in">关系 · 叁</span>
        <h1 class="ink-in" style="--d:.1s">四大家族</h1>
      </div>
      <p class="lede ink-in" style="--d:.25s">第四回贾雨村到应天府上任，门子递给他一张“护官符”，上面四句俗谚，说的就是贾、史、王、薛四家。四家“皆连络有亲，一损皆损，一荣皆荣”。林家不在符上，靠贾敏一门亲事连在一起。</p>
    </header>

    <div class="fam" data-fam>
      <aside class="guan" aria-label="护官符">
        <div class="guan-t"><b>护官符</b><small>第四回</small></div>
        {ORDER.map((k, i) => (
          <button type="button" class="guan-col" data-h={k} style={`--c:var(--g-${HOUSES[k].grp})`}>
            <span class="guan-m"><i class="guan-seal">{HOUSES[k].name}</i>{GUANFU[i]}</span>
            <span class="guan-n">{HOUSES[k].note}</span>
          </button>
        ))}
        <p class="guan-end">门子从顺袋中取出一张抄写的护官符来，递与雨村</p>
      </aside>

      <div class="map">
        <svg viewBox="0 0 500 420" role="img" aria-label="五家之间的婚姻往来">
          <defs>
            <filter id="seal-rough"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="2.2" /></filter>
          </defs>
          {links.map(l => (
            <g class:list={['fm-l', { late: l.late }]} data-l={l.i} tabindex="0" role="button" aria-label={`${l.who.join('、')}从${HOUSES[l.a as Key].name}家嫁到${HOUSES[l.b as Key].name}家`}>
              <path class="fm-hit" d={l.path} />
              <path class="fm-link" d={l.path} />
              <path class="fm-arrow" d={l.arrow} />
              <text class="fm-lab" x={l.lx.toFixed(1)} y={l.ly.toFixed(1)}>{l.who.join('、')}{l.late ? '（八十回后）' : ''}</text>
            </g>
          ))}
          {KEYS.map(k => {
            const h = HOUSES[k], r = half(k), [x, y] = h.pos;
            return (
              <g class:list={['fm-node', { zhu: k === 'lin' }]} data-h={k} tabindex="0" role="button" aria-label={`${h.name}家`} style={`--c:var(--g-${h.grp})`}>
                <rect class="ring" x={x - r - 6} y={y - r - 6} width={2 * r + 12} height={2 * r + 12} rx="8" />
                <rect class="body" x={x - r} y={y - r} width={2 * r} height={2 * r} rx="5" filter="url(#seal-rough)" />
                <rect class="inner" x={x - r + 5} y={y - r + 5} width={2 * r - 10} height={2 * r - 10} rx="3" />
                <text class="big" x={x} y={y + r * .36} font-size={r * 1.2}>{h.name}</text>
                <text class="sm" x={x} y={y < 150 ? y - r - 15 : y + r + 24}>{h.label}</text>
              </g>
            );
          })}
        </svg>
        <p class="map-hint muted small">白文印是护官符上的四家，朱文印是林家。箭头从娘家指向夫家，点印或线看详情。</p>
      </div>

      <div class="panels">
        {KEYS.map((k, idx) => {
          const h = HOUSES[k];
          const i = ORDER.indexOf(k);
          const fang = 'fang' in h && h.fang;
          return (
            <section class="panel" data-panel={`h:${k}`} hidden={k !== 'jia'} style={`--c:var(--g-${h.grp})`}>
              <div class="pn-head">
                <span class:list={['pn-seal', { zhu: k === 'lin' }]}>{h.name}</span>
                <div><h2>{h.name}家 · {h.label}</h2><p class="pn-k">{i < 0 ? '不在护官符上' : `护官符第${NUM[i]}句`}</p></div>
              </div>
              <dl>
                <dt>出身</dt><dd>{h.guan}</dd>
                <dt>在书中</dt><dd>{h.now}</dd>
                <dt>房分</dt>
                <dd>
                  {fang ? (
                    <>
                      <span class="fang">{Array.from({ length: fang[0] }, (_, j) => <i class:list={{ du: j < fang[1] }} />)}</span>
                      <span class="fang-t">{fang[1] ? `共${NUM[fang[0] - 1]}房，在京${NUM[fang[1] - 1]}房，原籍${NUM[fang[0] - fang[1] - 1]}房` : `共${NUM[fang[0] - 1]}房`}</span>
                    </>
                  ) : 'few' in h ? h.few : ''}
                </dd>
              </dl>
              <div class="mem">{h.members.map(id => <PersonLink id={id} />)}</div>
            </section>
          );
        })}
        {links.map(l => {
          const A = HOUSES[l.a as Key], B = HOUSES[l.b as Key];
          return (
            <section class="panel" data-panel={`l:${l.i}`} hidden style={`--c:var(--g-${B.grp})`}>
              <div class="pn-head">
                <span class:list={['pn-seal', { zhu: l.a === 'lin' }]}>{A.name}</span><span class="pn-to">嫁入</span><span class:list={['pn-seal', { zhu: l.b === 'lin' }]}>{B.name}</span>
                <div><h2>{l.text}</h2><p class="pn-k">{A.name}家的女儿嫁进{B.name}家</p></div>
              </div>
              <p class="pn-p">{l.note}</p>
              <div class="mem">{[...new Set([...l.who, ...A.members, ...B.members])].map(id => <PersonLink id={id} />)}</div>
            </section>
          );
        })}
      </div>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-fam]')!;
  const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
  let sel = 'h:jia';
  function render() {
    panels.forEach(p => { p.hidden = p.dataset.panel !== sel; });
    root.querySelectorAll<SVGElement>('.fm-node').forEach(g => g.classList.toggle('on', sel === `h:${g.dataset.h}`));
    root.querySelectorAll<SVGElement>('.fm-l').forEach(g => g.classList.toggle('on', sel === `l:${g.dataset.l}`));
    root.querySelectorAll<HTMLElement>('.guan-col').forEach(c => c.classList.toggle('on', sel === `h:${c.dataset.h}`));
  }
  root.addEventListener('click', e => {
    const t = e.target as Element;
    const h = t.closest<HTMLElement | SVGElement>('[data-h]'), l = t.closest<SVGElement>('[data-l]');
    if (h) sel = `h:${h.dataset.h}`;
    else if (l) sel = `l:${l.dataset.l}`;
    else return;
    render();
  });
  root.addEventListener('keydown', e => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const t = e.target as Element;
    if (t.matches('.fm-node, .fm-l')) { e.preventDefault(); t.dispatchEvent(new MouseEvent('click', { bubbles: true })); }
  });
  render();
</script>

<style>
  .fam { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 360px); gap: clamp(20px, 3vw, 44px); align-items: start; margin-top: 36px; }
  .guan { display: flex; flex-direction: row-reverse; gap: 6px; padding: 20px 16px; background: #f6efdf; border: 1px solid #d8c9a6; box-shadow: 0 2px 0 #e3d6b8, var(--shadow); color: #3a2e22; }
  :global(:root[data-theme="dark"]) .guan { background: #26221c; border-color: #4a4235; color: #d8ccb4; box-shadow: none; }
  .guan-t { writing-mode: vertical-rl; display: flex; align-items: center; gap: 10px; padding-left: 8px; border-left: 1px solid currentColor; }
  .guan-t b { font: 400 26px/1 var(--brush); letter-spacing: .3em; color: var(--cinnabar); }
  .guan-t small { font: 500 11px/1 var(--sans); letter-spacing: .3em; opacity: .7; }
  .guan-col { writing-mode: vertical-rl; display: flex; gap: 6px; padding: 6px 4px; text-align: start; border-radius: 4px; color: inherit; transition: background .2s; }
  .guan-col:hover { background: color-mix(in srgb, var(--c) 10%, transparent); }
  .guan-col.on { background: color-mix(in srgb, var(--c) 14%, transparent); }
  .guan-m { font: 400 20px/1.4 var(--kai); letter-spacing: .14em; }
  .guan-seal { display: inline-grid; place-items: center; width: 1.3em; height: 1.3em; margin-bottom: .4em; font: normal 400 .9em/1 var(--brush); color: #fff; background: var(--c); border-radius: 3px; writing-mode: horizontal-tb; }
  .guan-col.on .guan-m { text-decoration: underline wavy color-mix(in srgb, var(--cinnabar) 70%, transparent) 1.5px; text-underline-offset: 6px; }
  .guan-n { font: 13px/1.6 var(--kai); opacity: .65; max-block-size: 16em; }
  .guan-end { writing-mode: vertical-rl; font: 12px/1.6 var(--kai); opacity: .55; padding-right: 8px; border-right: 1px solid currentColor; }

  .map svg { width: 100%; height: auto; overflow: visible; }
  .map-hint { margin-top: 6px; text-align: center; }
  .fm-node { cursor: pointer; outline: none; }
  .fm-node .ring { fill: none; stroke: var(--c); stroke-width: 1.4; opacity: 0; transition: opacity .25s; }
  .fm-node.on .ring, .fm-node:focus-visible .ring { opacity: .6; }
  .fm-node .body { fill: var(--c); transition: transform .3s var(--ease); transform-box: fill-box; transform-origin: center; }
  .fm-node:hover .body { transform: scale(1.04); }
  .fm-node .inner { fill: none; stroke: #fff6ea; stroke-width: 1.2; opacity: .7; }
  .fm-node .big { font-family: var(--brush); fill: #fff6ea; text-anchor: middle; }
  .fm-node .sm { font: 600 12px var(--sans); letter-spacing: .2em; fill: var(--ink-2); text-anchor: middle; }
  /* 林家用朱文印：印面留白，字和边框是颜色 */
  .fm-node.zhu .body { fill: var(--card); stroke: var(--c); stroke-width: 3; }
  .fm-node.zhu .inner { stroke: var(--c); }
  .fm-node.zhu .big { fill: var(--c); }
  .fm-l { cursor: pointer; outline: none; }
  .fm-hit { fill: none; stroke: transparent; stroke-width: 18; }
  .fm-link { fill: none; stroke: var(--ink-3); stroke-width: 1.6; transition: stroke .2s, stroke-width .2s; }
  .fm-arrow { fill: var(--ink-3); transition: fill .2s; }
  .fm-l.late .fm-link { stroke-dasharray: 5 4; }
  .fm-lab { font: 13px var(--kai); fill: var(--ink-2); text-anchor: middle; paint-order: stroke; stroke: var(--paper); stroke-width: 4px; }
  .fm-l:hover .fm-link, .fm-l.on .fm-link { stroke: var(--cinnabar); stroke-width: 2.4; }
  .fm-l:hover .fm-arrow, .fm-l.on .fm-arrow { fill: var(--cinnabar); }
  .fm-l.on .fm-lab { fill: var(--cinnabar); font-weight: 700; }

  .panel { padding: 24px; background: var(--card); border: 1px solid var(--line); border-top: 3px solid var(--c); border-radius: 6px; animation: ink-in .5s var(--ease-ink); }
  .pn-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-bottom: 16px; }
  .pn-head h2 { font: 400 26px/1.2 var(--brush); }
  .pn-k { font: 500 12px/1.6 var(--sans); color: var(--ink-3); letter-spacing: .1em; }
  .pn-seal { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 5px; background: var(--c); color: #fff6ea; font: 400 26px/1 var(--brush); }
  .pn-seal.zhu { background: var(--card); color: var(--c); box-shadow: inset 0 0 0 2.5px var(--c); }
  .pn-to { font: 600 12px/1 var(--sans); color: var(--ink-3); }
  .panel dl { display: grid; grid-template-columns: auto 1fr; gap: 10px 14px; font-size: 15px; line-height: 1.8; }
  .panel dt { font: 700 11.5px/1.9 var(--sans); letter-spacing: .16em; color: var(--ink-3); white-space: nowrap; }
  .panel dd { margin: 0; }
  .fang { display: flex; flex-wrap: wrap; gap: 3px; margin-bottom: 6px; max-width: 200px; }
  .fang i { width: 12px; height: 12px; border-radius: 2px; border: 1px solid var(--c); }
  .fang i.du { background: var(--c); }
  .fang-t { font: 500 12.5px/1.6 var(--sans); color: var(--ink-3); }
  .pn-p { font-size: 15.5px; line-height: 1.9; }
  .mem { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 16px; font-size: 15px; }
  @media (max-width: 1100px) {
    .fam { grid-template-columns: auto minmax(0, 1fr); }
    .panels { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .fam { grid-template-columns: 1fr; }
    .guan { overflow-x: auto; justify-content: flex-start; }
  }
</style>
