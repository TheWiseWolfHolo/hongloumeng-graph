---
/* 大观园。一幅园图，五种看法：
   游览，点院落景致看住户、景致与旧事；
   题对额，随第十七回贾政一行走一遍，每到一处看宝玉题的匾和联；
   岁时，春夏秋冬各有几件事落在园里，图也换了季节的颜色；
   盛衰，从第十七回落成拉到第一百一十二回，看院子一处处空下去，园子褪了颜色；
   寻人，挑一个人，看她在园里到过哪几处。 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getImage } from 'astro:assets';
import gardenAtlas from '../assets/paintings/garden-atlas.png';
import gardenSummer from '../assets/paintings/garden-summer.png';
import gardenAutumn from '../assets/paintings/garden-autumn.png';
import gardenWinter from '../assets/paintings/garden-winter.png';
import { PEOPLE, cn } from '../lib/data.ts';
import { GARDEN, GARDEN_TOUR, SEASONS, LIFE, VACATE } from '../data/garden.ts';
import { EVENTS } from '../data/events.ts';
import '../styles/garden.css';

const gardenArtworks = await Promise.all([gardenAtlas, gardenSummer, gardenAutumn, gardenWinter].map(src => getImage({ src, width: src.width, format: 'webp', quality: 88 })));
const seasonalArt = Object.fromEntries(['春', '夏', '秋', '冬'].map((season, i) => [season, gardenArtworks[i].src]));

const groups = Object.fromEntries(PEOPLE.map(p => [p.id, p.group]));
/* 园里出现过的人，按人物谱的次序 */
const inGarden = new Set(GARDEN.flatMap(b => b.who));
const walkers = PEOPLE.filter(p => inGarden.has(p.id)).map(p => p.id);
const evByTitle = Object.fromEntries(EVENTS.map(e => [e.t, e.c]));
const data = {
  artwork: seasonalArt,
  places: GARDEN.map(b => ({ id: b.id, kind: b.kind, name: b.name, seal: b.seal ?? '', alias: b.alias, who: b.who, scene: b.scene, note: b.note, basis: b.basis ?? [], positionNote: b.positionNote ?? '', ev: b.ev.map(t => { const chapters = evByTitle[t]; return [t, chapters[0], chapters[0] > 80 ? 1 : 0, chapters.at(-1)!]; }) })),
  tour: GARDEN_TOUR.map(t => ({ name: t.name, site: t.site ?? '', text: t.text, plq: t.plq ?? '', dui: t.dui ?? null })),
  seasons: SEASONS,
  life: LIFE,
  vacate: VACATE,
  groups,
  cn: Object.fromEntries(Array.from({ length: 120 }, (_, i) => [i + 1, cn(i + 1)]))
};
const MODES = [['you', '遊覽'], ['ti', '題對額'], ['shi', '歲時'], ['sheng', '盛衰'], ['xun', '尋人']];
---
<Base title="大观园" description="为元春省亲而建的园子，后来成了宝玉和姐妹们的住处。一幅园图，可以游览各处院落，随贾政一行题对额，看园中四时，看园子从落成到荒废，也可以挑一个人看她到过哪里。" section="garden">
  <div class="wrap">
    <PageHead title="大观园" slip="大觀園" quote="天上人间诸景备｜芳园应锡大观名" from="第十八回　元春题咏" />
  </div>

  <div class="yuan">
    <div class="modes" role="tablist" aria-label="看园子的法子">
      {MODES.map(([k, t], i) => <button type="button" role="tab" class="mode" data-mode={k} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t}</button>)}
    </div>

    <div class="ctl" data-ctl="shi" hidden>
      {['春', '夏', '秋', '冬'].map((s, i) => <button type="button" class="ji" data-ji={s} aria-pressed={i === 0 ? 'true' : 'false'}>{s}</button>)}
    </div>
    <div class="ctl sheng" data-ctl="sheng" hidden>
      <button type="button" class="play" data-play aria-label="让回数自己往下走">流年</button>
      <div class="track">
        <input type="range" min="17" max="112" value="17" step="1" data-hui aria-label="回数" aria-valuetext="第十七回">
        <div class="ticks" aria-hidden="true">
          {LIFE.map(l => <span style={`--x:${(l.ch - 17) / 95}`} class:list={{ late: l.ch > 80 }}></span>)}
          <i class="eighty" style={`--x:${(80 - 17) / 95}`}></i>
        </div>
      </div>
      <output data-hui-out>第十七回</output>
    </div>
    <div class="ctl xun" data-ctl="xun" hidden>
      {walkers.map(id => <button type="button" class="ren" data-ren={id} style={`--pc:var(--g-${groups[id]})`} aria-pressed="false">{id}</button>)}
    </div>

    <div class="stage">
      <div class="map-sheet">
        <div class="map-tools">
          <span>大觀園意繪</span>
          <div role="group" aria-label="园图大小">
            <button type="button" data-zoom="out" aria-label="缩小园图" disabled>缩小</button>
            <button type="button" data-zoom="reset">全图</button>
            <button type="button" data-zoom="in" aria-label="放大园图">放大</button>
          </div>
        </div>
        <div class="gmap" data-map>
          <div class="gscroll"><svg id="gardenSvg" data-artwork={seasonalArt['春']} viewBox="0 0 1200 790" role="group" aria-label="大观园意绘，地点可以点选"></svg></div>
          <canvas class="snow" data-snow aria-hidden="true"></canvas>
          <div class="mist" aria-hidden="true"></div>
        </div>
        <details class="map-basis">
          <summary>園圖小記</summary>
          <p>本图据原文中的近邻、行路与临水关系安排院落，距离和全园方位为意绘。各处所据回文，可在点选后的“原文依据”中查阅。</p>
          <p>沁芳亭与沁芳闸分列。原文对水路进出的叙述有不同语境，图中不标单向流向。园景为据文意创作的插画；旅顺博物馆所藏孙温、孙允谟《红楼梦》画册作为鸟瞰构图的阅读参考。</p>
          <a href="https://lvshunmuseum.cn/mobile/service_Detail.aspx?ID=325" target="_blank" rel="noreferrer">旅顺博物馆藏画说明</a>
        </details>
      </div>
      <aside class="jian" data-jian aria-label="园中详情">
        <button type="button" class="jian-close" data-jian-close>收起详情</button>
        <div data-jian-content aria-live="polite"></div>
      </aside>
    </div>
  </div>
  <script is:inline type="application/json" id="garden-people" set:html={JSON.stringify(groups)} />
  <script is:inline type="application/json" id="garden-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import Garden from '../client/garden-map.js';
  import { createGardenSnow } from '../client/garden-snow.ts';
  import { applyGuard, progress } from '../client/site.ts';

  type Place = { id: string; kind: string; name: string; seal: string; alias: string; who: string[]; scene: string; note: string; basis: { ch: number; paragraph: number; quote: string; note?: string }[]; positionNote: string; ev: [string, number, number, number][] };
  const D: {
    artwork: Record<string, string>;
    places: Place[]; tour: { name: string; site: string; text: string; plq: string; dui: [string, string] | null }[];
    seasons: { s: string; ch: number; at: string; t: string; d: string }[];
    life: { ch: number; t: string; d: string; at?: string }[];
    vacate: Record<string, [number, number]>; groups: Record<string, string>; cn: Record<string, string>;
  } = JSON.parse(document.getElementById('garden-data')!.textContent!);
  const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const hui = (n: number) => `第${D.cn[n]}回`;
  const place = (id: string) => D.places.find(p => p.id === id)!;
  const person = (id: string) => D.groups[id] ? `<a class="person" href="/people/${encodeURIComponent(id)}/" data-peek style="--pc:var(--g-${D.groups[id]})">${esc(id)}</a>` : `<span>${esc(id)}</span>`;
  const vert = (s: string, cls: string) => `<span class="${cls}">${[...s].map(c => `<i>${esc(c)}</i>`).join('')}</span>`;
  const detail = document.querySelector<HTMLElement>('[data-jian]')!;
  const jian = document.querySelector<HTMLElement>('[data-jian-content]')!;
  const map = document.querySelector<HTMLElement>('[data-map]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const plot = document.querySelector<SVGSVGElement>('#gardenSvg')!;
  const scroller = map.querySelector<HTMLElement>('.gscroll')!;
  const zoomIn = document.querySelector<HTMLButtonElement>('[data-zoom="in"]')!;
  const zoomOut = document.querySelector<HTMLButtonElement>('[data-zoom="out"]')!;
  let zoom = 1;
  const sizeMap = () => { plot.style.width = zoom === 1 ? '100%' : `${Math.max(760, scroller.clientWidth) * zoom}px`; };
  new ResizeObserver(sizeMap).observe(scroller);
  document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach(button => button.addEventListener('click', () => {
    zoom = button.dataset.zoom === 'reset' ? 1 : Math.max(1, Math.min(2, zoom + (button.dataset.zoom === 'in' ? .25 : -.25)));
    sizeMap();
    zoomOut.disabled = zoom === 1;
    zoomIn.disabled = zoom === 2;
    if (zoom === 1) scroller.scrollLeft = 0;
    else Garden.center(cur);
  }));
  /* 笺换内容时先淡出再淡入，不在原地跳 */
  let swapT = 0;
  const write = (html: string) => {
    clearTimeout(swapT);
    detail.classList.add('out');
    swapT = window.setTimeout(() => { jian.innerHTML = html; detail.scrollTop = 0; applyGuard(jian); detail.classList.remove('out'); }, reduced ? 0 : 160);
  };
  const guard = (ch: number, html: string) => `<div class="spoil" data-ch="${ch}"><div class="spoil-body">${html}</div></div>`;
  function nearby(id?: string) {
    if (id) Garden.center(id);
    if (!matchMedia('(max-width: 1300px)').matches) return;
    detail.classList.add('is-open');
    if (id) requestAnimationFrame(() => {
      const selected = [...map.querySelectorAll<SVGGElement>('[data-id]')].find(g => g.dataset.id === id)!;
      const r = selected.getBoundingClientRect();
      const top = document.querySelector('[data-header]')!.getBoundingClientRect().bottom;
      scrollTo({ top: scrollY + r.top + r.height / 2 - (top + detail.getBoundingClientRect().top) / 2, behavior: reduced ? 'auto' : 'smooth' });
    });
  }
  const closeDetail = () => {
    detail.classList.remove('is-open');
    const selected = map.querySelector<SVGElement>('[data-id].on');
    if (selected) selected.focus({ preventScroll: true });
  };
  document.querySelector('[data-jian-close]')!.addEventListener('click', closeDetail);
  addEventListener('keydown', e => { if (e.key === 'Escape' && detail.classList.contains('is-open')) closeDetail(); });

  let mode = 'you';
  let cur = 'yhy';

  /* ---------- 游览 ---------- */
  function showPlace(id: string) {
    cur = id;
    Garden.mark(id);
    const b = place(id);
    const seasons = D.seasons.filter(s => s.at === id);
    const life = D.life.filter(l => l.at === id);
    write(`
      <header class="jh">
        ${vert(b.name, 'bian')}
        <div class="jh-r">
          <p class="kind">${b.id === 'dgl' ? '省亲正殿' : b.kind === 'home' ? '院落' : '景致'}</p>
          <p class="alias">${esc(b.alias)}</p>
          <p class="who">${b.who.map(person).join('')}</p>
        </div>
      </header>
      <section class="js"><h3>景</h3><p>${esc(b.scene)}</p></section>
      ${b.basis.length ? `<details class="source-note"><summary>原文依据</summary>${b.basis.map(s => guard(s.ch, `<blockquote>${esc(s.quote)}</blockquote>${s.note ? `<p>${esc(s.note)}</p>` : ''}<a href="/chapters/${s.ch}/?ref=garden#p${s.paragraph}">${hui(s.ch)} · 读这一段</a>`)).join('')}${b.positionNote ? `<p class="position-note">${esc(b.positionNote)}</p>` : ''}</details>` : ''}
      <section class="js"><h3>事</h3>${guard(121, `<p>${esc(b.note)}</p>`)}</section>
      ${b.ev.length ? `<section class="js"><h3>回</h3><ul class="evs">${b.ev.map(([t, n, late, revealAt]) => `<li>${guard(revealAt, `<a href="/chapters/${n}/?ref=garden"><span class="n">${hui(n)}</span><span class="t">${esc(t)}</span>${late ? '<small>续书</small>' : ''}</a>`)}</li>`).join('')}</ul></section>` : ''}
      ${seasons.length ? `<section class="js"><h3>時</h3><ul class="sea">${seasons.map(s => `<li>${guard(s.ch, `<b>${s.s}</b>${esc(s.t)}`)}</li>`).join('')}</ul></section>` : ''}
      ${life.length ? `<section class="js"><h3>變</h3><ul class="sea">${life.map(l => `<li>${guard(l.ch, `<b>${D.cn[l.ch]}</b>${esc(l.t)}`)}</li>`).join('')}</ul></section>` : ''}`);
    history.replaceState(null, '', '#' + id);
  }

  /* ---------- 题对额 ---------- */
  function showStop(i: number) {
    const st = D.tour[i], n = D.tour.length;
    const plaque = st.plq ? `<div class="men">
        ${st.dui ? vert(st.dui[1], 'lian') : ''}
        ${vert(st.plq, 'bian big')}
        ${st.dui ? vert(st.dui[0], 'lian') : ''}
      </div>` : '';
    write(`
      <p class="kind">第十七回　大观园试才题对额</p>
      <h2 class="stop">${esc(st.name)}</h2>
      <ol class="steps">${D.tour.map((s, k) => `<li class="${k < i ? 'done' : k === i ? 'cur' : ''}"><button type="button" data-step="${k}" aria-label="${esc(s.name)}" title="${esc(s.name)}"></button></li>`).join('')}</ol>
      ${plaque}
      ${guard(17, `<p class="said">${esc(st.text)}</p>`)}
      <div class="go">
        <button type="button" data-tour="prev" ${i === 0 ? 'disabled' : ''}>上一处</button>
        <button type="button" class="on" data-tour="${i === n - 1 ? 'end' : 'next'}">${i === n - 1 ? '游罢' : '下一处'}</button>
      </div>
      ${st.site ? `<button type="button" class="more" data-goto="${st.site}">看${esc(place(st.site).name)}的景致与旧事</button>` : ''}`);
  }

  /* ---------- 岁时 ---------- */
  const SEASON_LINE: Record<string, string> = { 春: '桃花帘外东风软', 夏: '一夜蝉声', 秋: '秋花惨淡秋草黄', 冬: '琉璃世界白雪红梅' };
  function showSeason(s: string) {
    map.dataset.ji = s;
    Garden.setArtwork(D.artwork[s]);
    if (s === '冬') snow.start(); else snow.stop();
    const list = D.seasons.filter(x => x.s === s);
    const visible = list.map((x, k) => ({ ...x, number: k + 1 })).filter(x => !progress() || x.ch <= progress());
    Garden.pins(visible.map(x => ({ id: x.at, n: x.number })));
    Garden.focusOn(new Set(visible.map(x => x.at)));
    Garden.mark(null);
    write(`
      <header class="season"><span class="big">${s}</span><span class="line">${esc(SEASON_LINE[s])}</span></header>
      <ol class="happen">${list.map((x, k) => `<li>${guard(x.ch, `<button type="button" data-at="${x.at}"><span class="no">${D.cn[k + 1]}</span><span class="b"><b>${esc(x.t)}</b><small>${hui(x.ch)}　${esc(place(x.at).name)}</small><span>${esc(x.d)}</span></span></button>`)}</li>`).join('')}</ol>`);
  }

  const snow = createGardenSnow(map.querySelector<HTMLCanvasElement>('[data-snow]')!, map, reduced);

  /* ---------- 盛衰 ---------- */
  const range = document.querySelector<HTMLInputElement>('[data-hui]')!;
  const out = document.querySelector<HTMLOutputElement>('[data-hui-out]')!;
  function showLife(n: number) {
    const lastRead = progress();
    range.max = String(lastRead ? Math.max(17, Math.min(112, lastRead)) : 112);
    range.disabled = !!lastRead && lastRead < 17;
    playBtn.disabled = range.disabled;
    n = Math.min(n, +range.max);
    range.value = String(n);
    if (range.disabled) {
      out.textContent = '尚未读到';
      range.setAttribute('aria-valuetext', '尚未读到第十七回');
      Garden.vacant(new Set());
      Garden.mark(null);
      map.style.setProperty('--decay', '0');
      write(guard(17, '<p class="said">第十七回起，园中的院落与人物随回目展开。</p>'));
      return;
    }
    out.textContent = hui(n);
    range.setAttribute('aria-valuetext', hui(n));
    const empty = new Set(Object.entries(D.vacate).filter(([, [a, b]]) => n < a || n > b).map(([id]) => id));
    Garden.vacant(empty);
    /* 抄检以后园子一点点褪色，到封园时只剩一层白 */
    const decay = Math.max(0, Math.min(1, (n - 73) / 39));
    map.style.setProperty('--decay', decay.toFixed(3));
    const now = [...D.life].reverse().find(l => l.ch <= n)!;
    Garden.mark(now.at ?? null);
    const homes = D.places.filter(p => p.kind === 'home' && p.id !== 'dgl');
    const homesHtml = guard(121, `<ul class="homes">${homes.map(h => `<li class="${empty.has(h.id) ? 'off' : ''}"><span>${esc(h.name)}</span><small>${empty.has(h.id) ? (n < D.vacate[h.id][0] ? '未住' : '已空') : esc(h.seal)}</small></li>`).join('')}</ul>`);
    const html = `
      <p class="kind">${hui(now.ch)}${now.ch > 80 ? '　续书' : ''}</p>
      ${guard(now.ch, `<h2 class="stop">${esc(now.t)}</h2><p class="said">${esc(now.d)}</p>`)}
      <div data-life-homes>${homesHtml}</div>`;
    if (jian.dataset.life !== String(now.ch)) { jian.dataset.life = String(now.ch); write(html); }
    else {
      const homesBox = jian.querySelector('[data-life-homes]');
      if (homesBox) { homesBox.innerHTML = homesHtml; applyGuard(homesBox); }
    }
  }
  range.addEventListener('input', () => showLife(+range.value));
  let timer = 0;
  const playBtn = document.querySelector<HTMLButtonElement>('[data-play]')!;
  const stopPlay = () => { clearInterval(timer); timer = 0; playBtn.classList.remove('on'); };
  playBtn.addEventListener('click', () => {
    if (timer) { stopPlay(); return; }
    if (+range.value >= +range.max) range.value = '17';
    playBtn.classList.add('on');
    timer = window.setInterval(() => {
      range.value = String(+range.value + 1);
      showLife(+range.value);
      if (+range.value >= +range.max) stopPlay();
    }, 260);
  });

  /* ---------- 寻人 ---------- */
  const rens = [...document.querySelectorAll<HTMLButtonElement>('[data-ren]')];
  function showPerson(id: string) {
    rens.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.ren === id)));
    const at = D.places.filter(p => p.who.includes(id));
    Garden.focusOn(new Set(at.map(p => p.id)));
    Garden.pins(at.map((p, k) => ({ id: p.id, n: k + 1 })));
    Garden.mark(null);
    write(`
      <p class="kind">人物与园中地点</p>
      <h2 class="stop">${person(id)}</h2>
      <ol class="happen">${at.map((p, k) => `<li><button type="button" data-at="${p.id}"><span class="no">${D.cn[k + 1]}</span><span class="b"><b>${esc(p.name)}</b><small>${esc(p.alias)}</small></span></button>${guard(121, `<p>${esc(p.note)}</p>`)}</li>`).join('')}</ol>`);
  }
  rens.forEach(b => b.addEventListener('click', () => showPerson(b.dataset.ren!)));

  /* ---------- 换看法 ---------- */
  const modes = [...document.querySelectorAll<HTMLButtonElement>('[data-mode]')];
  const ctls = [...document.querySelectorAll<HTMLElement>('[data-ctl]')];
  function setMode(m: string) {
    if (Garden.touring()) Garden.endTour();
    stopPlay();
    mode = m;
    modes.forEach(b => { b.setAttribute('aria-selected', String(b.dataset.mode === m)); b.tabIndex = b.dataset.mode === m ? 0 : -1; });
    ctls.forEach(c => { c.hidden = c.dataset.ctl !== m; });
    Garden.pins(null);
    Garden.focusOn(null);
    Garden.vacant(new Set());
    map.dataset.ji = '';
    if (m !== 'shi') Garden.setArtwork(D.artwork['春']);
    snow.stop();
    map.style.setProperty('--decay', '0');
    delete jian.dataset.life;
    if (m === 'you') showPlace(cur);
    if (m === 'ti') showStop(Garden.startTour());
    if (m === 'shi') showSeason(document.querySelector<HTMLElement>('[data-ji][aria-pressed="true"]')!.dataset.ji!);
    if (m === 'sheng') showLife(+range.value);
    if (m === 'xun') showPerson(rens.find(b => b.getAttribute('aria-pressed') === 'true')?.dataset.ren ?? '林黛玉');
  }
  modes.forEach(b => b.addEventListener('click', () => { setMode(b.dataset.mode!); nearby(); }));
  modes.forEach((button, index) => button.addEventListener('keydown', event => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    const next = event.key === 'Home' ? 0 : event.key === 'End' ? modes.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + modes.length) % modes.length;
    setMode(modes[next].dataset.mode!);
    modes[next].focus();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-ji]').forEach(b => b.addEventListener('click', () => {
    document.querySelectorAll('[data-ji]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    showSeason(b.dataset.ji!);
  }));

  /* 笺里的按钮 */
  jian.addEventListener('click', e => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-tour],[data-step],[data-goto],[data-at]');
    if (!t) return;
    if (t.dataset.at) { Garden.mark(t.dataset.at); nearby(t.dataset.at); return; }
    if (t.dataset.goto) { const id = t.dataset.goto; setMode('you'); showPlace(id); nearby(id); return; }
    if (t.dataset.step) { showStop(Garden.tourGo(+t.dataset.step)); return; }
    const a = t.dataset.tour;
    if (a === 'prev') showStop(Garden.tourGo(Garden.tourIndex() - 1));
    else if (a === 'next') showStop(Garden.tourGo(Garden.tourIndex() + 1));
    else setMode('you');
  });
  document.addEventListener('keydown', e => {
    if (mode !== 'ti' || (document.activeElement as HTMLElement).closest('input,textarea,select,button,a,dialog,[contenteditable="true"]')) return;
    if (e.key === 'ArrowRight') { e.preventDefault(); showStop(Garden.tourGo(Garden.tourIndex() + 1)); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); showStop(Garden.tourGo(Garden.tourIndex() - 1)); }
  });

  /* 点图上的院落：游览时看详情，其余看法下先回到游览 */
  Garden.init({ onPick: (id: string) => { if (mode !== 'you') setMode('you'); showPlace(id); nearby(id); } });
  const start = decodeURIComponent(location.hash.slice(1));
  if (start && D.places.some(p => p.id === start)) cur = start;
  const q = new URLSearchParams(location.search);
  setMode(q.has('tour') ? 'ti' : 'you');
  if (start && D.places.some(p => p.id === start)) requestAnimationFrame(() => nearby(start));
  addEventListener('hashchange', () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (D.places.some(p => p.id === id)) { setMode('you'); showPlace(id); nearby(id); }
  });
  addEventListener('hlm:progress', () => { setMode(mode); applyGuard(jian); });
</script>

