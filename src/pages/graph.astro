---
import Base from '../layouts/Base.astro';
import { layGraph } from '../lib/graph-layout.ts';
import { GROUPS, REL_TYPES, TYPE_ORDER, byId, tiesOf, PEOPLE, EDGES } from '../lib/data.ts';

const G = layGraph();
const TYPE_COLOR: Record<string, string> = { b: 'var(--g-rong)', m: 'var(--gold)', in: 'var(--g-ning)', sv: 'var(--ink-3)', lv: 'var(--k-lv)', fr: 'var(--g-lin)', ri: 'var(--ink)', my: 'var(--g-myth)' };
/* 边画成轻微的弧，避免两条线重在一起 */
const edgePath = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2, dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 1;
  const bend = Math.min(40, d * .12);
  return `M${a.x} ${a.y}Q${(mx - (dy / d) * bend).toFixed(1)} ${(my + (dx / d) * bend).toFixed(1)} ${b.x} ${b.y}`;
};
/* 给前端的数据：每人的身份和亲友 */
const client = {
  p: Object.fromEntries(PEOPLE.map(p => [p.id, [p.group, p.title, GROUPS[p.group].name]])),
  t: Object.fromEntries(PEOPLE.map(p => [p.id, tiesOf(p.id).filter(t => byId.has(t.other)).map(t => [t.other, t.type, t.role])])),
  types: Object.fromEntries(TYPE_ORDER.map(t => [t, REL_TYPES[t].name]))
};
---
<Base title="关系星图" description={`《红楼梦》${PEOPLE.length} 位人物、${EDGES.length} 条关系：按家族聚成九座岛，点一个人看他的亲友，或者查两个人之间隔着谁。`} section="graph" sub="graph" bodyClass="pg-graph">
  <div class="gwrap">
    <div class="stage" data-stage>
      <svg class="gsvg" data-svg role="img" aria-label="人物关系图">
        <defs>
          <radialGradient id="island-fill"><stop offset="0" stop-color="var(--ic)" stop-opacity=".12" /><stop offset=".7" stop-color="var(--ic)" stop-opacity=".05" /><stop offset="1" stop-color="var(--ic)" stop-opacity="0" /></radialGradient>
          <filter id="isl-blur"><feGaussianBlur stdDeviation="8" /></filter>
        </defs>
        <g data-vp>
          <g class="islands">
            {G.islands.map(i => (
              <g class="island" style={`--ic:var(--g-${i.g})`} data-island={i.g}>
                <circle cx={i.x} cy={i.cy} r={i.rad} fill="url(#island-fill)" />
                <text class="isl-name" x={i.x} y={i.y}>{GROUPS[i.g].name}</text>
              </g>
            ))}
          </g>
          <g class="edges">
            {G.links.map(l => {
              const a = G.nodes[l.s], b = G.nodes[l.t];
              return <path class={`e t-${l.type}`} d={edgePath(a, b)} data-a={a.id} data-b={b.id} style={`--tc:${TYPE_COLOR[l.type]}`} stroke-dasharray={REL_TYPES[l.type].dash || undefined} />;
            })}
          </g>
          <g class="nodes">
            {G.nodes.map(n => (
              <g class:list={['n', `tier-${n.tier}`]} data-id={n.id} transform={`translate(${n.x} ${n.y})`} style={`--gc:var(--g-${n.group})`} tabindex="0" role="button" aria-label={n.id}>
                {n.tier === 'o' ? <rect class="dot" x={-n.r} y={-n.r} width={n.r * 2} height={n.r * 2} transform="rotate(45)" /> : <circle class="dot" r={n.r} />}
                <text class="lb" y={n.r + 15}>{n.id}</text>
              </g>
            ))}
          </g>
        </g>
      </svg>

      <div class="hud top">
        <div class="modes" role="tablist" aria-label="看法">
          <button type="button" role="tab" data-mode="all" aria-selected="true">全景</button>
          <button type="button" role="tab" data-mode="chain" aria-selected="false">关系链</button>
        </div>
        <label class="find" data-find-all>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M15.5 15.5 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <input list="g-names" placeholder="找一个人" data-q aria-label="找一个人">
        </label>
        <form class="chain-form" data-chain-form hidden>
          <input list="g-names" placeholder="从" data-from aria-label="从谁">
          <span aria-hidden="true">到</span>
          <input list="g-names" placeholder="到" data-to aria-label="到谁">
          <button type="submit" class="btn">查</button>
        </form>
        <datalist id="g-names">{PEOPLE.map(p => <option value={p.id} />)}</datalist>
      </div>

      <div class="hud left legend" data-legend>
        {TYPE_ORDER.map(t => (
          <button type="button" class="lg" data-type={t} aria-pressed="true" style={`--tc:${TYPE_COLOR[t]}`}>
            <svg width="22" height="8" aria-hidden="true"><path d="M1 4H21" stroke="var(--tc)" stroke-width="2" stroke-dasharray={REL_TYPES[t].dash || undefined} /></svg>{REL_TYPES[t].name}
          </button>
        ))}
      </div>

      <div class="hud right zoom">
        <button type="button" data-z="1.3" aria-label="放大">＋</button>
        <button type="button" data-z="0.77" aria-label="缩小">−</button>
        <button type="button" data-z="0" aria-label="复位">复位</button>
        <button type="button" data-full aria-label="全屏">全屏</button>
      </div>

      <aside class="panel" data-panel hidden aria-live="polite"></aside>
      <p class="hint" data-hint>滚轮缩放，拖动平移；点一个人看他的命盘</p>
    </div>
  </div>
  <script is:inline type="application/json" id="g-data" set:html={JSON.stringify(client)} />
</Base>

<script>
  import { esc } from '../client/site.ts';
  type Tie = [string, string, string];
  const D: { p: Record<string, [string, string, string]>; t: Record<string, Tie[]>; types: Record<string, string> } = JSON.parse(document.getElementById('g-data')!.textContent!);
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const svg = document.querySelector<SVGSVGElement>('[data-svg]')!;
  const vp = svg.querySelector<SVGGElement>('[data-vp]')!;
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const nodes = new Map([...svg.querySelectorAll<SVGGElement>('.n')].map(g => [g.dataset.id!, g]));
  const edges = [...svg.querySelectorAll<SVGPathElement>('.e')];
  const pos = new Map([...nodes].map(([id, g]) => {
    const m = /translate\(([-\d.]+) ([-\d.]+)\)/.exec(g.getAttribute('transform')!)!;
    return [id, [+m[1], +m[2]] as [number, number]];
  }));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- 视口：平移与缩放 ---------- */
  const bbox = { x: 0, y: 0, w: 0, h: 0 };
  {
    const xs = [...pos.values()].map(p => p[0]), ys = [...pos.values()].map(p => p[1]);
    bbox.x = Math.min(...xs) - 60; bbox.y = Math.min(...ys) - 80; bbox.w = Math.max(...xs) - bbox.x + 60; bbox.h = Math.max(...ys) - bbox.y + 60;
  }
  let view = { x: 0, y: 0, k: 1 };
  const size = () => ({ w: stage.clientWidth, h: stage.clientHeight });
  const homeView = () => {
    const { w, h } = size();
    const k = Math.min(w / bbox.w, h / bbox.h) * .96;
    return { k, x: (w - bbox.w * k) / 2 - bbox.x * k, y: (h - bbox.h * k) / 2 - bbox.y * k };
  };
  function draw() {
    vp.setAttribute('transform', `translate(${view.x.toFixed(1)} ${view.y.toFixed(1)}) scale(${view.k.toFixed(4)})`);
    const home = homeView().k;
    svg.dataset.zoom = view.k > home * 2.2 ? '3' : view.k > home * 1.4 ? '2' : '1';
  }
  let anim = 0;
  function animateTo(target: typeof view, ms = 650) {
    cancelAnimationFrame(anim);
    if (reduced) { view = target; draw(); return; }
    const from = { ...view }, t0 = performance.now();
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const tick = (now: number) => {
      const t = Math.min(1, (now - t0) / ms), e = ease(t);
      view = { x: from.x + (target.x - from.x) * e, y: from.y + (target.y - from.y) * e, k: from.k + (target.k - from.k) * e };
      draw();
      if (t < 1) anim = requestAnimationFrame(tick);
    };
    anim = requestAnimationFrame(tick);
  }
  const zoomAt = (cx: number, cy: number, f: number) => {
    const home = homeView().k;
    const k = Math.max(home * .6, Math.min(home * 8, view.k * f));
    const r = k / view.k;
    view = { k, x: cx - (cx - view.x) * r, y: cy - (cy - view.y) * r };
    draw();
  };
  const centerOn = (pts: [number, number][], maxK = 2.2) => {
    const { w, h } = size();
    const xs = pts.map(p => p[0]), ys = pts.map(p => p[1]);
    const bx = Math.min(...xs) - 70, by = Math.min(...ys) - 70, bw = Math.max(...xs) - bx + 70, bh = Math.max(...ys) - by + 70;
    const panelW = !panel.hidden && w > 900 ? 360 : 0;
    const panelH = !panel.hidden && w <= 900 ? h * .42 : 0;
    const k = Math.min((w - panelW) / bw, (h - panelH) / bh, homeView().k * maxK);
    animateTo({ k, x: (w - panelW - bw * k) / 2 - bx * k, y: (h - panelH - bh * k) / 2 - by * k });
  };
  stage.addEventListener('wheel', e => {
    e.preventDefault();
    const r = stage.getBoundingClientRect();
    zoomAt(e.clientX - r.left, e.clientY - r.top, Math.exp(-e.deltaY * .0016));
  }, { passive: false });
  const pts = new Map<number, { x: number; y: number }>();
  let drag: { x: number; y: number; vx: number; vy: number } | null = null, moved = false, pinch = 0;
  stage.addEventListener('pointerdown', e => {
    if ((e.target as Element).closest('.hud, .panel')) return;
    stage.setPointerCapture(e.pointerId);
    pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pts.size === 1) { drag = { x: e.clientX, y: e.clientY, vx: view.x, vy: view.y }; moved = false; }
    if (pts.size === 2) { const [a, b] = [...pts.values()]; pinch = Math.hypot(a.x - b.x, a.y - b.y); }
  });
  stage.addEventListener('pointermove', e => {
    if (!pts.has(e.pointerId)) return;
    pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pts.size === 2) {
      const [a, b] = [...pts.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y), r = stage.getBoundingClientRect();
      if (pinch) zoomAt((a.x + b.x) / 2 - r.left, (a.y + b.y) / 2 - r.top, d / pinch);
      pinch = d; moved = true;
      return;
    }
    if (!drag) return;
    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    if (Math.abs(dx) + Math.abs(dy) > 4) { moved = true; stage.classList.add('dragging'); }
    view.x = drag.vx + dx; view.y = drag.vy + dy;
    draw();
  });
  const up = (e: PointerEvent) => {
    pts.delete(e.pointerId);
    if (pts.size < 2) pinch = 0;
    if (!pts.size) { drag = null; stage.classList.remove('dragging'); }
  };
  stage.addEventListener('pointerup', up);
  stage.addEventListener('pointercancel', up);
  stage.addEventListener('dblclick', e => {
    if ((e.target as Element).closest('.hud, .panel')) return;
    const r = stage.getBoundingClientRect();
    zoomAt(e.clientX - r.left, e.clientY - r.top, 1.6);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-z]').forEach(b => b.addEventListener('click', () => {
    const f = +b.dataset.z!;
    if (!f) { clear(); animateTo(homeView()); return; }
    const { w, h } = size();
    const target = { ...view };
    const k = view.k * f, r = k / view.k;
    target.k = k; target.x = w / 2 - (w / 2 - view.x) * r; target.y = h / 2 - (h / 2 - view.y) * r;
    animateTo(target, 300);
  }));
  document.querySelector('[data-full]')!.addEventListener('click', () => {
    if (document.fullscreenElement) document.exitFullscreen();
    else stage.requestFullscreen?.().catch(() => stage.classList.toggle('pseudo-full'));
  });
  addEventListener('resize', () => { if (!focusId) { view = homeView(); draw(); } });

  /* ---------- 高亮 ---------- */
  const hidden = new Set<string>();
  const edgeVisible = (p: SVGPathElement) => !hidden.has(p.classList[1].slice(2));
  function light(ids: Set<string>, pathEdges?: Set<SVGPathElement>) {
    svg.classList.add('lit');
    nodes.forEach((g, id) => g.classList.toggle('on', ids.has(id)));
    edges.forEach(p => p.classList.toggle('on', pathEdges ? pathEdges.has(p) : ids.has(p.dataset.a!) && ids.has(p.dataset.b!) && (focusId ? p.dataset.a === focusId || p.dataset.b === focusId : true) && edgeVisible(p)));
  }
  function unlight() {
    svg.classList.remove('lit');
    nodes.forEach(g => g.classList.remove('on', 'core'));
    edges.forEach(p => p.classList.remove('on'));
  }
  const neighbors = (id: string) => new Set([id, ...(D.t[id] ?? []).filter(t => !hidden.has(t[1])).map(t => t[0])]);
  let focusId: string | null = null, chainLit = false;

  nodes.forEach((g, id) => {
    g.addEventListener('pointerenter', () => { if (!focusId && !chainLit) light(neighbors(id)); g.classList.add('hov'); });
    g.addEventListener('pointerleave', () => { if (!focusId && !chainLit) unlight(); g.classList.remove('hov'); });
    g.addEventListener('click', () => { if (!moved) focus(id); });
    g.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); focus(id); } });
  });
  stage.addEventListener('click', e => {
    if (moved || (e.target as Element).closest('.n, .hud, .panel')) return;
    clear();
  });

  /* ---------- 命盘：选中一个人 ---------- */
  const groupColor = (id: string) => `var(--g-${D.p[id][0]})`;
  function focus(id: string, fly = true) {
    if (!D.p[id]) return;
    focusId = id; chainLit = false;
    const ids = neighbors(id);
    light(ids);
    nodes.get(id)!.classList.add('core');
    const [group, title, gname] = D.p[id];
    const ties = (D.t[id] ?? []).filter(t => !hidden.has(t[1]));
    const byType = new Map<string, Tie[]>();
    ties.forEach(t => { if (!byType.has(t[1])) byType.set(t[1], []); byType.get(t[1])!.push(t); });
    panel.innerHTML = `
      <button type="button" class="pn-x" data-close aria-label="关闭">×</button>
      <p class="pn-g" style="--gc:var(--g-${group})">${esc(gname)}</p>
      <h2>${esc(id)}</h2>
      <p class="pn-t">${esc(title)}</p>
      <p class="pn-n">${ties.length} 位亲友</p>
      ${[...byType].map(([t, list]) => `<div class="pn-sec"><h3>${esc(D.types[t])}</h3><ul>${list.map(([o, , role]) => `<li><button type="button" data-go="${esc(o)}" style="--gc:${groupColor(o)}">${esc(o)}</button><span>${esc(role)}</span></li>`).join('')}</ul></div>`).join('')}
      <div class="pn-acts"><a class="btn" href="/people/${encodeURIComponent(id)}/">进人物页</a><button type="button" class="btn ghost" data-chain-from="${esc(id)}">从这里查关系链</button></div>`;
    panel.hidden = false;
    stage.classList.add('has-panel');
    const url = new URL(location.href); url.search = ''; url.searchParams.set('focus', id); history.replaceState(null, '', url);
    if (fly) centerOn([...ids].map(x => pos.get(x)!).filter(Boolean));
  }
  function clear() {
    focusId = null; chainLit = false;
    unlight();
    panel.hidden = true;
    stage.classList.remove('has-panel');
    history.replaceState(null, '', location.pathname);
  }
  panel.addEventListener('click', e => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-close]')) { clear(); return; }
    const go = t.closest<HTMLElement>('[data-go]');
    if (go) { focus(go.dataset.go!); return; }
    const cf = t.closest<HTMLElement>('[data-chain-from]');
    if (cf) { setMode('chain'); fromIn.value = cf.dataset.chainFrom!; toIn.focus(); }
  });

  /* ---------- 找人 ---------- */
  const q = document.querySelector<HTMLInputElement>('[data-q]')!;
  q.addEventListener('change', () => { const v = q.value.trim(); if (D.p[v]) { focus(v); q.blur(); } });
  q.addEventListener('keydown', e => {
    if (e.key !== 'Enter') return;
    const v = q.value.trim();
    const hit = D.p[v] ? v : Object.keys(D.p).find(id => id.includes(v));
    if (hit) { q.value = hit; focus(hit); }
  });

  /* ---------- 关系类型开关 ---------- */
  document.querySelectorAll<HTMLButtonElement>('[data-type]').forEach(b => b.addEventListener('click', () => {
    const t = b.dataset.type!;
    hidden.has(t) ? hidden.delete(t) : hidden.add(t);
    b.setAttribute('aria-pressed', String(!hidden.has(t)));
    edges.forEach(p => p.classList.toggle('off', !edgeVisible(p)));
    if (focusId) focus(focusId, false);
  }));

  /* ---------- 关系链：两人之间最短的一条路 ---------- */
  const form = document.querySelector<HTMLFormElement>('[data-chain-form]')!;
  const fromIn = form.querySelector<HTMLInputElement>('[data-from]')!, toIn = form.querySelector<HTMLInputElement>('[data-to]')!;
  const findAll = document.querySelector<HTMLElement>('[data-find-all]')!;
  function setMode(m: string) {
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b => b.setAttribute('aria-selected', String(b.dataset.mode === m)));
    form.hidden = m !== 'chain';
    findAll.hidden = m === 'chain';
    if (m === 'chain') { if (focusId) fromIn.value = focusId; fromIn.value ? toIn.focus() : fromIn.focus(); }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b => b.addEventListener('click', () => setMode(b.dataset.mode!)));
  function bfs(a: string, b: string) {
    const prev = new Map<string, [string, Tie] | null>([[a, null]]);
    const queue = [a];
    while (queue.length) {
      const cur = queue.shift()!;
      if (cur === b) break;
      for (const t of D.t[cur] ?? []) {
        if (hidden.has(t[1]) || prev.has(t[0])) continue;
        prev.set(t[0], [cur, t]);
        queue.push(t[0]);
      }
    }
    if (!prev.has(b)) return null;
    const steps: { from: string; to: string; tie: Tie }[] = [];
    for (let cur = b; prev.get(cur); cur = prev.get(cur)![0]) steps.unshift({ from: prev.get(cur)![0], to: cur, tie: prev.get(cur)![1] });
    return steps;
  }
  function chain(a: string, b: string) {
    if (!D.p[a] || !D.p[b]) { panel.innerHTML = `<button type="button" class="pn-x" data-close aria-label="关闭">×</button><p class="pn-empty">人物谱里找不到${esc(!D.p[a] ? a || '起点' : b || '终点')}。</p>`; panel.hidden = false; return; }
    const steps = a === b ? [] : bfs(a, b);
    focusId = null; chainLit = true;
    if (!steps) {
      unlight();
      panel.innerHTML = `<button type="button" class="pn-x" data-close aria-label="关闭">×</button><p class="pn-empty">${esc(a)}和${esc(b)}之间，在现有的关系里连不上。</p>`;
      panel.hidden = false; stage.classList.add('has-panel');
      return;
    }
    const ids = new Set([a, ...steps.map(s => s.to)]);
    const pathEdges = new Set(edges.filter(p => steps.some(s => (p.dataset.a === s.from && p.dataset.b === s.to) || (p.dataset.a === s.to && p.dataset.b === s.from))));
    light(ids, pathEdges);
    nodes.get(a)!.classList.add('core'); nodes.get(b)!.classList.add('core');
    panel.innerHTML = `<button type="button" class="pn-x" data-close aria-label="关闭">×</button>
      <p class="pn-g">关系链</p>
      <h2 class="chain-h">${esc(a)}<small>到</small>${esc(b)}</h2>
      <p class="pn-n">隔着 ${Math.max(0, steps.length - 1)} 个人</p>
      <ol class="chain">
        <li><button type="button" data-go="${esc(a)}" style="--gc:${groupColor(a)}">${esc(a)}</button></li>
        ${steps.map(s => `<li class="step"><span class="via">${esc(s.tie[2])}<small>${esc(D.types[s.tie[1]])}</small></span><button type="button" data-go="${esc(s.to)}" style="--gc:${groupColor(s.to)}">${esc(s.to)}</button></li>`).join('')}
      </ol>
      <p class="pn-note">每一步写的是后一位之于前一位的身份。</p>`;
    panel.hidden = false;
    stage.classList.add('has-panel');
    const url = new URL(location.href); url.search = ''; url.searchParams.set('from', a); url.searchParams.set('to', b); history.replaceState(null, '', url);
    centerOn([...ids].map(x => pos.get(x)!));
  }
  form.addEventListener('submit', e => { e.preventDefault(); chain(fromIn.value.trim(), toIn.value.trim()); });

  /* ---------- 起步 ---------- */
  view = homeView();
  draw();
  const params = new URLSearchParams(location.search);
  if (params.get('from') && params.get('to')) { setMode('chain'); fromIn.value = params.get('from')!; toIn.value = params.get('to')!; chain(fromIn.value, toIn.value); }
  else if (params.get('focus')) focus(params.get('focus')!);
  else if (!reduced) {
    /* 第一次进来，从远处慢慢推近 */
    const h = homeView();
    view = { k: h.k * .7, x: h.x + bbox.w * h.k * .15, y: h.y + bbox.h * h.k * .15 };
    draw();
    requestAnimationFrame(() => animateTo(h, 1200));
  }
  setTimeout(() => document.querySelector('[data-hint]')?.classList.add('gone'), 5000);
</script>

<style>
  .gwrap { padding: 0 var(--gutter); max-width: calc(var(--wrap) + 240px); margin: 18px auto 0; }
  .stage { position: relative; height: calc(100svh - var(--header-h) - 70px); min-height: 520px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--card); background-image: var(--paper-grain); touch-action: none; cursor: grab; user-select: none; }
