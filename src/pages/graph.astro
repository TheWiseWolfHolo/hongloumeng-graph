---
/* 关系图：千里姻缘一线牵。整块素绢竖挂，从上到下是太虚幻境、大观园、宁荣二府、府外；
   人是一枚竖写名字的签，人和人之间用丝线牵着，线的颜色就是关系：婚配情缘红丝，血亲墨线，主仆麻线，交游青线，前世神缘金线。
   一开始只露血亲、婚配、情缘和神缘这副骨架，点到人才把他的线全牵出来，线上写明是他的什么人。 */
import Base from '../layouts/Base.astro';
import { layBoard } from '../lib/board-layout.ts';
import { GROUPS, REL_TYPES, TYPE_ORDER, byId, tiesOf, PEOPLE } from '../lib/data.ts';

const B = layBoard();
const NAME_OF: Record<string, string> = { b: '血親', m: '婚配', lv: '情緣', my: '前世', in: '姻親', sv: '主僕', fr: '交遊', ri: '恩怨' };
const SPOOLS = ['m', 'lv', 'b', 'in', 'my', 'sv', 'fr', 'ri'];
const client = {
  p: Object.fromEntries(PEOPLE.map(p => [p.id, [p.group, p.title, GROUPS[p.group].name, p.tier]])),
  t: Object.fromEntries(PEOPLE.map(p => [p.id, tiesOf(p.id).filter(t => byId.has(t.other)).map(t => [t.other, t.type, t.role])])),
  types: Object.fromEntries(TYPE_ORDER.map(t => [t, REL_TYPES[t].name]))
};
/* 祥云，太虚幻境那一层里散几朵 */
const CLOUDS: [number, number, number][] = [[260, 70, 1], [520, 120, .8], [820, 60, 1.1], [1180, 118, .9], [1430, 64, 1], [1640, 128, .75]];
const charY = (fs: number, i: number) => +(fs * .55 + (i + .88) * fs * 1.12).toFixed(1);
---
<Base title="关系" description="《红楼梦》人物关系。一块素绢从太虚幻境挂到府外，人和人之间用丝线牵着：婚配情缘红丝，血亲墨线，前世神缘金线。" section="relations" sub="graph" bodyClass="pg-graph">
  <div class="loom">
    <div class="bar" data-bar>
      <form class="find" data-find role="search">
        <label class="sr-only" for="g-q">寻一个人</label>
        <input id="g-q" data-q list="g-names" type="search" placeholder="寻一个人" autocomplete="off">
        <input data-to list="g-names" type="search" placeholder="与谁相干" autocomplete="off" hidden aria-label="另一个人">
        <button type="button" class="pair" data-pair aria-pressed="false" title="查两人之间隔着谁">兩人之間</button>
      </form>
      <datalist id="g-names">{PEOPLE.map(p => <option value={p.id} />)}</datalist>
      <div class="spools" role="group" aria-label="丝线">
        {SPOOLS.map(t => (
          <button type="button" class={`spool t-${t}`} data-type={t} aria-pressed={['b', 'm', 'lv', 'my'].includes(t) ? 'true' : 'false'}>
            <svg viewBox="0 0 24 28" aria-hidden="true"><rect class="flange" x="2" y="1" width="20" height="3.2" rx="1.2" /><rect class="flange" x="2" y="23.8" width="20" height="3.2" rx="1.2" /><rect class="wound" x="5" y="4.2" width="14" height="19.6" /><path class="wind" d="M5 7.5h14M5 11h14M5 14.5h14M5 18h14M5 21.5h14" /></svg>
            <span>{NAME_OF[t]}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="frame" data-frame>
      <svg class="silk" data-silk viewBox={`0 0 ${B.width} ${B.height}`} role="img" aria-label="人物关系图">
        <defs>
          <pattern id="weave" width="6" height="6" patternUnits="userSpaceOnUse"><path d="M0 .5H6M.5 0V6" stroke="#8a7350" stroke-opacity=".07" stroke-width="1" /></pattern>
          <radialGradient id="aged" cx="50%" cy="45%" r="75%"><stop offset=".6" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#4a3418" stop-opacity=".16" /></radialGradient>
          <symbol id="cloud" viewBox="0 0 120 50"><path d="M8 40c-8 0-8-12 0-12 0-10 14-12 18-4 3-12 22-14 26-2 4-8 18-8 18 2 10-4 18 6 10 12 8 2 6 12-2 12M30 40c0-6 8-8 11-3 2-5 10-4 10 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></symbol>
        </defs>
        <rect width={B.width} height={B.height} fill="#efe6cf" />
        <rect width={B.width} height={B.height} fill="url(#weave)" />
        <rect width={B.width} height={B.height} fill="url(#aged)" />

        <g class="zones" aria-hidden="true">
          {CLOUDS.map(([x, y, s]) => <use href="#cloud" class="cloud" x={x} y={y} width={120 * s} height={50 * s} />)}
          {B.zones.map((z, i) => (
            <g>
              {i > 0 && <><line class="rule" x1="30" x2={B.width - 30} y1={z.y - 46} y2={z.y - 46} /><line class="rule thin" x1="30" x2={B.width - 30} y1={z.y - 42} y2={z.y - 42} /></>}
              <text class="zone-name" x="48" y={z.y + 20}>{[...z.name].map((c, j) => <tspan x="48" y={z.y + 34 + j * 30}>{c}</tspan>)}</text>
              {z.clusters.map(c => <text class="cl-name" x={c.x} y={c.y + 18}>{c.name}</text>)}
            </g>
          ))}
        </g>

        <g class="threads" data-threads>
          {B.threads.map((t, i) => <path class={`th t-${t.type}`} d={t.d} data-a={t.a} data-b={t.b} data-type={t.type} pathLength="1" style={`--i:${i % 40}`} />)}
        </g>

        <g class="slips" data-slips>
          {B.slips.map(s => (
            <g class={`slip tier-${s.tier} band-${s.band}`} data-id={s.id} transform={`translate(${s.x} ${s.y})`} tabindex="0" role="button" aria-label={s.id} style={`--gc:var(--g-${byId.get(s.id)!.group})`}>
              <rect class="body" width={s.w} height={s.h} rx="3" />
              <rect class="cap" width={s.w} height="5" rx="2" />
              <text class="nm" font-size={s.fs}>{[...s.id].map((c, i) => <tspan x={s.w / 2} y={charY(s.fs, i)}>{c}</tspan>)}</text>
            </g>
          ))}
        </g>
        <g class="tags" data-tags aria-hidden="true"></g>
      </svg>
    </div>
    <aside class="panel" data-panel hidden aria-live="polite"></aside>
    <div class="zoomer" role="group" aria-label="缩放">
      <button type="button" data-zoom="1" aria-label="放大">大</button>
      <button type="button" data-zoom="-1" aria-label="缩小">小</button>
      <button type="button" data-zoom="0" aria-label="看全幅">全</button>
    </div>
  </div>
  <script is:inline type="application/json" id="g-data" set:html={JSON.stringify(client)} />
</Base>

<script>
  type Tie = [string, string, string];
  const D: { p: Record<string, [string, string, string, string]>; t: Record<string, Tie[]>; types: Record<string, string> } = JSON.parse(document.getElementById('g-data')!.textContent!);
  const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const NS = 'http://www.w3.org/2000/svg';
  const frame = document.querySelector<HTMLElement>('[data-frame]')!;
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const tagsG = document.querySelector<SVGGElement>('[data-tags]')!;
  const threads = [...document.querySelectorAll<SVGPathElement>('.th')];
  const slips = new Map([...document.querySelectorAll<SVGGElement>('.slip')].map(g => [g.dataset.id!, g]));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ties = (id: string) => D.t[id] ?? [];
  const touches = (p: SVGPathElement, id: string) => p.dataset.a === id || p.dataset.b === id;

  /* ---------- 缩放：素绢放大了看细处，按住拖着走 ---------- */
  const silk = document.querySelector<SVGSVGElement>('[data-silk]')!;
  let zoom = 1, dragged = false;
  const setZoom = (z: number, cx = frame.clientWidth / 2, cy = innerHeight / 2) => {
    z = Math.max(1, Math.min(3.2, z));
    if (Math.abs(z - zoom) < .001) return;
    /* 让鼠标底下那一点在缩放前后不动 */
    const r = silk.getBoundingClientRect();
    const fx = (cx - r.left) / r.width, fy = (cy - r.top) / r.height;
    zoom = z;
    silk.style.width = `${z * 100}%`;
    silk.style.minWidth = `${1080 * z}px`;
    const r2 = silk.getBoundingClientRect();
    frame.scrollLeft += r2.left + fx * r2.width - cx;
    scrollBy({ top: r2.top + fy * r2.height - cy, behavior: 'instant' as ScrollBehavior });
    frame.classList.toggle('zoomed', z > 1);
  };
  document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach(b => b.addEventListener('click', () => {
    const d = +b.dataset.zoom!;
    setZoom(d ? zoom * (d > 0 ? 1.4 : 1 / 1.4) : 1);
  }));
  frame.addEventListener('wheel', e => {
    if (!e.ctrlKey && !e.metaKey) return;
    e.preventDefault();
    setZoom(zoom * Math.exp(-e.deltaY * .0025), e.clientX, e.clientY);
  }, { passive: false });
  let pan: { x: number; y: number; sl: number; id: number } | null = null;
  frame.addEventListener('pointerdown', e => {
    if (e.button !== 0 || e.pointerType === 'touch' || (e.target as Element).closest('.slip, .panel')) return;
    pan = { x: e.clientX, y: e.clientY, sl: frame.scrollLeft, id: e.pointerId };
    dragged = false;
  });
  addEventListener('pointermove', e => {
    if (!pan || e.pointerId !== pan.id) return;
    const dx = e.clientX - pan.x, dy = e.clientY - pan.y;
    if (!dragged && Math.hypot(dx, dy) < 5) return;
    if (!dragged) { dragged = true; frame.classList.add('panning'); }
    frame.scrollLeft = pan.sl - dx;
    scrollBy({ top: -(e.movementY || 0), behavior: 'instant' as ScrollBehavior });
  });
  addEventListener('pointerup', () => {
    if (!pan) return;
    pan = null;
    frame.classList.remove('panning');
    /* 拖完那一下的点击不算 */
    setTimeout(() => { dragged = false; }, 0);
  });

  /* ---------- 线轴：哪几种线露在外面 ---------- */
  const shown = new Set(['b', 'm', 'lv', 'my']);
  const applyShown = () => threads.forEach(p => p.classList.toggle('show', shown.has(p.dataset.type!)));
  document.querySelectorAll<HTMLButtonElement>('[data-type]').forEach(b => b.addEventListener('click', () => {
    const t = b.dataset.type!;
    shown.has(t) ? shown.delete(t) : shown.add(t);
    b.setAttribute('aria-pressed', String(shown.has(t)));
    applyShown();
  }));

  /* 开场：签先落定，丝线再牵出来 */
  requestAnimationFrame(() => requestAnimationFrame(() => { frame.classList.add('ready'); applyShown(); }));

  /* ---------- 停在签上：他露着的线加深 ---------- */
  let focusId: string | null = null, pairOn = false;
  const hover = (id: string | null) => {
    if (focusId || pairOn || frame.classList.contains('paired')) return;
    frame.classList.toggle('hov', !!id);
    threads.forEach(p => p.classList.toggle('hl', !!id && touches(p, id)));
    const near = new Set(id ? [id, ...ties(id).map(t => t[0])] : []);
    slips.forEach((g, k) => g.classList.toggle('nb', near.has(k)));
  };
  slips.forEach((g, id) => {
    g.addEventListener('pointerenter', () => hover(id));
    g.addEventListener('pointerleave', () => hover(null));
    g.addEventListener('click', e => { e.stopPropagation(); pairOn ? pairPick(id) : focus(id); });
    g.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); focus(id); } });
  });

  /* ---------- 线上的字：写在线的中段，彼此不压，也不压签 ---------- */
  type Box = [number, number, number, number];
  const hit = (a: Box, b: Box) => a[0] < b[0] + b[2] && b[0] < a[0] + a[2] && a[1] < b[1] + b[3] && b[1] < a[1] + a[3];
  const slipBox = (g: SVGGElement): Box => { const r = g.querySelector('rect')!; const m = g.transform.baseVal[0].matrix; return [m.e - 3, m.f - 3, +r.getAttribute('width')! + 6, +r.getAttribute('height')! + 6]; };
  function writeTags(items: { path: SVGPathElement; text: string; cls: string }[], avoid: string[]) {
    tagsG.replaceChildren();
    const taken: Box[] = avoid.map(id => slipBox(slips.get(id)!));
    for (const { path, text, cls } of items) {
      const L = path.getTotalLength();
      const w = [...text].length * 14 + 14, h = 22;
      let at: Box | null = null;
      for (const t of [.5, .4, .6, .32, .68, .24, .76]) {
        const pt = path.getPointAtLength(L * t);
        const box: Box = [pt.x - w / 2, pt.y - h / 2, w, h];
        if (!taken.some(b => hit(b, box))) { at = box; break; }
      }
      if (!at) continue;
      taken.push(at);
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('class', `tag ${cls}`);
      g.setAttribute('transform', `translate(${at[0].toFixed(1)} ${at[1].toFixed(1)})`);
      g.innerHTML = `<rect width="${w}" height="${h}" rx="2"/><text x="${w / 2}" y="15.5">${esc(text)}</text>`;
      tagsG.append(g);
    }
  }

  /* ---------- 点一个人：别人淡下去，他的线全牵出来，线上写明是他的什么人 ---------- */
  function focus(id: string, scroll = true) {
    if (!D.p[id]) return;
    if (pairOn) setPair(false);
    clear(false);
    focusId = id;
    frame.classList.add('focused');
    const ts = ties(id);
    const near = new Set(ts.map(t => t[0]));
    slips.forEach((g, k) => { g.classList.toggle('me', k === id); g.classList.toggle('nb', near.has(k)); });
    const items: { path: SVGPathElement; text: string; cls: string }[] = [];
    threads.forEach(p => {
      const on = touches(p, id);
      p.classList.toggle('on', on);
      if (!on) return;
      const other = p.dataset.a === id ? p.dataset.b! : p.dataset.a!;
      const tie = ts.find(t => t[0] === other && t[1] === p.dataset.type);
      if (tie) items.push({ path: p, text: tie[2], cls: `t-${tie[1]}` });
    });
    writeTags(items, [id, ...near]);
    renderPanel(id);
    const url = new URL(location.href); url.search = ''; url.searchParams.set('focus', id); history.replaceState(null, '', url);
    if (scroll) slips.get(id)!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center', inline: 'center' });
  }
  function clear(resetUrl = true) {
    focusId = null;
    frame.classList.remove('focused', 'paired', 'hov');
    slips.forEach(g => g.classList.remove('me', 'nb', 'end'));
    threads.forEach(p => p.classList.remove('on', 'hl', 'path'));
    tagsG.replaceChildren();
    panel.hidden = true;
    if (resetUrl) { const url = new URL(location.href); url.search = ''; history.replaceState(null, '', url); }
  }
  frame.addEventListener('click', e => {
    if (dragged) { e.stopPropagation(); return; }
    if (focusId || frame.classList.contains('paired')) clear();
  });
  addEventListener('keydown', e => { if (e.key === 'Escape') { if (pairOn) setPair(false); clear(); } });

  /* ---------- 旁边的笺：这个人和他的亲友 ---------- */
  const ORDER = ['m', 'lv', 'b', 'in', 'my', 'sv', 'fr', 'ri'];
  function renderPanel(id: string) {
    const [group, title, gname] = D.p[id];
    const ts = ties(id);
    const by = new Map<string, Tie[]>();
    ORDER.forEach(t => { const l = ts.filter(x => x[1] === t); if (l.length) by.set(t, l); });
    panel.innerHTML = `
      <button type="button" class="pn-x" data-close aria-label="收起">×</button>
      <p class="pn-g" style="--gc:var(--g-${group})">${esc(gname)}</p>
      <h2>${esc(id)}</h2>
      <p class="pn-t">${esc(title)}</p>
      ${[...by].map(([t, list]) => `<div class="pn-sec t-${t}"><h3>${esc(D.types[t])}</h3><ul>${list.map(([o, , role]) => `<li><button type="button" data-go="${esc(o)}">${esc(o)}</button><span>${esc(role)}</span></li>`).join('')}</ul></div>`).join('')}
      <p class="pn-acts"><a href="/people/${encodeURIComponent(id)}/">看他的生平</a><button type="button" data-pair-from="${esc(id)}">和谁相干</button></p>`;
    panel.hidden = false;
    panel.scrollTop = 0;
  }
  panel.addEventListener('click', e => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-close]')) { clear(); return; }
    const go = t.closest<HTMLElement>('[data-go]');
    if (go) { focus(go.dataset.go!); return; }
    const pf = t.closest<HTMLElement>('[data-pair-from]');
    if (pf) { const from = pf.dataset.pairFrom!; clear(); setPair(true); qIn.value = from; toIn.focus(); }
  });

  /* ---------- 寻人 ---------- */
  const qIn = document.querySelector<HTMLInputElement>('[data-q]')!;
  const toIn = document.querySelector<HTMLInputElement>('[data-to]')!;
  const pairBtn = document.querySelector<HTMLButtonElement>('[data-pair]')!;
  const resolve = (v: string) => (D.p[v] ? v : Object.keys(D.p).find(id => v && id.includes(v)) ?? null);
  const go = () => {
    const a = resolve(qIn.value.trim());
    if (!pairOn) { if (a) { qIn.value = a; qIn.blur(); focus(a); } return; }
    const b = resolve(toIn.value.trim());
    if (a && b) { qIn.value = a; toIn.value = b; trace(a, b); }
  };
  document.querySelector('[data-find]')!.addEventListener('submit', e => { e.preventDefault(); go(); });
  qIn.addEventListener('change', go);
  toIn.addEventListener('change', go);

  /* ---------- 两人之间：最短的一条线一段段亮起来，写成一句话 ---------- */
  function setPair(on: boolean) {
    pairOn = on;
    pairBtn.setAttribute('aria-pressed', String(on));
    toIn.hidden = !on;
    qIn.placeholder = on ? '一个人' : '寻一个人';
    if (on) { if (focusId) { qIn.value = focusId; clear(); } (qIn.value ? toIn : qIn).focus(); }
  }
  pairBtn.addEventListener('click', () => setPair(!pairOn));
  function pairPick(id: string) {
    if (!qIn.value || toIn.value) { qIn.value = id; toIn.value = ''; toIn.focus(); return; }
    toIn.value = id; go();
  }
  function bfs(a: string, b: string) {
    const prev = new Map<string, [string, Tie] | null>([[a, null]]);
    const queue = [a];
    while (queue.length) {
      const c = queue.shift()!;
      if (c === b) break;
      for (const t of ties(c)) { if (prev.has(t[0])) continue; prev.set(t[0], [c, t]); queue.push(t[0]); }
    }
    if (!prev.has(b)) return null;
    const steps: { from: string; to: string; tie: Tie }[] = [];
    for (let c = b; prev.get(c); c = prev.get(c)![0]) steps.unshift({ from: prev.get(c)![0], to: c, tie: prev.get(c)![1] });
    return steps;
  }
  function trace(a: string, b: string) {
    clear(false);
    const steps = a === b ? [] : bfs(a, b);
    frame.classList.add('paired');
    const ids = new Set([a, b, ...(steps ?? []).map(s => s.to)]);
    slips.forEach((g, k) => { g.classList.toggle('nb', ids.has(k)); g.classList.toggle('end', k === a || k === b); });
    const items: { path: SVGPathElement; text: string; cls: string }[] = [];
    (steps ?? []).forEach((s, i) => {
      const p = threads.find(p => (p.dataset.a === s.from && p.dataset.b === s.to) || (p.dataset.a === s.to && p.dataset.b === s.from));
      if (!p) return;
      p.style.setProperty('--k', String(i));
      p.classList.add('path');
      items.push({ path: p, text: s.tie[2], cls: `t-${s.tie[1]}` });
    });
    writeTags(items, [...ids]);
    /* 一句一句念下来：后一位是前一位的什么人 */
    const said = steps ? steps.map(s => `<button type="button" data-go="${esc(s.to)}">${esc(s.to)}</button>是<button type="button" data-go="${esc(s.from)}">${esc(s.from)}</button>的${esc(s.tie[2])}`).join('；') + '。' : '';
    panel.innerHTML = `<button type="button" class="pn-x" data-close aria-label="收起">×</button>
      <p class="pn-g">兩人之間</p>
      <h2 class="pn-pair">${esc(a)}<small>与</small>${esc(b)}</h2>
      <p class="pn-said kai">${steps ? said : `${esc(a)}与${esc(b)}，书里牵不上线。`}</p>`;
    panel.hidden = false;
    /* 滚到整条路线的中段 */
    const rs = [...ids].map(k => slips.get(k)!.getBoundingClientRect());
    const midY = (Math.min(...rs.map(r => r.top)) + Math.max(...rs.map(r => r.bottom))) / 2;
    scrollTo({ top: scrollY + midY - innerHeight / 2, behavior: reduced ? 'auto' : 'smooth' });
    const url = new URL(location.href); url.search = ''; url.searchParams.set('from', a); url.searchParams.set('to', b); history.replaceState(null, '', url);
  }

  /* ---------- 起步 ---------- */
  const params = new URLSearchParams(location.search);
  if (params.get('from') && params.get('to')) { setPair(true); qIn.value = params.get('from')!; toIn.value = params.get('to')!; go(); }
  else if (params.get('focus')) setTimeout(() => focus(params.get('focus')!), 60);
</script>

<style>
  /* 丝线的颜色就是关系：婚配情缘红丝，血亲墨线，姻亲淡墨，主仆麻线，交游青线，恩怨黛色，前世金线 */
  .loom { --t-m: #b02d22; --t-lv: #c95a4a; --t-b: #2b221b; --t-in: #7d6c58; --t-sv: #a8895a; --t-fr: #3f7a70; --t-ri: #3f4c78; --t-my: #b48a33; position: relative; padding-bottom: 40px; }
  .loom :global(.t-m) { --tc: var(--t-m); } .loom :global(.t-lv) { --tc: var(--t-lv); } .loom :global(.t-b) { --tc: var(--t-b); } .loom :global(.t-in) { --tc: var(--t-in); }
