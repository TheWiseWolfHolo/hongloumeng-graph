---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PersonLink from '../components/PersonLink.astro';
import { LOVES, FEUDS } from '../data/loves.ts';
import { cn } from '../lib/cn.ts';
import { loadChapter } from '../lib/render-text.ts';
import woodStone from '../assets/love/wood-stone.png';
import goldJade from '../assets/love/gold-jade.png';

const fifth = loadChapter(5);
function song(name: string, keys: string[]) {
  const heading = fifth.blocks.findIndex(b => b.t === 'center' && b.s.includes(name));
  const text = fifth.blocks[heading + 1].s;
  const phrases = text.match(/[^，。；！？]+[，。；！？]?/gu)!;
  return { text, excerpt: keys.map(key => phrases.find(p => p.startsWith(key))!), block: heading + 2 };
}
const wang = song('枉凝眉', ['一个是阆苑仙葩', '一个是美玉无瑕', '一个是水中月', '一个是镜中花']);
const zhong = song('终身悮', ['都道是金玉良姻', '俺只念木石前盟', '山中高士晶莹雪', '世外仙姝寂寞林']);
const PACTS = [
  { key: 'mu', title: '木石前盟', caption: '绛珠仙草 · 神瑛侍者', image: woodStone, alt: '据第一回意绘的绛珠草与三生石畔景致', name: '枉凝眉', song: wang,
    quote: '但把我一生所有的眼泪还他，也偿还得过他了。', source: 1, who: '绛珠仙子' },
  { key: 'jin', title: '金玉良緣', caption: '通灵宝玉 · 璎珞金锁', image: goldJade, alt: '据第一、八回意绘的霞色通灵玉与黄金璎珞锁', name: '终身误', song: zhong,
    quote: '我听这两句话，倒像和姑娘的项圈上的两句话是一对儿。', source: 8, who: '莺儿' }
];
const SI = [
  { name: '痴情司', titles: ['木石前盟', '画蔷', '鸳鸯剑', '园中私情'] },
  { name: '結怨司', titles: ['琏凤之家'] },
  { name: '朝啼司', titles: ['中山狼', '妻妾之祸'] },
  { name: '夜怨司', titles: ['金玉良缘', '水月庵之私'] },
  { name: '春感司', titles: ['拾帕传情', '典衣之缘', '汗巾之约', '回头一顾'] },
  { name: '秋悲司', titles: ['远嫁海疆', '金麒麟伏白首双星', '佛手与柚子'] }
];
const byTitle = new Map(LOVES.map(l => [l.title, l]));
const lineHref = (ids: string[]) => ids.length > 1 ? `/graph/?from=${encodeURIComponent(ids[0])}&to=${encodeURIComponent(ids[1])}` : `/graph/?focus=${encodeURIComponent(ids[0])}`;
const hui = (n: number) => `第${cn(n)}回`;
const span = ([a, b]: [number, number]) => a === b ? hui(a) : `第${cn(a)}至${cn(b)}回`;
const feuds = [...FEUDS].sort((a, b) => a.range[0] - b.range[0]);
---
<Base title="情缘与风波" description="从木石前盟与金玉良缘读起，查阅人物情缘和贾府风波。正文经历、判词与批语、续书情节分别列出，并可回到原文。" section="relations" sub="love">
  <div class="wrap love-page">
    <PageHead title="情缘与风波" slip="情緣" quote="厚地高天，堪叹古今情不尽｜痴男怨女，可怜风月债难偿" from="第五回　孽海情天" />

    <section class="pacts" aria-label="木石前盟与金玉良缘">
      {PACTS.map(p => (
        <article class={`pact ${p.key}`}>
          <figure class="pact-art">
            <button type="button" class="art-enlarge" data-art-open={`art-${p.key}`} aria-label={`放大${p.key === 'jin' ? '通灵玉与金锁' : '绛珠草与三生石'}插画`}>
              <Image src={p.image} width={768} widths={[384, 640, 768]} sizes="(max-width: 420px) 78vw, 340px" format="webp" quality={85} alt={p.alt} loading="eager" />
              <span>展卷细看</span>
            </button>
          </figure>
          <dialog class="art-view" id={`art-${p.key}`} aria-label={p.key === 'jin' ? '通灵玉与金锁插画' : '绛珠草与三生石插画'}>
            <button type="button" class="art-close" data-art-close>收起画幅</button>
            <div class="art-scroll" data-art-scroll tabindex="0" role="region" aria-label="放大插画，可上下左右移动查看细部">
              <Image src={p.image} width={1280} format="webp" quality={90} alt={p.alt} loading="lazy" />
            </div>
          </dialog>
          <h2>{p.title}</h2>
          <p class="pact-caption">{p.caption}</p>
          <div class="song-excerpt spoil" data-ch="5">
            <div class="spoil-body">
              <p class="qu" aria-label={p.song.excerpt.join('')}>{p.song.excerpt.map(line => <span>{line}</span>)}</p>
              <details class="full-song">
                <summary>《{p.name}》全曲</summary>
                <p>{p.song.text}</p>
                <a class="source" href={`/chapters/5/?ref=love#p${p.song.block}`}>第五回原文</a>
              </details>
            </div>
          </div>
          <div class="quote-block spoil" data-ch={p.source}>
            <blockquote class="spoil-body"><p>“{p.quote}”</p><cite><a href={`/chapters/${p.source}/?ref=love`}>{hui(p.source)} · {p.who}</a></cite></blockquote>
          </div>
          {p.key === 'jin' && <details class="object-notes">
            <summary>玉与金锁上的字</summary>
            <div class="spoil" data-ch="8"><div class="spoil-body">
              <dl>
                <dt>玉正面</dt><dd>莫失莫忘，仙寿恒昌。</dd>
                <dt>玉背面</dt><dd>一除邪祟，二疗冤疾，三知祸福。</dd>
                <dt>锁正面</dt><dd>不离不弃。</dd>
                <dt>锁反面</dt><dd>芳龄永继。</dd>
              </dl>
              <p>原文写玉“大如雀卵，灿若明霞，莹润如酥”，金锁一面四个篆字，两面共八字。画中以篆意刻字，器形与比例为意绘。</p>
              <a class="source" href="/chapters/8/?ref=love#p11">第八回 · 看玉与金锁</a>
            </div></div>
          </details>}
        </article>
      ))}
    </section>

    <section class="trio" aria-label="黛玉、宝玉与宝钗">
      <div class="trio-people"><PersonLink id="薛宝钗" /><i aria-hidden="true"></i><PersonLink id="贾宝玉" /><i aria-hidden="true"></i><PersonLink id="林黛玉" /></div>
      <details class="trio-note">
        <summary>三人的情与婚</summary>
        <div class="trio-materials">
          <div class="spoil" data-ch="32"><div class="spoil-body"><h3>正文经历</h3><p>宝黛从亲密相处渐至互明心意，宝玉在第三十二回说“你放心”。金玉相配的说法在第八回已经出现，前八十回未写宝玉成婚。</p><a class="source" href="/chapters/32/?ref=love">第三十二回 · 诉肺腑</a></div></div>
          <div class="spoil" data-ch="121"><div class="spoil-body"><h3>判词与批语</h3><p>第二十一回庚辰夹批提及宝玉“得宝钗之妻、麝月之婢”而弃之为僧。它透露了批者所见后文，现存前八十回没有写出完整经过。</p><a class="source" href="/chapters/21/?ref=love#p16">第二十一回 · 庚辰夹批</a></div></div>
          <div class="spoil" data-ch="120"><div class="spoil-body"><h3>续书情节</h3><p>第九十七、九十八回写宝钗成婚与黛玉去世，末回又交代宝玉随僧道而去。续书的安排单独列在人物条目中。</p><a class="source" href="/chapters/98/?ref=love">第九十八回原文</a></div></div>
        </div>
      </details>
    </section>

    <section class="si-wrap" aria-labelledby="si-h">
      <header class="section-title"><h2 id="si-h">六司情緣</h2><p>借第五回六司名目分栏，人物归类由本页编排。<a href="/chapters/5/?ref=love#p29">读原文</a></p></header>
      <div class="si-tabs" role="tablist" aria-label="情缘目录">
        {SI.map((s, i) => <button type="button" role="tab" class="si-tab" id={`si-t${i}`} aria-controls={`si-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-si={i}>{s.name}</button>)}
      </div>
      {SI.map((s, i) => <div class="si-pane" role="tabpanel" id={`si-p${i}`} aria-labelledby={`si-t${i}`} hidden={i !== 0}>
        {s.titles.map(t => byTitle.get(t)!).map(l => <article class="love-card spoil" data-ch={l.revealAt}>
          <div class="spoil-body">
            <header class="love-head"><h3>{l.title}</h3><p>{l.ids.map(id => <PersonLink id={id} />)}</p></header>
            <div class="love-materials">
              {l.sections.map(section => <section class="love-layer spoil" data-ch={section.revealAt}>
                <div class="spoil-body"><h4>{section.kind}</h4><p>{section.text}</p><p class="sources">{section.sources.map(s => <a href={`/chapters/${s.n}/?ref=love`}>{hui(s.n)}{s.label && <span> · {s.label}</span>}</a>)}</p></div>
              </section>)}
            </div>
            <a class="relation-link" href={lineHref(l.ids)}>查看人物关系</a>
          </div>
        </article>)}
      </div>)}
    </section>

    <section class="feud-wrap" aria-labelledby="fe-h">
      <header class="section-title"><h2 id="fe-h">風波</h2><p>循回目读几场风波。</p></header>
      <nav class="feud-index" aria-label="风波目录">
        {feuds.map((f, i) => <button type="button" data-feud-pick={i} aria-controls={`feud-${i}`} aria-pressed={i === 0 ? 'true' : 'false'} data-reveal-at={f.range[1]} data-event-title={f.title} data-safe-label={span(f.range)}><small>{span(f.range)}</small><span>{f.title}</span></button>)}
      </nav>
      <div class="feud-leaves">
        {feuds.map((f, i) => <article class="feud spoil" id={`feud-${i}`} data-feud={i} data-ch={f.range[1]} hidden={i !== 0}>
          <div class="spoil-body"><p class="feud-hui">{span(f.range)}</p><h3>{f.title}</h3><p class="feud-text">{f.text}</p><p class="feud-people">{f.ids.map(id => <PersonLink id={id} />)}</p><a class="source" href={`/chapters/${f.range[0]}/?ref=love`}>{f.hui} · 读原文</a></div>
        </article>)}
      </div>
      <div class="feud-turn" role="group" aria-label="翻看风波"><button type="button" data-feud-prev disabled>前一事</button><span data-feud-position aria-live="polite">一／{cn(feuds.length)}</span><button type="button" data-feud-next>后一事</button></div>
    </section>
  </div>
</Base>

<script>
  import { applyGuard, progress, cn } from '../client/site.ts';
  document.querySelectorAll<HTMLButtonElement>('[data-art-open]').forEach(button => {
    const dialog = document.getElementById(button.dataset.artOpen!) as HTMLDialogElement;
    const scroll = dialog.querySelector<HTMLElement>('[data-art-scroll]')!;
    button.addEventListener('click', () => {
      dialog.showModal();
      scroll.scrollLeft = (scroll.scrollWidth - scroll.clientWidth) / 2;
      scroll.scrollTop = 0;
    });
    dialog.querySelector<HTMLButtonElement>('[data-art-close]')!.addEventListener('click', () => dialog.close());
  });
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-si]')];
  const panes = [...document.querySelectorAll<HTMLElement>('.si-pane')];
  function pickSi(i: number, focus = false) {
    tabs.forEach((tab, k) => { tab.setAttribute('aria-selected', String(k === i)); tab.tabIndex = k === i ? 0 : -1; });
    panes.forEach((pane, k) => { pane.hidden = k !== i; });
    applyGuard(panes[i]);
    if (focus) tabs[i].focus();
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => pickSi(i));
    tab.addEventListener('keydown', e => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
      e.preventDefault();
      pickSi(e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : (i + (e.key === 'ArrowLeft' ? 1 : -1) + tabs.length) % tabs.length, true);
    });
  });
  const choices = [...document.querySelectorAll<HTMLButtonElement>('[data-feud-pick]')];
  const leaves = [...document.querySelectorAll<HTMLElement>('[data-feud]')];
  const previous = document.querySelector<HTMLButtonElement>('[data-feud-prev]')!;
  const next = document.querySelector<HTMLButtonElement>('[data-feud-next]')!;
  const position = document.querySelector('[data-feud-position]')!;
  let selected = 0;
  function pickFeud(i: number) {
    selected = i;
    choices.forEach((button, k) => button.setAttribute('aria-pressed', String(k === i)));
    leaves.forEach((leaf, k) => { leaf.hidden = k !== i; });
    previous.disabled = i === 0;
    next.disabled = i === leaves.length - 1;
    position.textContent = `${cn(i + 1)}／${cn(leaves.length)}`;
    const button = choices[i], index = button.parentElement!;
    index.scrollTo({ left: button.offsetLeft - index.offsetLeft - (index.clientWidth - button.clientWidth) / 2, behavior: 'auto' });
  }
  choices.forEach((button, i) => button.addEventListener('click', () => pickFeud(i)));
  previous.addEventListener('click', () => pickFeud(selected - 1));
  next.addEventListener('click', () => pickFeud(selected + 1));
  function updateGuard() {
    choices.forEach(button => {
      const hidden = progress() > 0 && +button.dataset.revealAt! > progress();
      button.querySelector('span')!.textContent = hidden ? '未读风波' : button.dataset.eventTitle!;
      button.setAttribute('aria-label', hidden ? `${button.dataset.safeLabel}，未读风波` : `${button.dataset.safeLabel}，${button.dataset.eventTitle}`);
      button.dataset.guardReady = '';
    });
  }
  updateGuard();
  addEventListener('hlm:progress', updateGuard);
</script>

<style>
  .love-page { padding-bottom: 64px; }
  .pacts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); position: relative; margin-top: 6px; padding: 16px 0 30px; border-block: 1px solid var(--line-2); background: color-mix(in srgb, var(--card) 48%, transparent); }
  .pacts::after { content: ''; position: absolute; top: 24px; bottom: 24px; left: 50%; width: 1px; background: var(--line); pointer-events: none; }
  .pact { min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 4px clamp(20px, 3vw, 44px) 10px; }
  .mu { grid-column: 2; grid-row: 1; }
  .jin { grid-column: 1; grid-row: 1; }
  .pact-art { position: relative; width: min(100%, 340px); margin: 0; }
  .pact-art :global(img) { display: block; width: 100%; height: auto; }
  .art-enlarge { position: relative; display: block; width: 100%; cursor: zoom-in; }
  .art-enlarge span { display: block; width: fit-content; margin: 6px auto 8px; padding-bottom: 2px; border-bottom: 1px solid var(--line); font: 400 13px/1.6 var(--title); letter-spacing: .15em; color: var(--ink-3); }
  .art-enlarge:hover span { color: var(--cinnabar); border-color: var(--cinnabar); }
  .art-view { width: min(92vw, 1000px); max-height: 92dvh; padding: 24px; overflow: hidden; border: 1px solid var(--line-2); background: var(--paper); color: var(--ink); }
  .art-view::backdrop { background: rgb(20 17 14 / .65); }
  .art-scroll { max-height: min(75dvh, calc(92dvh - 100px)); overflow: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .art-scroll :global(img) { display: block; width: 100%; height: auto; max-height: 75dvh; object-fit: contain; }
  .art-close { display: block; margin: 0 0 12px auto; padding: 8px 2px; border-bottom: 1px solid var(--cinnabar); color: var(--cinnabar); font: 400 16px/1.4 var(--title); }
  .pact h2 { margin-top: 8px; font: 400 clamp(28px, 2.6vw, 36px)/1.3 var(--title); letter-spacing: .22em; }
  .mu h2 { color: var(--cinnabar); }
  .pact-caption { margin-top: 6px; font: 400 14px/1.8 var(--title); color: var(--ink-3); letter-spacing: .12em; }
  .song-excerpt { width: 100%; margin-top: 22px; }
  .qu { display: flex; flex-direction: row-reverse; justify-content: center; align-items: flex-start; gap: clamp(12px, 2vw, 24px); margin: 0; }
  .qu span { writing-mode: vertical-rl; white-space: nowrap; font: 400 21px/1.45 var(--title); letter-spacing: .12em; }
  .full-song { width: 100%; margin-top: 18px; text-align: center; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .full-song summary, .object-notes summary, .trio-note summary { display: inline-block; padding: 6px 4px; color: var(--cinnabar); font: 400 16px/1.6 var(--title); border-bottom: 1px solid var(--line-2); }
  details[open] > summary { border-bottom-color: var(--cinnabar); }
  .full-song > p { margin-top: 14px; text-align: left; font: 400 18px/2 var(--title); overflow-wrap: anywhere; }
  .source { display: inline-block; color: var(--cinnabar); font: 400 14px/1.8 var(--title); margin-top: 8px; text-underline-offset: 3px; }
  .source:hover { text-decoration: underline; }
  .quote-block { width: 100%; margin-top: 20px; }
  .quote-block blockquote { margin: 0; text-align: center; font: 400 15px/1.9 var(--serif); color: var(--ink-2); }
  .quote-block cite { display: block; margin-top: 6px; font: 400 13px/1.7 var(--title); color: var(--ink-3); }
  .object-notes { width: 100%; margin-top: 14px; text-align: center; }
  .object-notes dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px 12px; margin: 16px 0; text-align: left; font: 400 15px/1.8 var(--title); }
  .object-notes dt { color: var(--cinnabar); }
  .object-notes dd { margin: 0; }
  .object-notes p { font: 400 13px/1.8 var(--serif); color: var(--ink-3); text-align: left; }
  .trio { padding: 28px 0 34px; border-bottom: 1px solid var(--line); }
  .trio-people { display: flex; justify-content: center; align-items: center; gap: 16px; font: 400 22px/1.5 var(--title); }
  .trio-people i { flex: 0 1 70px; height: 5px; border-top: 1px solid var(--cinnabar); border-radius: 50%; rotate: -3deg; opacity: .55; }
  .trio-note { margin-top: 12px; text-align: center; }
  .trio-materials { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 20px; text-align: left; }
  .trio-materials h3 { margin-bottom: 8px; font: 400 16px/1.5 var(--title); color: var(--cinnabar); }
  .trio-materials p { font: 400 15px/1.95 var(--serif); color: var(--ink-2); }
  .si-wrap { padding-top: 44px; }
  .section-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 26px; margin-bottom: 22px; }
  .section-title h2 { font: 400 clamp(28px, 3vw, 36px)/1.3 var(--title); letter-spacing: .18em; }
  .section-title p { font: 400 14px/1.8 var(--serif); color: var(--ink-3); }
  .section-title a { color: var(--cinnabar); margin-left: 8px; }
  .si-tabs { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); direction: rtl; margin-bottom: 24px; border-block: 1px solid var(--line-2); }
  .si-tab { position: relative; min-width: 0; min-height: 52px; padding: 12px 4px; font: 400 20px/1.4 var(--title); letter-spacing: .1em; color: var(--ink-3); }
  .si-tab + .si-tab { border-right: 1px solid var(--line); }
  .si-tab[aria-selected="true"] { color: var(--cinnabar); background: color-mix(in srgb, var(--card) 65%, transparent); }
  .si-tab[aria-selected="true"]::after { content: ''; position: absolute; bottom: 7px; left: 30%; right: 26%; height: 3px; border-bottom: 1.7px solid var(--cinnabar); border-radius: 37% 61% 42% 58%; rotate: -3deg; pointer-events: none; }
  .si-pane { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .love-card { padding: 24px; border: 1px solid var(--line-2); background: color-mix(in srgb, var(--card) 60%, transparent); min-width: 0; }
  .love-head { padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .love-head h3 { font: 400 25px/1.5 var(--title); letter-spacing: .08em; }
  .love-head > p { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 8px; font: 400 15px/1.7 var(--title); }
  .love-layer { padding-top: 18px; }
  .love-layer h4 { margin-bottom: 6px; font: 400 15px/1.6 var(--title); color: var(--cinnabar); letter-spacing: .1em; }
  .love-layer p { font: 400 15.5px/1.95 var(--serif); color: var(--ink-2); }
  .love-layer .sources { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; font: 400 13px/1.8 var(--title); color: var(--ink-3); }
  .sources a:hover { color: var(--cinnabar); text-decoration: underline; text-underline-offset: 3px; }
  .relation-link { display: inline-block; margin-top: 20px; padding-top: 8px; border-top: 1px solid var(--line); font: 400 14px/1.8 var(--title); color: var(--cinnabar); }
  .feud-wrap { padding-top: 52px; }
  .feud-index { display: flex; gap: 6px; overflow-x: auto; padding: 6px 0 12px; scrollbar-width: thin; }
  .feud-index button { position: relative; flex: 0 0 134px; padding: 10px 8px 14px; border-bottom: 1px solid var(--line); text-align: left; }
  .feud-index small { display: block; font: 400 12px/1.8 var(--title); color: var(--ink-3); }
