---
/* 情缘与风波。三段：
   一、两盟：木石前盟与金玉良缘对面摆着，各配第五回里唱它的那支曲子，曲子一句一行竖写；底下是黛、宝、钗三人和牵着他们的线。
   二、六司：第五回宝玉在太虚幻境看见两边配殿挂着痴情司、结怨司、朝啼司、夜怨司、春感司、秋悲司六块匾，十六段情缘分挂在六司底下。
       结局可以在脂本和续书之间切换，脂本取前八十回与判词、批语透露的去向。
   三、风波：一百二十回画成一根尺，几场大闹按回落在尺上；底下是一幅从右往左展开的手卷，一场一段，竖写。 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PersonLink from '../components/PersonLink.astro';
import { LOVES, FEUDS } from '../data/loves.ts';
import { cn } from '../lib/data.ts';

/* 回目里的“第十一至十二回”取第一个回数，用来排序和落在尺上 */
const DIGIT: Record<string, number> = { 一: 1, 二: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9 };
const firstHui = (s: string) => {
  const m = /第([一二三四五六七八九十百]+)/.exec(s);
  if (!m) return 120;
  let n = 0, cur = 0;
  for (const c of m[1]) { if (c === '十') { n += (cur || 1) * 10; cur = 0; } else if (c === '百') { n += (cur || 1) * 100; cur = 0; } else cur = DIGIT[c] ?? 0; }
  return n + cur;
};
const feuds = [...FEUDS].sort((a, b) => firstHui(a.ch) - firstHui(b.ch)).map((f, i) => ({ ...f, n: firstHui(f.ch), i }));

/* 六司：书里只写了匾名，哪段情缘挂哪一司是这里的分法 */
const SI: { name: string; titles: string[] }[] = [
  { name: '痴情司', titles: ['木石前盟', '画蔷', '鸳鸯剑', '园中私情'] },
  { name: '結怨司', titles: ['琏凤之家'] },
  { name: '朝啼司', titles: ['中山狼', '妻妾之祸'] },
  { name: '夜怨司', titles: ['金玉良缘', '水月庵之私'] },
  { name: '春感司', titles: ['拾帕传情', '典衣之缘', '汗巾之约', '回头一顾'] },
  { name: '秋悲司', titles: ['远嫁海疆', '金麒麟伏白首双星', '佛手与柚子'] }
];
const byTitle = new Map(LOVES.map(l => [l.title, l]));
const lineHref = (ids: string[]) => ids.length > 1 ? `/graph/?from=${encodeURIComponent(ids[0])}&to=${encodeURIComponent(ids[1])}` : `/graph/?focus=${encodeURIComponent(ids[0])}`;

/* 两支曲子，一句一行 */
const WANG = ['一个是阆苑仙葩，', '一个是美玉无瑕。', '若说没奇缘，', '今生偏又遇着他；', '若说有奇缘，', '如何心事终虚化？', '一个枉自嗟呀，', '一个空劳牵挂。', '一个是水中月，', '一个是镜中花。', '想眼中能有多少泪珠儿，', '怎经得秋流到冬尽，', '春流到夏！'];
const ZHONG = ['都道是金玉良姻，', '俺只念木石前盟。', '空对着，', '山中高士晶莹雪；', '终不忘，', '世外仙姝寂寞林。', '叹人间，', '美中不足今方信。', '纵然是齐眉举案，', '到底意难平。'];
/* 曲中要紧的几个字加朱圈 */
const ring = (line: string, key: string) => {
  const i = line.indexOf(key);
  return i < 0 ? [{ t: line, k: false }] : [{ t: line.slice(0, i), k: false }, { t: key, k: true }, { t: line.slice(i + key.length), k: false }];
};
const RING_W = ['泪珠儿', '水中月', '镜中花'];
const RING_Z = ['木石前盟', '意难平'];
const marked = (lines: string[], keys: string[]) => lines.map(l => ring(l, keys.find(k => l.includes(k)) ?? '\u0000'));
---
<Base title="情缘与风波" description="《红楼梦》里的木石前盟与金玉良缘，太虚幻境六司底下的十六段情缘，以及贾府里的几场大风波。结局可在脂本与续书之间切换。" section="relations" sub="love">
  <div class="wrap">
    <PageHead title="情缘与风波" slip="情緣" quote="厚地高天，堪叹古今情不尽｜痴男怨女，可怜风月债难偿" from="第五回　孽海情天" />

    <!-- 一、两盟 -->
    <section class="pacts" aria-label="木石前盟与金玉良缘">
      <article class="pact mu reveal">
        <svg class="pact-art" viewBox="0 0 200 170" aria-hidden="true">
          <path class="water" d="M8 152q15-6 30 0t30 0 30 0 30 0 30 0 30 0M24 161q15-5 30 0t30 0 30 0 30 0 30 0" />
          <path class="stone" d="M40 148C30 120 44 92 70 84c16-14 42-12 54 2 18 6 26 32 16 62Z" />
          <path class="cun" d="M62 100c8 6 10 16 6 26M100 92c-4 10 0 22 10 30M120 110c4 8 2 18-4 26M80 118c6 4 8 12 6 20" />
          <path class="grass" d="M156 150c-2-30-6-54-16-80M158 150c4-32 12-52 24-70M157 150c1-26 1-50 3-90M155 150c-6-18-14-30-24-38" />
          <circle class="zhu" cx="140" cy="70" r="3.8" /><circle class="zhu" cx="160" cy="59" r="4.2" /><circle class="zhu" cx="182" cy="80" r="3.6" /><circle class="zhu" cx="131" cy="112" r="3" />
        </svg>
        <h2>木石前盟</h2>
        <p class="pact-src">绛珠仙草　神瑛侍者</p>
        <div class="qu" lang="zh-Hant">
          <small>枉凝眉</small>
          {marked(WANG, RING_W).map(l => <span>{l.map(s => s.k ? <em>{s.t}</em> : s.t)}</span>)}
        </div>
        <blockquote class="said">“他既下世为人，我也去下世为人，但把我一生所有的眼泪还他，也偿还得过他了。”<cite>第一回</cite></blockquote>
      </article>

      <div class="pact-fold" aria-hidden="true"></div>

      <article class="pact jin reveal" style="--d:.15s">
        <svg class="pact-art" viewBox="0 0 280 170" aria-hidden="true">
          <defs>
            <radialGradient id="jade" cx="40%" cy="35%" r="70%"><stop offset="0" stop-color="#f7f8ee" /><stop offset=".55" stop-color="#d6e1cc" /><stop offset="1" stop-color="#a7bda3" /></radialGradient>
            <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f3dea2" /><stop offset=".5" stop-color="#cfa04c" /><stop offset="1" stop-color="#9c7028" /></linearGradient>
          </defs>
          <g transform="translate(20 0)">
            <path class="cord" d="M52 2c-3 12 2 22 8 26 6-4 11-14 8-26" />
            <ellipse class="jade" cx="60" cy="98" rx="44" ry="62" />
            <path class="glint" d="M34 60c6-10 16-16 28-18M30 84c2-6 5-10 9-13" />
            <text class="ins-j">{[...'莫失莫忘'].map((c, i) => <tspan x="70" y={74 + i * 19}>{c}</tspan>)}{[...'仙壽恆昌'].map((c, i) => <tspan x="50" y={74 + i * 19}>{c}</tspan>)}</text>
          </g>
          <g transform="translate(140 0)">
            <path class="chain" d="M30 2 44 48M110 2 96 48" />
            <path class="lock" d="M30 52q40-22 80 0 18 8 14 32-4 34-28 52-14 10-26 24-12-14-26-24-24-18-28-52-4-24 14-32Z" />
            <path class="lock-in" d="M36 60q34-18 68 0 12 6 9 26-3 26-21 42-12 9-22 20-10-11-22-20-18-16-21-42-3-20 9-26Z" />
            <text class="ins-l">{[...'不離不棄'].map((c, i) => <tspan x="80" y={78 + i * 17}>{c}</tspan>)}{[...'芳齡永繼'].map((c, i) => <tspan x="60" y={78 + i * 17}>{c}</tspan>)}</text>
          </g>
        </svg>
        <h2>金玉良緣</h2>
        <p class="pact-src">通灵宝玉　金锁</p>
        <div class="qu" lang="zh-Hant">
          <small>终身误</small>
          {marked(ZHONG, RING_Z).map(l => <span>{l.map(s => s.k ? <em>{s.t}</em> : s.t)}</span>)}
        </div>
        <blockquote class="said">“我听这两句话，倒像和姑娘的项圈上的两句话是一对儿。”<cite>第八回　莺儿</cite></blockquote>
      </article>
    </section>

    <section class="trio reveal" aria-label="黛玉、宝玉、宝钗">
      <svg class="trio-th" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
        <path class="th-lv" d="M108 40C170 4 240 4 284 34" />
        <path class="th-m" d="M316 34C360 4 430 4 492 40" />
      </svg>
      <span class="ttag ttag-l">知己</span>
      <span class="ttag ttag-r">夫妻</span>
      <a class="qian" href="/people/林黛玉/" data-peek><b>林黛玉</b><i>淚盡</i></a>
      <a class="qian mid" href="/people/贾宝玉/" data-peek><b>賈寶玉</b><i>懸崖撒手</i></a>
      <a class="qian" href="/people/薛宝钗/" data-peek><b>薛寶釵</b><i>金簪雪裏埋</i></a>
      <blockquote class="trio-pi">“若他人得宝钗之妻、麝月之婢，岂能弃而为僧哉？”<cite>第二十一回　庚辰夹批</cite></blockquote>
    </section>

    <!-- 二、六司 -->
    <section class="si-wrap" aria-labelledby="si-h">
      <header class="sh reveal">
        <h2 id="si-h">六司</h2>
        <p>惟见几处写的是：痴情司、结怨司、朝啼司、夜怨司、春感司、秋悲司。<cite>第五回</cite></p>
      </header>
      <div class="plaques reveal" role="tablist" aria-label="六司">
        {SI.map((s, i) => (
          <button type="button" role="tab" class="plaque" id={`si-t${i}`} aria-controls={`si-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-si={i}>
            <span>{s.name}</span>
          </button>
        ))}
      </div>
      <div class="ver reveal" role="group" aria-label="结局照哪个本子">
        <span class="ver-l">结局照</span>
        <button type="button" data-ver="zhi" aria-pressed="true">脂本</button>
        <button type="button" data-ver="xu" aria-pressed="false">续书</button>
      </div>
      <div class="panes" data-panes data-ver="zhi">
        {SI.map((s, i) => (
          <div class="pane" role="tabpanel" id={`si-p${i}`} aria-labelledby={`si-t${i}`} hidden={i !== 0}>
            {s.titles.map(t => byTitle.get(t)!).map((l, j) => (
              <article class="ce" style={`--j:${j}`}>
                <header class="ce-h">
                  <h3>{l.title}</h3>
                  <span class:list={['ce-end', `e-${l.end}`]} title={{ 悲: '悲', 喜: '喜', 另: '未定' }[l.end]}>{l.end === '另' ? '未' : l.end}</span>
                </header>
                <div class="ce-b">
                  <p class="ce-who">{l.ids.map(id => <PersonLink id={id} />)}</p>
                  <p class="ce-t">{l.text}</p>
                  <div class="ce-out spoil" data-ch="81">
                    <div class="spoil-body">
                      <p class="v-zhi"><b>后来</b>{l.out}</p>
                      <p class="v-xu"><b>后来</b>{l.xu ?? '续书没有另写，照前八十回。'}</p>
                    </div>
                  </div>
                  <a class="ce-line" href={lineHref(l.ids)}>在关系图上牵线</a>
                </div>
              </article>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- 三、风波 -->
    <section class="feud-wrap" aria-labelledby="fe-h">
      <header class="sh reveal">
        <h2 id="fe-h">風波</h2>
        <p>必须先从家里自杀自灭起来，才能一败涂地！<cite>第七十四回　探春</cite></p>
      </header>
      <div class="ruler reveal" aria-label="一百二十回里的风波">
        <div class="ruler-line">
          {Array.from({ length: 12 }, (_, k) => <span class="tick" style={`--x:${(k * 10) / 119}`}><i>{k ? cn(k * 10) : '一'}</i></span>)}
          <span class="eighty" style={`--x:${80 / 119}`} title="前八十回到此"></span>
          {feuds.map(f => (
            <button type="button" class="mark" style={`--x:${(f.n - 1) / 119}`} data-go={f.i} aria-label={`${f.title}，${f.ch}`}><i></i><span>{f.title}</span></button>
          ))}
        </div>
      </div>
      <div class="scroll vt reveal" data-scroll tabindex="0" aria-label="风波手卷，从右往左读">
        <div class="scroll-in">
          {feuds.map(f => (
            <article class="fe spoil" data-ch={f.n} data-fe={f.i} id={`fe-${f.i}`}>
              <div class="spoil-body">
                <p class="fe-ch">{f.ch}</p>
                <h3>{f.title}</h3>
                <p class="fe-hui">{f.hui}</p>
                <p class="fe-t">{f.text}</p>
                <p class="fe-who">{f.ids.map(id => <PersonLink id={id} />)}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  /* 六司的匾：点哪块，底下换成哪一司 */
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-si]')];
  const panes = [...document.querySelectorAll<HTMLElement>('.pane')];
  const pick = (i: number, focus = false) => {
    tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
    panes.forEach((p, k) => { p.hidden = k !== i; });
    if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => pick(i));
    t.addEventListener('keydown', e => {
      /* 匾从右往左挂，左右键也照这个方向走 */
      if (e.key === 'ArrowLeft') { e.preventDefault(); pick((i + 1) % tabs.length, true); }
      if (e.key === 'ArrowRight') { e.preventDefault(); pick((i - 1 + tabs.length) % tabs.length, true); }
    });
  });

  /* 结局照脂本还是续书 */
  const box = document.querySelector<HTMLElement>('[data-panes]')!;
  const vers = [...document.querySelectorAll<HTMLButtonElement>('[data-ver]')].filter(b => b.tagName === 'BUTTON');
  vers.forEach(b => b.addEventListener('click', () => {
    box.dataset.ver = b.dataset.ver!;
    vers.forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  }));

  /* 尺上点一场风波，手卷卷到那一段；手卷卷动时，尺上跟着亮起正当中那一场 */
  const scroll = document.querySelector<HTMLElement>('[data-scroll]')!;
  const marks = [...document.querySelectorAll<HTMLButtonElement>('.mark')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-fe]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  marks.forEach(m => m.addEventListener('click', () => {
    const el = items[+m.dataset.go!];
    const r = el.getBoundingClientRect(), s = scroll.getBoundingClientRect();
    scroll.scrollBy({ left: r.left + r.width / 2 - (s.left + s.width / 2), behavior: reduced ? 'auto' : 'smooth' });
  }));
  const light = () => {
    const s = scroll.getBoundingClientRect();
    const mid = s.left + s.width / 2;
    let best = 0, d = Infinity;
    items.forEach((el, i) => { const r = el.getBoundingClientRect(); const dd = Math.abs(r.left + r.width / 2 - mid); if (dd < d) { d = dd; best = i; } });
    marks.forEach((m, i) => m.classList.toggle('on', i === best));
  };
  scroll.addEventListener('scroll', () => requestAnimationFrame(light), { passive: true });
  light();
</script>

<style>
  /* ---------- 两盟 ---------- */
  .pacts { display: grid; grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr); gap: 0 clamp(24px, 4vw, 64px); padding: clamp(20px, 3vw, 40px) 0 clamp(60px, 8vw, 100px); }
  /* 木石在右，金玉在左，照竖排书的先后 */
  .mu { grid-column: 3; grid-row: 1; }
  .jin { grid-column: 1; grid-row: 1; }
  .pact-fold { grid-column: 2; grid-row: 1; background: linear-gradient(transparent, var(--line-2) 15%, var(--line-2) 85%, transparent); }
  .pact { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pact-art { width: min(100%, 260px); height: 150px; overflow: visible; }
  .water { fill: none; stroke: #6f8797; stroke-width: 1; opacity: .45; }
  .stone { fill: color-mix(in srgb, var(--paper) 70%, #d9cfba); stroke: var(--ink); stroke-width: 1.3; stroke-linejoin: round; }
  .cun { fill: none; stroke: var(--ink); stroke-width: .8; opacity: .55; stroke-linecap: round; }
  .grass { fill: none; stroke: #55704a; stroke-width: 1.4; stroke-linecap: round; }
  .zhu { fill: var(--cinnabar); }
  .cord { fill: none; stroke: var(--cinnabar); stroke-width: 2.2; stroke-linecap: round; }
  .jade { fill: url(#jade); stroke: #87a08a; stroke-width: .9; }
  .glint { fill: none; stroke: #fff; stroke-width: 1.6; opacity: .7; stroke-linecap: round; }
  .ins-j, .ins-l { font: 400 15px/1 var(--title); text-anchor: middle; }
  .ins-j { fill: #3d5a45; }
  .ins-l { fill: #5a3e12; font-size: 14px; }
  .chain { fill: none; stroke: #b48a33; stroke-width: 2; stroke-dasharray: 3 2.4; }
  .lock { fill: url(#gold); stroke: #8a6424; stroke-width: 1; }
  .lock-in { fill: none; stroke: #fff3c8; stroke-width: .9; opacity: .65; }
  .pact h2 { margin-top: 26px; font: 400 clamp(30px, 3vw, 38px)/1.1 var(--title); letter-spacing: .3em; padding-left: .3em; }
  .mu h2 { color: var(--cinnabar); }
  .pact-src { margin-top: 12px; font-size: 14px; letter-spacing: .3em; color: var(--ink-3); }
  /* 曲子竖写，一句一行，从右往左读；曲名落在最右 */
  .qu { margin-top: 34px; writing-mode: vertical-rl; font: 400 19px/2 var(--title); letter-spacing: .14em; color: var(--ink); text-align: start; }
  .qu span { display: block; }
  /* 曲子分两层：前一句顶格，后一句低一格，像刻本里的唱词 */
  .qu span:nth-of-type(2n) { padding-block-start: 1em; }
  .qu em { font-style: normal; text-emphasis: open circle var(--cinnabar); -webkit-text-emphasis: open circle var(--cinnabar); text-emphasis-position: right; -webkit-text-emphasis-position: right; }
  .qu small { display: block; margin-left: 14px; font: 400 15px/2 var(--title); letter-spacing: .5em; color: var(--cinnabar); }
  .said { margin: 34px 0 0; max-width: 24em; font: 400 15.5px/2 var(--serif); color: var(--ink-2); text-wrap: balance; }
  .said cite, .trio-pi cite, .sh cite { display: block; margin-top: 8px; font: 400 14px/1 var(--title); font-style: normal; letter-spacing: .3em; color: var(--ink-3); }

  /* ---------- 三人：三枚签，红丝牵着 ---------- */
  .trio { position: relative; display: grid; grid-template-columns: repeat(3, auto); justify-content: center; column-gap: clamp(90px, 14vw, 190px); row-gap: 40px; padding-bottom: clamp(70px, 9vw, 120px); }
  .trio-th { position: absolute; left: 50%; top: -10px; width: min(100%, 640px); height: 110px; translate: -50% 0; overflow: visible; pointer-events: none; }
  .trio-th path { fill: none; stroke-width: 2; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .th-lv { stroke: #c95a4a; }
  .th-m { stroke: #b02d22; stroke-dasharray: 1 0; }
  .ttag { position: absolute; top: -12px; font: 400 16px/1 var(--title); letter-spacing: .4em; color: var(--cinnabar); }
  .ttag-l { right: calc(50% + 120px); }
  .ttag-r { left: calc(50% + 120px); }
  .qian { position: relative; display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 22px 12px 18px; width: 64px; background: #f8f1df; color: #241b14; box-shadow: 0 0 0 1px #c4ae86, 0 10px 24px -14px rgb(40 26 10 / .5); transition: transform .5s var(--ease); }
  .qian::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 5px; background: var(--cinnabar); opacity: .85; }
  .qian b { writing-mode: vertical-rl; font: 400 26px/1 var(--title); letter-spacing: .2em; }
  .qian i { writing-mode: vertical-rl; font: 400 14px/1 var(--title); font-style: normal; letter-spacing: .3em; color: var(--cinnabar); }
  .qian.mid { transform: translateY(18px); }
  .qian:hover { transform: translateY(-4px); }
  .qian.mid:hover { transform: translateY(14px); }
  .trio-pi { grid-column: 1 / -1; justify-self: center; margin: 30px 0 0; text-align: center; font: 400 17px/2 var(--title); letter-spacing: .1em; color: var(--cinnabar); }

  /* ---------- 小节标题 ---------- */
