---
/* 一个人的亲友罗盘：本人居中，里圈按关系类别分成几段，亲友按类别排在外圈，名字顺着半径写。
   名字的写法看它在哪个方位：左右两边横着念，上下两边竖着念，字身最多斜四十五度，不会倒过来。
   每个人占一片扇形，鼠标落在扇形里任何地方都算指着他，中心改写成他和本人的关系。 */
import { tiesOf, byId, TYPE_ORDER, REL_TYPES, RANK, type RelType } from '../lib/data.ts';
interface Props { id: string }
const { id } = Astro.props;
const me = byId.get(id)!;
const ties = tiesOf(id)
  .filter(t => byId.has(t.other))
  .sort((a, b) => TYPE_ORDER.indexOf(a.type) - TYPE_ORDER.indexOf(b.type) || RANK[byId.get(a.other)!.tier] - RANK[byId.get(b.other)!.tier]);
const n = ties.length;
const usedTypes = TYPE_ORDER.filter(t => ties.some(x => x.type === t));

const S = 800, C = S / 2;
const R0 = 66, B0 = 94, B1 = 122, RD = 226, RL = 242;
const deg = (a: number) => (a * 180) / Math.PI;
const P = (r: number, a: number) => [C + Math.cos(a) * r, C + Math.sin(a) * r];
const f = (v: number) => +v.toFixed(1);
/* 每类之间留一道空，剩下的角度按人数平分 */
const gap = usedTypes.length > 1 ? (n > 30 ? 3 : 6) * (Math.PI / 180) : 0;
const slot = (Math.PI * 2 - gap * usedTypes.length) / Math.max(n, 1);
const fs = Math.max(13, Math.min(19, RL * slot * .64));
const step = fs * 1.06;

/* 一段环形扇区的路径 */
const sector = (r0: number, r1: number, a0: number, a1: number) => {
  const [x0, y0] = P(r1, a0), [x1, y1] = P(r1, a1), [x2, y2] = P(r0, a1), [x3, y3] = P(r0, a0);
  const big = a1 - a0 > Math.PI ? 1 : 0;
  return `M${f(x0)},${f(y0)}A${r1},${r1} 0 ${big} 1 ${f(x1)},${f(y1)}L${f(x2)},${f(y2)}A${r0},${r0} 0 ${big} 0 ${f(x3)},${f(y3)}Z`;
};

let a = -Math.PI / 2 - (n === 1 ? slot / 2 : 0);
const sectors: { t: RelType; a0: number; a1: number; path: string; label: string }[] = [];
const nodes: (ReturnType<typeof tiesOf>[number] & { p: NonNullable<ReturnType<typeof byId.get>>; a: number; dot: number[]; line: string; hit: string; glyphs: { ch: string; x: number; y: number; r: number }[] })[] = [];
for (const t of usedTypes) {
  const list = ties.filter(x => x.type === t);
  const a0 = a;
  for (const tie of list) {
    const am = a + slot / 2;
    const p = byId.get(tie.other)!;
    const name = [...tie.other];
    const cos = Math.cos(am), sin = Math.sin(am);
    /* 左右两边横排，上下两边竖排；念的方向在屏幕上总是往右或往下 */
    const outward = Math.abs(cos) >= Math.abs(sin) ? cos > 0 : sin > 0;
    const rot = Math.abs(cos) >= Math.abs(sin) ? (cos > 0 ? deg(am) : deg(am) + 180) : (sin > 0 ? deg(am) - 90 : deg(am) + 90);
    const glyphs = name.map((ch, k) => {
      const d = RL + ((outward ? k : name.length - 1 - k) + .5) * step;
      const [x, y] = P(d, am);
      return { ch, x: f(x), y: f(y), r: f(rot) };
    });
    const [lx0, ly0] = P(B1 + 4, am), [lx1, ly1] = P(RD - 9, am);
    nodes.push({
      ...tie, p, a: am, dot: P(RD, am).map(f),
      line: `M${f(lx0)},${f(ly0)}L${f(lx1)},${f(ly1)}`,
      hit: sector(B1, RL + name.length * step + 8, a, a + slot),
      glyphs
    });
    a += slot;
  }
  /* 类别名写在里圈这一段的正中，弧太短就不写，靠悬停看 */
  const a1 = a;
  const mid = (a0 + a1) / 2, rb = (B0 + B1) / 2;
  const fits = (a1 - a0) * rb > REL_TYPES[t].name.length * 21 + 10;
  let label = '';
  if (fits) {
    /* 下半圈的弧反着走，字才是正的 */
    const bottom = Math.sin(mid) > 0;
    const [sx, sy] = P(rb, bottom ? a1 : a0), [ex, ey] = P(rb, bottom ? a0 : a1);
    label = `M${f(sx)},${f(sy)}A${rb},${rb} 0 ${a1 - a0 > Math.PI ? 1 : 0} ${bottom ? 0 : 1} ${f(ex)},${f(ey)}`;
  }
  sectors.push({ t, a0, a1, path: sector(B0, B1, a0 + .004, a1 - .004), label });
  a += gap;
}
/* 线的颜色和关系图的丝线一致：婚配情缘红丝，血亲墨线，姻亲淡墨，主仆麻线，交游青线，恩怨黛色，前世金线 */
const typeColor: Record<RelType, string> = { b: '#2b221b', m: '#b02d22', lv: '#c95a4a', in: '#7d6c58', sv: '#a8895a', fr: '#3f7a70', ri: '#3f4c78', my: '#b48a33' };
const capSize = (s: string, max: number) => Math.min(max, 112 / [...s].length);
const uid = `eg${Math.abs([...id].reduce((h, c) => (h * 31 + c.codePointAt(0)!) | 0, 7))}`;
---
{n > 0 && (
<figure class="ego reveal" data-scroll-start="center">
  <svg viewBox={`0 0 ${S} ${S}`} role="img" aria-label={`${id}的亲友，共${n}人`}>
    <defs>
      {sectors.filter(s => s.label).map(s => <path id={`${uid}-${s.t}`} d={s.label} />)}
    </defs>
    <circle cx={C} cy={C} r={RD} class="ring" />
    <circle cx={C} cy={C} r={B1 + 22} class="ring faint" />
    <g class="me">
      <circle cx={C} cy={C} r={R0} style={`fill:var(--g-${me.group})`} filter="url(#rough)" />
      <text x={C} y={C} class="me-t" style={`font-size:${capSize(id, 30)}px`}>{id}</text>
    </g>
    {sectors.map(s => (
      <g class={`sec t-${s.t}`} style={`--tc:${typeColor[s.t]}`}>
        <path d={s.path} class="band" />
        {s.label && <text class="sec-t"><textPath href={`#${uid}-${s.t}`} startOffset="50%">{REL_TYPES[s.t].name}</textPath></text>}
        <title>{REL_TYPES[s.t].name}</title>
      </g>
    ))}
    {nodes.map((nd, i) => (
      <a href={`/people/${nd.other}/`} class={`nd t-${nd.type}`} style={`--tc:${typeColor[nd.type]};--gc:var(--g-${nd.p.group});--i:${i}`} data-peek aria-label={`${nd.other}，${nd.role}`}>
        <path d={nd.hit} class="hit" />
        <path d={nd.line} class="ln" stroke-dasharray={REL_TYPES[nd.type].dash || undefined} />
        <circle cx={nd.dot[0]} cy={nd.dot[1]} r={nd.p.tier === 'c' ? 6.5 : 4.5} class="dot" />
        <g class="nm" style={`font-size:${f(fs)}px`}>
          {nd.glyphs.map(g => <text x={g.x} y={g.y} transform={g.r ? `rotate(${g.r} ${g.x} ${g.y})` : undefined}>{g.ch}</text>)}
        </g>
        <g class="cap" aria-hidden="true">
          <text x={C} y={C - 9} class="cap-n" style={`font-size:${capSize(nd.other, 28)}px`}>{nd.other}</text>
          <text x={C} y={C + 22} class="cap-r">{nd.role.length > 7 ? nd.role.slice(0, 7) : nd.role}</text>
        </g>
      </a>
    ))}
  </svg>
</figure>
)}

<style>
  .ego { margin: 0; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; }
  /* 窄屏上名字缩得太小就看不清，宁可横着滚 */
  .ego svg { display: block; width: 100%; min-width: 560px; height: auto; }
  .ring { fill: none; stroke: var(--line-2); stroke-width: 1; }
  .ring.faint { stroke: var(--line); stroke-dasharray: 1 5; }
  .me-t, .cap text { text-anchor: middle; dominant-baseline: central; font-family: var(--display); }
  .me-t { fill: #fff8ec; transition: opacity .2s; }
  .band { fill: var(--tc); opacity: .12; transition: opacity .25s; }
  .sec-t { font: 400 16px var(--title); letter-spacing: .3em; fill: var(--tc); dominant-baseline: central; text-anchor: middle; pointer-events: none; }
  .sec { cursor: default; }
  .sec:hover .band { opacity: .3; }
  .hit { fill: transparent; }
  .ln { fill: none; stroke: var(--tc); stroke-width: 1.1; opacity: .5; transition: opacity .25s, stroke-width .25s; }
  .dot { fill: var(--gc); transition: r .25s; }
  .nm text { font-family: var(--title); fill: var(--ink); text-anchor: middle; dominant-baseline: central; transition: fill .2s; }
  .cap { opacity: 0; pointer-events: none; transition: opacity .2s; }
  .cap-n { fill: #fff8ec; }
  .cap-r { font: 400 14px var(--serif); fill: rgb(255 248 236 / .82); }
  .nd { transition: opacity .25s; outline: none; }
  .nd:is(:hover, :focus-visible) .ln { opacity: 1; stroke-width: 2; }
  .nd:is(:hover, :focus-visible) .nm text { fill: var(--cinnabar); }
  .nd:is(:hover, :focus-visible) .cap { opacity: 1; }
  .ego svg:has(.nd:is(:hover, :focus-visible)) .me-t { opacity: 0; }
  .ego svg:has(.nd:is(:hover, :focus-visible)) .nd:not(:hover, :focus-visible) { opacity: .26; }
  .ego:has(.sec.t-b:hover) .nd:not(.t-b), .ego:has(.sec.t-m:hover) .nd:not(.t-m), .ego:has(.sec.t-in:hover) .nd:not(.t-in),
  .ego:has(.sec.t-sv:hover) .nd:not(.t-sv), .ego:has(.sec.t-lv:hover) .nd:not(.t-lv), .ego:has(.sec.t-fr:hover) .nd:not(.t-fr),
  .ego:has(.sec.t-ri:hover) .nd:not(.t-ri), .ego:has(.sec.t-my:hover) .nd:not(.t-my) { opacity: .15; }
  :global([data-theme="dark"]) .ego .t-b, :global([data-theme="dark"]) .ego .sec.t-b { --tc: #cdbfa8; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .ego .t-b { --tc: #cdbfa8; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .ego.in .nd { animation: pop .7s var(--ease) backwards; animation-delay: calc(150ms + var(--i) * 18ms); }
  }
  @keyframes pop { from { opacity: 0; } }
</style>
