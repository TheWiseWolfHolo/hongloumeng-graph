---
/* 一百二十回里的身影，和首页的年表一个画法：右起第一回，每回一格，提到他就点一个墨点，提到越多点越大；
   十回一道界栏，后四十回是续书，墨淡。点到哪一格就进哪一回。 */
import { MENTIONS, cn, chapter } from '../lib/data.ts';
interface Props { id: string; color?: string }
const { id, color = 'var(--ink)' } = Astro.props;
const m = MENTIONS[id] ?? new Array(120).fill(0);
const max = Math.max(1, ...m);
const W = 1200, TOP = 26, ROW = 44, H = TOP + ROW;
const CW = W / 120;
const cx = (n: number) => W - (n - .5) * CW;
const f = (v: number) => +v.toFixed(1);
const cells = m.map((v, i) => ({ n: i + 1, v, r: v ? f(Math.max(1.2, Math.sqrt(v / max) * CW * .7)) : 0 }));
const peak = cells.reduce((a, b) => (b.v > a.v ? b : a), cells[0]);
---
<figure class="strip" style={`--c:${color}`}>
  <div class="strip-box" data-scroll-start="end">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${id}在一百二十回里被提到的次数，最多的是${chapter(peak.n).cn}，${cn(peak.v)}次`}>
    <rect class="xu-bg" x="0" y={TOP} width={CW * 40} height={ROW} />
    <line class="rule" x1="0" x2={W} y1={TOP} y2={TOP} />
    <line class="rule" x1="0" x2={W} y1={H} y2={H} />
    {Array.from({ length: 11 }, (_, i) => (i + 1) * 10).map(n => <line class:list={['rule', { eighty: n === 80 }]} x1={f(cx(n) - CW / 2)} x2={f(cx(n) - CW / 2)} y1={TOP - 6} y2={H} />)}
    {[1, 20, 40, 60, 80, 100].map(n => <text class="tk" x={f(cx(n))} y={TOP - 10}>{cn(n)}</text>)}
    {cells.map(c => (
      <a href={`/chapters/${c.n}/`} class:list={['cell', { xu: c.n > 80 }]} aria-label={`${chapter(c.n).cn}，提到${cn(c.v)}次`}>
        <title>{`${chapter(c.n).cn}　${chapter(c.n).title.join(' ')}　${c.v ? `提到${cn(c.v)}次` : '未提到'}`}</title>
        <rect class="hit" x={f(cx(c.n) - CW / 2)} y={TOP} width={f(CW)} height={ROW} />
        {c.v ? <circle cx={f(cx(c.n))} cy={TOP + ROW / 2} r={c.r} /> : <circle class="none" cx={f(cx(c.n))} cy={TOP + ROW / 2} r=".8" />}
      </a>
    ))}
  </svg>
  </div>
  <figcaption><span>右起前八十回</span><span>左边四十回是续书，墨淡</span></figcaption>
</figure>

<style>
  .strip { margin: 0; }
  .strip-box { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; padding-top: 4px; }
  .strip svg { display: block; width: 100%; min-width: 720px; height: auto; overflow: visible; }
  .rule { stroke: color-mix(in srgb, var(--cinnabar) 30%, transparent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .rule.eighty { stroke: color-mix(in srgb, var(--cinnabar) 55%, transparent); stroke-dasharray: 3 3; }
  .xu-bg { fill: color-mix(in srgb, var(--ink) 3%, transparent); }
  .tk { font: 400 13px var(--title); fill: var(--ink-3); text-anchor: middle; }
  .hit { fill: transparent; }
  .cell circle { fill: var(--c); transition: fill .2s; }
  .cell.xu circle { opacity: .35; }
  .cell circle.none { fill: var(--ink-4); opacity: .5; }
  .cell:hover circle, .cell:focus-visible circle { fill: var(--cinnabar); opacity: 1; }
  .cell:hover .hit { fill: color-mix(in srgb, var(--cinnabar) 7%, transparent); }
  .strip figcaption { display: flex; flex-direction: row-reverse; justify-content: space-between; margin-top: 10px; font: 400 13px/1.6 var(--title); letter-spacing: .2em; color: var(--ink-3); }
</style>
