---
/* 一百二十回谁在场，照《史记》年表的样子画：人名列在右边，回次从右往左排，
   每一格点一个墨点，这一回提到他越多，墨点越大；后四十回是续书，墨色淡下去。
   十回一道界栏，顶上标回次。指着一行，这一行转成朱色，底下写出他前八十回提到多少次、哪一回最多。 */
import { MENTIONS, STATS, byId, cn } from '../lib/data.ts';
interface Props { count?: number }
const { count = 14 } = Astro.props;
const ids = Object.entries(STATS.totals)
  .filter(([id]) => byId.get(id)!.tier !== 'o')
  .sort((a, b) => b[1] - a[1])
  .slice(0, count)
  .map(([id]) => id);
const N = 120, NAME = 84, TOP = 30, ROW = 28, W = 1200;
const CW = (W - NAME - 6) / N;
const H = TOP + ids.length * ROW + 6;
/* 第 n 回在第几格：第一回贴着人名，往左排 */
const cx = (n: number) => W - NAME - 6 - (n - .5) * CW;
const vmax = Math.max(...ids.flatMap(id => MENTIONS[id]));
const f = (v: number) => +v.toFixed(1);
const rows = ids.map((id, i) => {
  const m = MENTIONS[id];
  const y = TOP + (i + .5) * ROW;
  const dots = m.map((v, k) => (v > 0 ? { x: f(cx(k + 1)), r: f(Math.max(.9, Math.sqrt(v / vmax) * CW * .62)), xu: k >= 80 } : null)).filter(Boolean) as { x: number; r: number; xu: boolean }[];
  const peak = m.slice(0, 80).reduce((b, v, k) => (v > m[b] ? k : b), 0) + 1;
  return { id, y, dots, total: STATS.totals[id], peak };
});
const tens = Array.from({ length: 12 }, (_, i) => (i + 1) * 10);
---
<figure class="nianbiao reveal">
  <div class="nb-box">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`原文提到最多的${count}个人在一百二十回里各回被提到的多少`}>
      <rect class="xu-bg" x={f(cx(120) - CW / 2)} y={TOP} width={f(CW * 40)} height={H - TOP - 6} />
      <g class="grid">
        <line x1="0" x2={W} y1={TOP} y2={TOP} />
        <line x1="0" x2={W} y1={H - 6} y2={H - 6} />
        <line x1={W - NAME} x2={W - NAME} y1="0" y2={H - 6} />
        {tens.slice(0, -1).map(n => <line x1={f(cx(n) - CW / 2)} x2={f(cx(n) - CW / 2)} y1={TOP - 8} y2={H - 6} class:list={{ eighty: n === 80 }} />)}
      </g>
      <g class="hd">
        {[1, ...tens.slice(0, -1)].map(n => <text x={f(cx(n))} y={TOP - 12} text-anchor="middle">{cn(n)}</text>)}
      </g>
      {rows.map((r, i) => (
        <a href={`/people/${r.id}/`} class="row" style={`--i:${i}`} aria-label={`${r.id}，前八十回提到${r.total}次`}>
          <rect class="hit" x="0" y={r.y - ROW / 2} width={W} height={ROW} />
          <text class="nm" x={W - NAME / 2} y={r.y}>{r.id}</text>
          {r.dots.map(d => <circle cx={d.x} cy={r.y} r={d.r} class:list={{ xu: d.xu }} />)}
          <text class="cap" x={W - NAME - 14} y={H + 22}>{`${r.id}　前八十回提到${cn(r.total)}次，第${cn(r.peak)}回最多`}</text>
        </a>
      ))}
    </svg>
  </div>
  <p class="nb-note" aria-hidden="true"><span>右起第一回</span><span>左边四十回是续书，墨淡</span></p>
</figure>

<style>
  .nianbiao { margin: 0; }
  .nb-box { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .nianbiao svg { display: block; width: 100%; min-width: 760px; height: auto; overflow: visible; margin-bottom: 30px; }
  .xu-bg { fill: color-mix(in srgb, var(--ink) 3%, transparent); }
  .grid line { stroke: color-mix(in srgb, var(--cinnabar) 30%, transparent); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .grid line.eighty { stroke: color-mix(in srgb, var(--cinnabar) 55%, transparent); stroke-dasharray: 3 3; }
  .hd text { font: 400 12px var(--title); fill: var(--ink-3); letter-spacing: .05em; }
  .hit { fill: transparent; }
  .nm { font: 400 15px var(--title); fill: var(--ink); text-anchor: middle; dominant-baseline: central; letter-spacing: .12em; transition: fill .25s; }
  .row circle { fill: var(--ink); opacity: .82; transition: fill .25s, opacity .25s; }
  .row circle.xu { opacity: .3; }
  .row:hover circle, .row:focus-visible circle { fill: var(--cinnabar); opacity: 1; }
  .row:hover circle.xu, .row:focus-visible circle.xu { opacity: .45; }
  .row:hover .nm, .row:focus-visible .nm { fill: var(--cinnabar); }
  .row:hover .hit { fill: color-mix(in srgb, var(--cinnabar) 5%, transparent); }
  .nianbiao svg:has(.row:hover) .row:not(:hover) circle { opacity: .18; }
  .cap { font: 400 15px var(--title); fill: var(--ink-2); text-anchor: end; letter-spacing: .12em; opacity: 0; transition: opacity .2s; pointer-events: none; }
  .row:hover .cap, .row:focus-visible .cap { opacity: 1; }
  .nb-note { display: flex; justify-content: space-between; flex-direction: row-reverse; margin-top: -22px; font: 400 13px/1.6 var(--title); letter-spacing: .2em; color: var(--ink-3); }
  .nianbiao svg:has(.row:hover) + .nb-note, .nianbiao:has(.row:hover) .nb-note { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .nianbiao.in .row circle { animation: drop .9s var(--ease-ink) backwards; animation-delay: calc(var(--i) * 50ms); }
  }
  @keyframes drop { from { opacity: 0; } }
</style>
