---
import { MENTIONS, STATS, byId, cn, chapter } from '../lib/data.ts';
interface Props { count?: number }
const { count = 14 } = Astro.props;
const ids = Object.entries(STATS.totals).filter(([id]) => byId.get(id)!.tier !== 'o')
  .sort((a, b) => b[1] - a[1]).slice(0, count).map(([id]) => id);
const W = 1200, TOP = 58, ROW = 36, CW = W / 120, H = TOP + ids.length * ROW;
const cx = (n: number) => W - (n - .5) * CW;
const max = Math.max(...ids.flatMap(id => MENTIONS[id]));
const rows = ids.map((id, i) => ({ id, y: TOP + (i + .5) * ROW, values: MENTIONS[id] }));
const first = rows[0];
const chapters = Array.from({ length: 120 }, (_, i) => chapter(i + 1).title.join('　'));
---
<figure class="nianbiao" aria-label="一百二十回人物提及年表" data-mentions style={`--nb-top:${TOP}px;--nb-row:${ROW}px`}>
  <div class="nb-shell">
    <div class="nb-box" data-nb-scroll>
      <svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} tabindex="0" role="group" aria-label="人物提及图，左右方向键选回目，上下方向键选人物" data-nb-plot>
        <rect class="xu-bg" x="0" y="0" width={CW * 40} height={H} />
        <text class="part" x={CW * 20} y="18">后四十回 · 续书</text>
        <text class="part" x={CW * 80} y="18">前八十回</text>
        <g class="grid" aria-hidden="true">
          {Array.from({ length: 13 }, (_, i) => i * 10).map(n => <line x1={W - n * CW} x2={W - n * CW} y1={TOP - 10} y2={H} class:list={{ eighty: n === 80 }} />)}
          {Array.from({ length: ids.length + 1 }, (_, i) => <line class="row-rule" x1="0" x2={W} y1={TOP + i * ROW} y2={TOP + i * ROW} />)}
        </g>
        <g class="ticks" aria-hidden="true">
          {[1, ...Array.from({ length: 12 }, (_, i) => (i + 1) * 10)].map(n => <text x={n === 1 ? W - 12 : n === 120 ? 12 : cx(n)} style={n === 120 ? 'text-anchor:start' : undefined} y={TOP - 17}>{cn(n)}</text>)}
        </g>
        <rect class="selection-row" x="0" y={TOP} width={W} height={ROW} data-nb-row hidden />
        <rect class="selection-col" x={W - CW} y={TOP} width={CW} height={H - TOP} data-nb-col hidden />
        {rows.map(r => <g aria-hidden="true">{r.values.map((v, i) => v > 0 && <circle class="dot" cx={cx(i + 1)} cy={r.y} r={Math.max(1.1, Math.sqrt(v / max) * 4.3).toFixed(1)} />)}</g>)}
        <circle class="selection-dot" cx={cx(1)} cy={first.y} r="4.5" data-nb-dot hidden />
      </svg>
    </div>
    <div class="nb-names" aria-label="选择人物">
      <span class="nb-name-head">人物</span>
      {rows.map((r, i) => <button type="button" data-nb-person={i} aria-pressed="false" aria-controls="mention-detail">{r.id}</button>)}
    </div>
  </div>
  <figcaption class="nb-detail" id="mention-detail" data-nb-detail hidden>
    <p class="nb-result" aria-live="polite" aria-atomic="true" data-nb-result><a href={`/people/${first.id}/`}>{first.id}</a><span>第一回 · 提及{cn(first.values[0])}次</span></p>
    <a class="nb-read" href="/chapters/1/" data-nb-read>读这一回</a>
    <p class="nb-chapter" data-nb-chapter>{chapters[0]}</p>
    <div class="nb-navigation" role="group" aria-label="选择回目">
      <button type="button" data-nb-prev disabled>上一回</button>
      <select data-nb-select aria-label="选择第几回">{Array.from({ length: 120 }, (_, i) => <option value={i + 1}>第{cn(i + 1)}回</option>)}</select>
      <button type="button" data-nb-next>下一回</button>
      <button type="button" class="nb-close" data-nb-close>收起</button>
    </div>
  </figcaption>
  <div class="nb-key"><span>右起第一回</span><span class="nb-scale"><i class="small-dot"></i><i class="large-dot"></i>墨点越大，提及越多</span></div>
  <script is:inline type="application/json" data-nb-data set:html={JSON.stringify({ ids, values: rows.map(r => r.values), chapters, width: W, top: TOP, row: ROW })} />
</figure>

<script>
  import { cn, progress } from '../client/site.ts';
  for (const figure of document.querySelectorAll<HTMLElement>('[data-mentions]')) {
    const data: { ids: string[]; values: number[][]; chapters: string[]; width: number; top: number; row: number } = JSON.parse(figure.querySelector('[data-nb-data]')!.textContent!);
    const plot = figure.querySelector<SVGSVGElement>('[data-nb-plot]')!;
    const scroll = figure.querySelector<HTMLElement>('[data-nb-scroll]')!;
    const names = [...figure.querySelectorAll<HTMLButtonElement>('[data-nb-person]')];
    const rowMark = figure.querySelector('[data-nb-row]')!;
    const colMark = figure.querySelector('[data-nb-col]')!;
    const dot = figure.querySelector('[data-nb-dot]')!;
    const result = figure.querySelector('[data-nb-result]')!;
    const person = result.querySelector<HTMLAnchorElement>('a')!;
    const value = result.querySelector('span')!;
    const read = figure.querySelector<HTMLAnchorElement>('[data-nb-read]')!;
    const title = figure.querySelector('[data-nb-chapter]')!;
    const chapterSelect = figure.querySelector<HTMLSelectElement>('[data-nb-select]')!;
    const prev = figure.querySelector<HTMLButtonElement>('[data-nb-prev]')!;
    const next = figure.querySelector<HTMLButtonElement>('[data-nb-next]')!;
    const detail = figure.querySelector<HTMLElement>('[data-nb-detail]')!;
    const close = figure.querySelector<HTMLButtonElement>('[data-nb-close]')!;
    const cw = data.width / 120;
    let row = 0, n = 1;
    function select(nextRow: number, nextChapter: number, reveal = false) {
      row = Math.max(0, Math.min(data.ids.length - 1, nextRow));
      n = Math.max(1, Math.min(120, nextChapter));
      const id = data.ids[row], x = data.width - n * cw;
      detail.hidden = false;
      for (const mark of [rowMark, colMark, dot]) mark.removeAttribute('hidden');
      names.forEach((b, i) => b.setAttribute('aria-pressed', String(i === row)));
      rowMark.setAttribute('y', String(data.top + row * data.row));
      colMark.setAttribute('x', String(x));
      dot.setAttribute('cx', String(x + cw / 2));
      dot.setAttribute('cy', String(data.top + (row + .5) * data.row));
      person.textContent = id;
      person.href = `/people/${encodeURIComponent(id)}/`;
      value.textContent = `第${cn(n)}回 · 提及${cn(data.values[row][n - 1])}次${n > 80 ? ' · 续书' : ''}`;
      read.href = `/chapters/${n}/?ref=mentions`;
      title.textContent = progress() && n > progress() ? '尚未读到这一回' : data.chapters[n - 1];
      chapterSelect.value = String(n);
      prev.disabled = n === 1;
      next.disabled = n === 120;
      if (reveal && (x < scroll.scrollLeft || x + cw > scroll.scrollLeft + scroll.clientWidth)) scroll.scrollLeft = x - scroll.clientWidth / 2;
    }
    names.forEach((b, i) => b.addEventListener('click', () => {
      const values = data.values[i].slice(0, progress() || 80);
      const peak = values.reduce((best, value, index) => value > values[best] ? index : best, 0) + 1;
      select(i, detail.hidden ? peak : n, true);
    }));
    close.addEventListener('click', () => {
      detail.hidden = true;
      names.forEach(b => b.setAttribute('aria-pressed', 'false'));
      for (const mark of [rowMark, colMark, dot]) mark.setAttribute('hidden', '');
      plot.focus({ preventScroll: true });
    });
    addEventListener('hlm:progress', () => { if (!detail.hidden) select(row, n); });
    chapterSelect.addEventListener('change', () => select(row, +chapterSelect.value, true));
    prev.addEventListener('click', () => select(row, n - 1, true));
    next.addEventListener('click', () => select(row, n + 1, true));
    plot.addEventListener('click', e => {
      const rect = plot.getBoundingClientRect(), y = e.clientY - rect.top;
      if (y < data.top) return;
      select(Math.floor((y - data.top) / data.row), 120 - Math.floor((e.clientX - rect.left) / cw));
    });
    plot.addEventListener('keydown', e => {
      if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key)) return;
      e.preventDefault();
      select(row + (e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0), e.key === 'Home' ? 1 : e.key === 'End' ? 120 : n + (e.key === 'ArrowLeft' ? 1 : e.key === 'ArrowRight' ? -1 : 0), true);
    });
    scroll.scrollLeft = scroll.scrollWidth;
  }
</script>

<style>
  .nianbiao { margin: 0; }
  .nb-shell { display: grid; grid-template-columns: minmax(0, 1fr) 104px; border-block: 1px solid var(--line-2); }
  .nb-box { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .nb-box svg { display: block; width: 1200px; max-width: none; height: auto; cursor: crosshair; }
  .xu-bg { fill: color-mix(in srgb, var(--ink) 4%, transparent); }
  .grid line { stroke: color-mix(in srgb, var(--cinnabar) 23%, transparent); stroke-width: 1; }
  .grid line.row-rule { stroke: var(--line); stroke-opacity: .35; }
  .grid line.eighty { stroke: var(--cinnabar); stroke-dasharray: 4 4; }
  .part, .ticks text { font: 400 15px var(--title); fill: var(--ink-2); text-anchor: middle; }
  .ticks text { font-size: 14px; }
  .dot { fill: var(--ink); opacity: .82; }
  .selection-row { fill: color-mix(in srgb, var(--cinnabar) 3%, transparent); }
  .selection-col { fill: color-mix(in srgb, var(--cinnabar) 5%, transparent); }
  .selection-dot { fill: none; stroke: var(--cinnabar); stroke-width: 1.2; filter: url(#rough); }
  .nb-names { border-left: 1px solid var(--line-2); background: var(--paper); }
  .nb-name-head { display: grid; height: var(--nb-top); align-items: end; padding-bottom: 12px; text-align: center; font: 400 15px var(--title); color: var(--ink-3); }
  .nb-names button { position: relative; display: block; width: 100%; height: var(--nb-row); font: 400 17px/1 var(--title); letter-spacing: .12em; }
  .nb-names button:hover, .nb-names button[aria-pressed="true"] { color: var(--cinnabar); }
  .nb-names button[aria-pressed="true"]::after { content: ''; position: absolute; left: 19%; right: 18%; bottom: 5px; height: 3px; border-bottom: 1.5px solid var(--cinnabar); border-radius: 30% 60% 45% 55%; transform: rotate(-3deg); pointer-events: none; }
  .nb-detail { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 20px; padding: 18px 0 12px; }
  .nb-result { display: flex; align-items: baseline; gap: 6px 18px; flex-wrap: wrap; font: 400 17px/1.7 var(--title); }
  .nb-result a, .nb-read { color: var(--cinnabar); }
  .nb-read { align-self: start; padding: 4px 0 4px 12px; font: 400 17px/1.5 var(--title); white-space: nowrap; }
  .nb-chapter { grid-column: 1 / -1; font: 400 15px/1.8 var(--title); color: var(--ink-2); }
  .nb-navigation { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; font: 400 15px/1.4 var(--title); }
  .nb-navigation button, .nb-navigation select { min-height: 40px; padding: 6px 8px; border: 0; border-bottom: 1px solid var(--line-2); border-radius: 0; background: transparent; color: var(--ink-2); font-family: var(--title); }
  .nb-navigation .nb-close { margin-left: auto; font-size: 14px; color: var(--ink-3); border-bottom-color: transparent; }
  .nb-navigation button:disabled { opacity: .4; cursor: default; }
  .nb-key { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font: 400 14px/1.7 var(--title); color: var(--ink-3); }
  .nb-scale { display: flex; align-items: center; gap: 7px; }
  .nb-scale i { display: inline-block; border-radius: 50%; background: var(--ink); }
  .small-dot { width: 3px; height: 3px; }
  .large-dot { width: 8px; height: 8px; }
  @media (max-width: 640px) { .nb-shell { grid-template-columns: minmax(0, 1fr) 88px; } .nb-names button { font-size: 16px; letter-spacing: .06em; } .nb-result { gap: 2px 10px; } }
</style>
