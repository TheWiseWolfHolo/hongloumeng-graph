---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PEOPLE, EDGES, TOTAL_CHARS, cn } from '../lib/data.ts';

const fontsCss = readFileSync(join(process.cwd(), 'public', 'fonts', 'fonts.css'), 'utf8');
const qijiPreload = [...fontsCss.matchAll(/font-family:"HLM Qiji";src:url\("([^"]+)"\)/g)].at(-1)?.[1];

interface Props {
  title?: string;
  description?: string;
  section?: 'home' | 'people' | 'relations' | 'garden' | 'chapters' | 'about';
  sub?: string;
  bodyClass?: string;
  image?: string;
}
const { title, description, section = 'home', sub = '', bodyClass = '', image = '/og.png' } = Astro.props;
const site = '红楼梦人物关系图谱';
const fullTitle = title ? `${title} · ${site}` : `${site} · 一百二十回原文与人物`;
const desc = description ?? `《红楼梦》人物关系图谱收录${cn(PEOPLE.length)}位人物、${cn(EDGES.length)}条关系与一百二十回原文约${cn(Math.round(TOTAL_CHARS / 10000))}万字。可查人物、关系、贾府世系、金陵十二钗、大观园与回目大事。`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="zh-CN" data-section={section}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={desc}>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#f3eee2" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#13161b" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site}>
  <meta property="og:title" content={title ?? site}>
  <meta property="og:description" content={desc}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="zh_CN">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/icon-32.png">
  <link rel="icon" type="image/svg+xml" href="/img/icon.svg">
  <link rel="apple-touch-icon" href="/img/icon-180.png">
  <link rel="manifest" href="/manifest.webmanifest">
  {qijiPreload && <link rel="preload" href={qijiPreload} as="font" type="font/woff2" crossorigin>}
  <link rel="stylesheet" href="/fonts/fonts.css">
  <script is:inline>
    /* 主题与阅读进度要在首屏绘制前定下，免得闪一下 */
    (function () {
      var d = document.documentElement, s = null, p = 0;
      try { s = localStorage.getItem('hlm-theme'); p = +localStorage.getItem('hlm-progress') || 0; } catch (e) {}
      var dark = s ? s === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      d.dataset.theme = dark ? 'dark' : 'light';
      if (p > 0 && p < 120) { d.classList.add('guard'); d.dataset.progress = p; }
      /* 旧版单页的地址，比如 #graph、#index?person=林黛玉，转到新页面 */
      if (location.pathname === '/' && location.hash.length > 1) {
        var h = decodeURIComponent(location.hash.slice(1)), m = /person=([^&]+)/.exec(h);
        var map = { graph: '/graph/', tree: '/lineage/', families: '/families/', love: '/love/', garden: '/garden/', timeline: '/chapters/', twelve: '/twelve/', index: '/people/' };
        var to = m ? '/people/' + m[1] + '/' : map[h.split('?')[0]];
        if (to) location.replace(to);
      }
    })();
  </script>
  <slot name="head" />
</head>
<body class={bodyClass}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <!-- 印泥压在纸上的毛边 -->
      <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="3" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2" />
      </filter>
      <!-- 墨迹边缘晕开 -->
      <filter id="inkbleed" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency=".05" numOctaves="3" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="5" />
      </filter>
    </defs>
  </svg>
  <a class="skip" href="#main">跳到正文</a>
  <Header section={section} sub={sub} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script>
    import '../client/site.ts';
  </script>
</body>
</html>
